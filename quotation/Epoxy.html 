  },
  setByPath(obj,path,val){const p=path.split('.');let o=obj;for(let i=0;i<p.length-1;i++){if(!o[p[i]])o[p[i]]={};o=o[p[i]]}o[p[p.length-1]]=val},
  getByPath(obj,path){return path.split('.').reduce((o,k)=>o?.[k],obj)},

  calculateEpoxyPricing(){
    const q=this.epoxy;if(!q)return;
    const pd=q.projectDetails||{};
    const p=q.pricing||{};
    const area=H4Utils.num(pd.area);
    // Calculate rate using engine
    const rateResult=this.calculateEpoxyRate(
      pd.epoxyType||'Premium Self-Leveling Epoxy',
      pd.system||'H4 Premium Epoxy',
      pd.thickness||'2 mm',
      pd.designType||'None',
      pd.colourType||'Standard',
      pd.finish||'High Gloss',
      pd.floorCondition||'New Concrete',
      pd.antiSlip||'Not Required',
      pd.topCoat||'Standard PU',
      pd.areaUnit||'sq.ft'
    );
    q._calculatedRate=rateResult;
    const rate=rateResult.finalRate||0;
    // Update pricing items
    if(!p.items||p.items.length===0){
      p.items=[{itemId:H4Utils.id('item'),description:`${pd.epoxyType||'Epoxy'} — ${pd.system||'System'}`,category:'Material Cost',quantity:area,unit:pd.areaUnit||'sq.ft',rate:rate,gst:H4DB.get('settings').defaultGst||18,amount:area*rate,discount:0}];
    }else{
      // Update first item rate if it's the main epoxy item
      const mainItem=p.items[0];
      if(mainItem&&mainItem.category==='Material Cost'){
        mainItem.rate=rate;
        mainItem.quantity=area;
        mainItem.unit=pd.areaUnit||'sq.ft';
        mainItem.amount=area*rate;
      }
    }
    // Recalculate totals
    let subtotal=0;
    p.items.forEach(item=>{
      const qty=H4Utils.num(item.quantity);
      const rt=H4Utils.num(item.rate);
      const disc=H4Utils.num(item.discount||0);
      const amt=qty*rt;
      item.amount=amt;
      subtotal+=amt-disc;
    });
    p.subtotal=subtotal;
    let discountAmount=0;
    if(p.discountEnabled){
      discountAmount=p.discountType==='percentage'?subtotal*H4Utils.num(p.discount)/100:H4Utils.num(p.discount);
    }
    p.discountAmount=discountAmount;
    p.taxableAmount=Math.max(0,subtotal-discountAmount);
    const gstEnabled=!!H4DB.get('company').gstEnabled;
    p.cgst=p.sgst=p.igst=0;
    if(gstEnabled){
      const gstTotal=p.taxableAmount*(H4DB.get('settings').defaultGst||18)/100;
      if(p.interState)p.igst=gstTotal;
      else{p.cgst=gstTotal/2;p.sgst=gstTotal/2}
    }
    const before=p.taxableAmount+p.cgst+p.sgst+p.igst;
    p.roundOff=Math.round(before)-before;
    p.grandTotal=Math.round(before);
    this._dirty=true;
  },

