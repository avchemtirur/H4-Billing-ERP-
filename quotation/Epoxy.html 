    const val=prompt('Enter manual rate per '+this.epoxy.projectDetails.areaUnit);
    if(val!==null){
      const rate=H4Utils.num(val);
      this.epoxy._calculatedRate={baseRate:rate,modifiers:[],modifierTotal:0,finalRate:rate,rateStatus:'override',rateSource:'manual',rateId:null};
      this.renderEpoxyStepContent();
      this.calculateEpoxyPricing();
      this.updateEpoxyPreview();
    }
  },

  applyCustomerSnapshot(){
    if(!this.epoxy)return;const id=this.epoxy.customerId,c=(H4DB.get('customers')||{})[id];if(!c)return;
    this.epoxy.customerSnapshot=JSON.parse(JSON.stringify(c));
  },

  setPricing(key,val){if(key==='warrantyEnabled')this.epoxy.warranty.enabled=val;else this.epoxy.pricing[key]=val;this.calculateEpoxyPricing();this.renderEpoxyStepContent();this.updateEpoxyPreview()},

  priceItemHtml(it,i){
    const units=Object.values(H4DB.get('unitMaster')).filter(x=>x.active).map(x=>x.unit);
    return `<div class="price-item"><div class="price-head"><strong>Item ${i+1}</strong><div class="toolbar"><button class="btn btn-sm btn-outline" onclick="H4App.duplicateItem(${i})">Duplicate</button><button class="btn btn-sm btn-danger" onclick="H4App.removeItem(${i})">Delete</button></div></div>
    <div class="form-group"><label>Description</label><input value="${H4Utils.esc(it.description)}" onchange="H4App.updateItem(${i},'description',this.value)"></div>
    <div class="mini-grid"><div class="form-group"><label>Category</label><select onchange="H4App.updateItem(${i},'category',this.value)">${['Material Cost','Labour Cost','Surface Preparation','Crack Repair','Primer Coat','Epoxy Screed / Putty','Self-Leveling Epoxy','Decorative Finish','PU Top Coat','Transportation','Other Charges'].map(x=>`<option ${x===it.category?'selected':''}>${x}</option>`).join('')}</select></div>
    <div class="form-group"><label>Qty</label><input type="number" step=".01" value="${it.quantity}" onchange="H4App.updateItem(${i},'quantity',this.value)"></div>
    <div class="form-group"><label>Unit</label><select onchange="H4App.updateItem(${i},'unit',this.value)">${units.map(x=>`<option ${x===it.unit?'selected':''}>${x}</option>`).join('')}</select></div>
    <div class="form-group"><label>Rate</label><input type="number" step=".01" value="${it.rate}" onchange="H4App.updateItem(${i},'rate',this.value)"></div></div>
    <div class="mini-grid"><div class="form-group"><label>Discount</label><input type="number" step=".01" value="${it.discount}" onchange="H4App.updateItem(${i},'discount',this.value)"></div><div class="form-group"><label>GST %</label><input type="number" step=".01" value="${it.gst}" onchange="H4App.updateItem(${i},'gst',this.value)"></div></div>
    <div class="summary-line"><span>Amount</span><strong>${H4Utils.money(it.amount)}</strong></div></div>`;
  },

  addPriceItem(){
    const q=this.epoxy,pd=q.projectDetails;
    const rate=q._calculatedRate?.finalRate||0;
    q.pricing.items.push({itemId:H4Utils.id('item'),description:`${pd.epoxyType||'Epoxy'} — ${pd.system||'System'}`,category:'Material Cost',quantity:pd.area||0,unit:pd.areaUnit||'sq.ft',rate:rate,gst:H4DB.get('settings').defaultGst||18,amount:H4Utils.num(pd.area)*rate,discount:0});
    this.calculateEpoxyPricing();
    this.renderEpoxyStepContent();
    this.updateEpoxyPreview();
  },

  updateItem(i,key,val){const it=this.epoxy.pricing.items[i];if(!it)return;it[key]=['quantity','rate','discount','gst'].includes(key)?H4Utils.num(val):val;this.calculateEpoxyPricing();this.renderEpoxyStepContent();this.updateEpoxyPreview();this.saveDraft()},
  duplicateItem(i){const x=JSON.parse(JSON.stringify(this.epoxy.pricing.items[i]));x.itemId=H4Utils.id('item');this.epoxy.pricing.items.splice(i+1,0,x);this.calculateEpoxyPricing();this.renderEpoxyStepContent();this.updateEpoxyPreview()},
  removeItem(i){this.epoxy.pricing.items.splice(i,1);this.calculateEpoxyPricing();this.renderEpoxyStepContent();this.updateEpoxyPreview()},
  updateScope(i,v){this.epoxy.workScope[i].selected=v;this.updateEpoxyPreview();this.saveDraft()},
  updateScopeDesc(i,v){this.epoxy.workScope[i].description=v;this.updateEpoxyPreview();this.saveDraft()},
  removeScope(i){this.epoxy.workScope.splice(i,1);this.renderEpoxyStepContent();this.updateEpoxyPreview()},
  addScope(){const e=document.getElementById('newScopeName'),n=e.value.trim();if(!n)return;this.epoxy.workScope.push({id:H4Utils.id('scope'),name:n,selected:true,description:n,quantity:'',unit:''});e.value='';this.renderEpoxyStepContent();this.updateEpoxyPreview()},
  updateFeature(i,v){this.epoxy.premiumFeatures[i].selected=v;this.updateEpoxyPreview();this.saveDraft()},
  updateFeatureName(i,v){this.epoxy.premiumFeatures[i].name=v;this.updateEpoxyPreview();this.saveDraft()},
  removeFeature(i){this.epoxy.premiumFeatures.splice(i,1);this.renderEpoxyStepContent();this.updateEpoxyPreview()},
  addFeature(){const e=document.getElementById('newFeatureName'),n=e.value.trim();if(!n)return;this.epoxy.premiumFeatures.push({id:H4Utils.id('feature'),name:n,selected:true});e.value='';this.renderEpoxyStepContent();this.updateEpoxyPreview()},

  togglePreview(){document.getElementById('epoxyBuilder').classList.toggle('mobile-preview')},

  updateEpoxyPreview(){if(!this.epoxy)return;this.calculateEpoxyPricing();document.getElementById('epoxyPreview').innerHTML=this.buildProposalHtml(this.epoxy)},

  buildProposalHtml(q){
    const c=q.companySnapshot||H4DB.get('company'),cu=q.customerSnapshot||this.snapshotCustomer(q.customerId),p=q.projectDetails,pr=q.pricing,t=q.termsAndConditions;
    const logo=c.logo?`<img class="proposal-logo" src="${c.logo}" alt="Logo">`:'<div class="proposal-logo"></div>';
    const scope=q.workScope.filter(x=>x.selected),features=q.premiumFeatures.filter(x=>x.selected);
    const qrVal=q.footer?.qrValue||c.website||'';const qr=q.footer?.qrEnabled!==false?`<img class="qr" src="${H4Utils.qr(qrVal)}" alt="QR Code">`:'';
    const rate=q._calculatedRate||{baseRate:0,modifiers:[],modifierTotal:0,finalRate:0,rateStatus:'none'};
    const itemRows=pr.items.map((x,i)=>`<tr><td>${i+1}</td><td>${H4Utils.esc(x.description)}</td><td>${H4Utils.esc(x.unit)}</td><td>${H4Utils.num(x.quantity)}</td><td>${H4Utils.money(x.rate)}</td><td>${H4Utils.money(x.amount)}</td></tr>`).join('')||`<tr><td colspan="6" style="text-align:center">No price items yet</td></tr>`;
    const page=(title,body,cls='')=>`<section class="proposal-page ${cls}"><h2 class="p-section-title">${title}</h2>${body}</section>`;
    return `<div class="preview-a4">
      <section class="proposal-page proposal-cover">
        <div class="proposal-brand"><div>${logo}<div class="proposal-kicker">H4 CONSTRUCTION SOLUTIONS</div><div class="proposal-title">PREMIUM EPOXY<br>FLOORING PROPOSAL</div><div class="proposal-subtitle">Luxury • Seamless • Durable • Premium Finish</div></div><div class="p-box" style="min-width:150px"><h4>Quotation</h4><div class="p-label">Quotation No.</div><div class="p-value">${H4Utils.esc(q.number)}</div><div class="p-label">Date</div><div class="p-value">${H4Utils.date(q.date)}</div><div class="p-label">Validity</div><div class="p-value">${q.validityDays} Days</div></div></div>
        <div class="proposal-rule"></div><div class="p-grid"><div class="p-box"><h4>Company Details</h4><div class="p-value">${H4Utils.esc(c.legalName||c.brandName)}</div><div class="p-label">${H4Utils.esc(c.address||'')}</div><div class="p-label">${H4Utils.esc([c.city,c.district,c.state,c.pin].filter(Boolean).join(', '))}</div><div class="p-label">Phone: ${H4Utils.esc(c.phone||'-')}</div><div class="p-label">WhatsApp: ${H4Utils.esc(c.whatsapp||'-')}</div><div class="p-label">${H4Utils.esc(c.email||'')}</div><div class="p-label">${H4Utils.esc(c.website||'')}</div>${c.gstEnabled&&c.gstin?`<div class="p-label">GSTIN: ${H4Utils.esc(c.gstin)}</div>`:''}</div>
        <div class="p-box"><h4>Customer Details</h4><div class="p-value">${H4Utils.esc(cu.name||'-')}</div><div class="p-label">${H4Utils.esc(cu.address||'-')}</div><div class="p-label">Phone: ${H4Utils.esc(cu.phone||'-')}</div><div class="p-label">WhatsApp: ${H4Utils.esc(cu.whatsapp||'-')}</div><div class="p-label">${H4Utils.esc(cu.email||'')}</div>${cu.gstin?`<div class="p-label">GSTIN: ${H4Utils.esc(cu.gstin)}</div>`:''}</div></div>
        <div class="p-box" style="margin-top:10px"><h4>Project Details</h4><div class="p-grid"><div><div class="p-label">Project</div><div class="p-value">${H4Utils.esc(p.projectName||'-')}</div></div><div><div class="p-label">Area</div><div class="p-value">${H4Utils.esc(p.area)} ${H4Utils.esc(p.areaUnit)}</div></div><div><div class="p-label">Epoxy Type</div><div class="p-value">${H4Utils.esc(p.epoxyType)}</div></div><div><div class="p-label">System</div><div class="p-value">${H4Utils.esc(p.system)}</div></div><div><div class="p-label">Thickness</div><div class="p-value">${H4Utils.esc(p.thickness)}</div></div><div><div class="p-label">Design</div><div class="p-value">${H4Utils.esc(p.designType||'None')}</div></div><div><div class="p-label">Finish</div><div class="p-value">${H4Utils.esc(p.finish)}</div></div><div><div class="p-label">Reference</div><div class="p-value">${H4Utils.esc(q.reference||'-')}</div></div></div></div>
        <div style="margin-top:30px;text-align:center;font-size:11px;color:#777">Professional epoxy flooring proposal prepared by H4 Construction Solutions.</div>
      </section>
      ${page('PROJECT SPECIFICATION',`<div class="p-grid"><div class="p-box"><h4>Area</h4><div class="p-value">${H4Utils.esc(p.area)} ${H4Utils.esc(p.areaUnit)}</div></div><div class="p-box"><h4>Floor Condition</h4><div class="p-value">${H4Utils.esc(p.floorCondition)}</div></div></div><h2 class="p-section-title" style="margin-top:20px">WORK SCOPE</h2><ul class="p-list">${scope.map(x=>`<li>${H4Utils.esc(x.description)}</li>`).join('')||'<li>No scope selected</li>'}</ul><h2 class="p-section-title" style="margin-top:20px">RATE CALCULATION</h2><div class="p-box"><div class="p-label">Base Rate</div><div class="p-value">${H4Utils.money(rate.baseRate)} / ${p.areaUnit}</div>${rate.modifiers?.length?`<div class="p-label">Modifiers</div>${rate.modifiers.map(m=>`<div class="p-value" style="font-size:10px">+ ${H4Utils.esc(m.name)}: ${m.valueType==='fixed'?H4Utils.money(m.value):(m.value*100)+'%'}</div>`).join('')}`:''}${rate.modifierTotal?`<div class="p-label">Modifier Total</div><div class="p-value">${H4Utils.money(rate.modifierTotal)}</div>`:''}<div class="p-label">Final Rate</div><div class="p-value" style="font-size:16px;font-weight:800;color:var(--primary)">${H4Utils.money(rate.finalRate)} / ${p.areaUnit}</div></div>`)}
      ${page('PRICE TABLE',`<table class="p-table"><thead><tr><th>#</th><th>Description</th><th>Unit</th><th>Qty</th><th>Rate</th><th>Amount</th></tr></thead><tbody>${itemRows}</tbody></table><div class="p-total" style="margin-top:15px"><div><span>Subtotal</span><strong>${H4Utils.money(pr.subtotal)}</strong></div><div><span>Discount</span><strong>- ${H4Utils.money(pr.discountAmount||0)}</strong></div><div><span>Taxable Amount</span><strong>${H4Utils.money(pr.taxableAmount)}</strong></div>${c.gstEnabled?(pr.interState?`<div><span>IGST</span><strong>${H4Utils.money(pr.igst)}</strong></div>`:`<div><span>CGST</span><strong>${H4Utils.money(pr.cgst)}</strong></div><div><span>SGST</span><strong>${H4Utils.money(pr.sgst)}</strong></div>`):''}<div><span>Round Off</span><strong>${H4Utils.money(pr.roundOff)}</strong></div><div class="p-grand"><span>GRAND TOTAL</span><strong>${H4Utils.money(pr.grandTotal)}</strong></div></div>`)}
      ${page('TIMELINE & WARRANTY',`<div class="p-grid"><div class="p-box"><h4>Work Duration</h4><div class="p-value">${H4Utils.esc(q.timeline.workDuration)}</div></div><div class="p-box"><h4>Curing Time</h4><div class="p-value">${H4Utils.esc(q.timeline.curingTime)}</div></div></div>${q.warranty.enabled?`<div class="p-box"><div style="font-size:18px;color:#4e267a;font-weight:800">${H4Utils.esc(q.warranty.period)} Warranty</div><div style="font-size:10px;margin-top:5px">${H4Utils.esc(q.warranty.terms)}</div>${q.warranty.conditions?`<div style="font-size:10px;margin-top:5px">${H4Utils.esc(q.warranty.conditions)}</div>`:''}</div>`:'<div class="p-box">Warranty not enabled.</div>'}<h2 class="p-section-title" style="margin-top:20px">PREMIUM FEATURES</h2><div class="feature-grid">${features.map(x=>`<div class="feature">✓ ${H4Utils.esc(x.name)}</div>`).join('')||'<div>No features selected.</div>'}</div><h2 class="p-section-title" style="margin-top:20px">TERMS & CONDITIONS</h2><div style="font-size:10px"><div><strong>Advance:</strong> ${H4Utils.esc(t.advancePayment)}</div><div><strong>Balance:</strong> ${H4Utils.esc(t.balancePayment)}</div><div><strong>Work Schedule:</strong> ${H4Utils.esc(t.workSchedule)}</div><div><strong>Water & Electricity:</strong> ${H4Utils.esc(t.waterElectricityByClient)}</div><div><strong>Warranty:</strong> ${H4Utils.esc(t.warrantyConditions)}</div><div><strong>Surface:</strong> ${H4Utils.esc(t.surfaceConditionResponsibility)}</div><div><strong>Access:</strong> ${H4Utils.esc(t.accessToWorkArea)}</div><div><strong>Curing:</strong> ${H4Utils.esc(t.curingRestrictions)}</div><div><strong>Maintenance:</strong> ${H4Utils.esc(t.maintenanceRequirements)}</div><div><strong>Other:</strong> ${H4Utils.esc(t.otherTerms)}</div></div><div class="proposal-rule"></div><div style="display:flex;justify-content:space-between;gap:20px"><div style="flex:1"><div style="font-size:13px;font-weight:800">${H4Utils.esc(q.footer.thankYou)}</div><div class="signature-box">${c.signature?`<img src="${c.signature}" style="height:65px;max-width:160px;object-fit:contain">`:''}</div><div style="font-size:10px;margin-top:4px">${H4Utils.esc(q.footer.authorizedSignatoryName)}</div><div style="font-size:9px;color:#777">Authorized Signatory</div></div><div style="text-align:center">${qr}<div style="font-size:8px;margin-top:4px">Scan to connect</div></div></div><div style="text-align:center;margin-top:20px;font-size:9px;color:#777">${H4Utils.esc(c.brandName||'H4 Construction Solutions')} • ${H4Utils.esc(c.footerText||'Thank you for your business!')}</div>`)}
    </div>`;
  },

  printCurrentEpoxy(){if(!this.epoxy)return;this.calculateEpoxyPricing();document.getElementById('printArea').innerHTML=this.buildProposalHtml(this.epoxy);window.print()},
  printQuotation(id){const q=(H4DB.get('quotations')||{})[id];if(!q)return;if(q.quotationType==='premium-epoxy'){this.printCurrentByObject(q)}},
  printCurrentByObject(q){document.getElementById('printArea').innerHTML=this.buildProposalHtml(q);window.print()},
  convertCurrentEpoxy(){if(this.epoxy){this.saveEpoxy(true);this.convertQuotationToInvoice(this.epoxy.id)}},

  convertQuotationToInvoice(qid){
    const q=(H4DB.get('quotations')||{})[qid];if(!q)return;
    if(q.convertedToInvoice){H4Notify.success('Already converted to invoice');return}
    const s=H4DB.get('settings'),n=this.generateNumber('inv'),p=q.pricing||{};
    const inv={id:H4Utils.id('inv'),number:n,quotationId:q.id,quotationNumber:q.number,customerId:q.customerId,customerSnapshot:q.customerSnapshot,companySnapshot:q.companySnapshot,date:new Date().toISOString(),dueDate:H4Utils.addDays(new Date(),s.invoiceDueDays),projectName:q.projectDetails?.projectName||'',siteAddress:q.customerSnapshot?.address||'',reference:q.reference||'',projectDetails:JSON.parse(JSON.stringify(q.projectDetails||{})),workScope:JSON.parse(JSON.stringify(q.workScope||[])),materialSpecification:JSON.parse(JSON.stringify(q.materialSpecification||{})),items:(p.items||[]).map(x=>({...x,rate:Number(x.rate),amount:Number(x.amount),historicalRate:true})),subtotal:p.subtotal,totalDiscount:p.discountAmount||0,taxableAmount:p.taxableAmount,cgst:p.cgst,sgst:p.sgst,igst:p.igst,roundOff:p.roundOff,grandTotal:p.grandTotal,status:'unpaid',totalAmount:p.grandTotal,paidAmount:0,balanceAmount:p.grandTotal,createdAt:new Date().toISOString(),updatedAt:new Date().toISOString()};
    H4DB.add('invoices',inv);H4DB.update('quotations',q.id,{convertedToInvoice:inv.id,status:'converted',updatedAt:new Date().toISOString()});
    if(this.epoxy?.id===qid)this.closeEpoxyBuilder();
    this.renderInvoices();this.renderQuotations();this.updateDashboard();
    H4Notify.success('Invoice created with historical quotation rates: '+n)
  },

  printInvoice(id){const i=(H4DB.get('invoices')||{})[id];if(!i)return;const c=i.companySnapshot||H4DB.get('company'),cu=i.customerSnapshot||{};const rows=(i.items||[]).map((x,n)=>`<tr><td>${n+1}</td><td>${H4Utils.esc(x.description)}</td><td>${H4Utils.esc(x.unit)}</td><td>${x.quantity}</td><td>${H4Utils.money(x.rate)}</td><td>${H4Utils.money(x.amount)}</td></tr>`).join('');document.getElementById('printArea').innerHTML=`<div class="preview-a4"><section class="proposal-page"><div class="proposal-brand"><div><div class="proposal-kicker">${H4Utils.esc(c.brandName||c.legalName)}</div><div class="proposal-title" style="font-size:25px">TAX INVOICE</div></div>${c.logo?`<img class="proposal-logo" src="${c.logo}">`:''}</div><div class="proposal-rule"></div><div class="p-grid"><div class="p-box"><h4>Company</h4><div class="p-value">${H4Utils.esc(c.legalName)}</div><div class="p-label">${H4Utils.esc(c.address)}</div><div class="p-label">${H4Utils.esc(c.phone)} • ${H4Utils.esc(c.email)}</div>${c.gstin?`<div class="p-label">GSTIN: ${H4Utils.esc(c.gstin)}</div>`:''}</div><div class="p-box"><h4>Bill To</h4><div class="p-value">${H4Utils.esc(cu.name||'-')}</div><div class="p-label">${H4Utils.esc(cu.address||'-')}</div><div class="p-label">${H4Utils.esc(cu.phone||'-')}</div></div></div><div class="p-box" style="margin-top:10px"><div class="p-grid"><div><div class="p-label">Invoice No.</div><div class="p-value">${H4Utils.esc(i.number)}</div></div><div><div class="p-label">Date</div><div class="p-value">${H4Utils.date(i.date)}</div></div><div><div class="p-label">Quotation</div><div class="p-value">${H4Utils.esc(i.quotationNumber||'-')}</div></div><div><div class="p-label">Project</div><div class="p-value">${H4Utils.esc(i.projectName||'-')}</div></div></div></div><table class="p-table" style="margin-top:18px"><thead><tr><th>#</th><th>Description</th><th>Unit</th><th>Qty</th><th>Rate</th><th>Amount</th></tr></thead><tbody>${rows}</tbody></table><div class="p-total" style="margin-top:15px"><div><span>Subtotal</span><strong>${H4Utils.money(i.subtotal)}</strong></div><div><span>Discount</span><strong>- ${H4Utils.money(i.totalDiscount)}</strong></div><div><span>Taxable</span><strong>${H4Utils.money(i.taxableAmount)}</strong></div>${c.gstEnabled?(i.igst?`<div><span>IGST</span><strong>${H4Utils.money(i.igst)}</strong></div>`:`<div><span>CGST</span><strong>${H4Utils.money(i.cgst)}</strong></div><div><span>SGST</span><strong>${H4Utils.money(i.sgst)}</strong></div>`):''}<div><span>Round Off</span><strong>${H4Utils.money(i.roundOff)}</strong></div><div class="p-grand"><span>TOTAL</span><strong>${H4Utils.money(i.grandTotal)}</strong></div></div><div style="margin-top:60px;text-align:right"><div class="signature-box" style="display:inline-block;width:220px">${c.signature?`<img src="${c.signature}" style="height:65px;max-width:160px;object-fit:contain">`:''}</div><div>${H4Utils.esc(c.signatoryName||'Authorized Signatory')}</div></div></section></div>`;window.print()},

  openModal(id){const e=document.getElementById(id);if(e)e.classList.add('active')},
  closeModal(id){const e=document.getElementById(id);if(e)e.remove?((id==='quotationTypeModal')?e.remove():e.classList.remove('active')):null},
  downloadBackup(){const blob=new Blob([H4DB.export()],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='H4-Billing-Backup-'+new Date().toISOString().slice(0,10)+'.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);H4Notify.success('Backup downloaded')},
  restoreBackup(){const f=document.getElementById('backupFile').files[0];if(!f){H4Notify.danger('Select a backup file');return}const r=new FileReader();r.onload=e=>{try{const d=JSON.parse(e.target.result);H4DB.import(d);H4Notify.success('Backup restored. Reloading…');setTimeout(()=>location.reload(),700)}catch(x){H4Notify.danger('Invalid backup file')}};r.readAsText(f)},
  resetAllData(){if(confirm('Delete ALL H4 Billing ERP data?')){localStorage.removeItem(H4DB.STORAGE_KEY);localStorage.removeItem('h4_epoxy_draft');location.reload()}}
};

function v(id){return document.getElementById(id)?.value??''}function setv(id,x){const e=document.getElementById(id);if(e)e.value=x??''}function checked(id){return !!document.getElementById(id)?.checked}
function setOptions(id,arr,selected){const e=document.getElementById(id);if(!e)return;e.innerHTML=arr.map(x=>`<option value="${H4Utils.esc(x)}" ${String(x)===String(selected)?'selected':''}>${H4Utils.esc(x)}</option>`).join('')}
window.H4App=H4App;
document.addEventListener('DOMContentLoaded',()=>H4App.init());
</script>
</body>
</html>