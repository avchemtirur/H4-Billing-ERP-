  syncCurrentStep(){
    if(!this.epoxy)return;
    const q=this.epoxy;
    const fields=document.querySelectorAll('.epoxy-step.active [data-bind]');
    fields.forEach(el=>{
      const path=el.dataset.bind;
      const val=el.type==='checkbox'?el.checked:el.value;
