<script>
'use strict';

const H4DB={
  STORAGE_KEY:'h4_billing_erp_v3',
  defaultData(){
    const now=new Date().toISOString();
    return {
      version:6,
      company:{id:'default',legalName:'AV CHEM',brandName:'H4 Construction Solutions',businessType:'Manufacturing',address:'Tirur',city:'Malappuram',district:'Malappuram',state:'Kerala',pin:'676101',phone:'+91-XXXXXXXXXX',whatsapp:'+91-XXXXXXXXXX',email:'info@h4chem.com',website:'https://avchemtirur.github.io/',gstEnabled:true,gstin:'',gstStateCode:'32',panEnabled:false,pan:'',logo:'',signature:'',signatoryName:'Authorized Signatory',bankEnabled:false,bank:{name:'',accountName:'',accountNumber:'',ifsc:'',branch:'',upiId:''},terms:'Payment terms as mutually agreed.',footerText:'Thank you for your business!',createdAt:now,updatedAt:now},
      customers:{},products:{},
      quotations:{},invoices:{},payments:{},
      templates:{tpl_001:{id:'tpl_001',name:'H4 Standard Quotation',type:'quotation',preset:'standard'},tpl_epoxy:{id:'tpl_epoxy',name:'Premium Epoxy Flooring Proposal',type:'quotation',preset:'premium-epoxy'},tpl_002:{id:'tpl_002',name:'H4 Standard Invoice',type:'invoice',preset:'standard'}},
      themes:{theme_001:{id:'theme_001',name:'H4 Purple & Gold',primary:'#6A3FA0',secondary:'#8A6510',accent:'#00BCD4',background:'#fff',text:'#212121'}},
      settings:{currency:'INR',dateFormat:'DD/MM/YYYY',defaultGst:18,defaultInterState:false,quotationPrefix:'H4-QTN',quotationStart:1,quotationYear:new Date().getFullYear(),quotationValidity:30,quotationCounter:1,invoicePrefix:'H4-INV',invoiceYear:new Date().getFullYear(),invoiceStart:1,invoiceDueDays:30,invoiceCounter:1},
      masterLists:{
        epoxyTypes:['Standard Epoxy Flooring','Premium Self-Leveling Epoxy','Metallic Epoxy Flooring','3D Epoxy Flooring','Decorative Flake Epoxy','Industrial Epoxy Flooring','Epoxy Cove Flooring'],
        epoxySystems:['H4 Premium Epoxy','H4 Metallic Epoxy','H4 3D Epoxy','H4 Standard Epoxy','H4 Decorative Epoxy'],
        thicknesses:['1 mm','2 mm','3 mm','4 mm','5 mm','6 mm'],
        floorConditions:['New Concrete','Existing Concrete','Existing Tile','Existing Epoxy','Other'],
        finishes:['High Gloss','Gloss','Matte','Satin'],
        antiSlip:['Not Required','Standard','Medium','Heavy Duty'],
        areaUnits:['sq.ft','sq.m','running ft','meter'],
        designTypes:['None','Solid','Metallic','3D','Flake','Quartz'],
        colourTypes:['Standard','Premium','Custom'],
        topCoats:['None','Standard PU','Premium PU','Anti-Slip PU'],
        workScopes:['Surface Grinding','Crack Repair','Primer Coat','Epoxy Screed / Putty','Self-Leveling Epoxy','Decorative Flakes / Metallic Effect','UV Resistant PU Top Coat','Final Inspection & Cleaning'],
        features:['Seamless Finish','High Gloss Luxury Look','Chemical Resistant','Scratch Resistant','Dust Free Surface','Easy to Clean','Long Life Performance','Premium Imported Pigments','UV Protected Top Coat'],
        waterproofingTypes:['Terrace Waterproofing','Bathroom Waterproofing','Roof Waterproofing','Basement Waterproofing','Balcony Waterproofing','Water Tank Waterproofing']
      },
      rateMaster:{
        rate_001:{id:'rate_001',category:'epoxy',epoxyType:'Premium Self-Leveling Epoxy',system:'H4 Premium Epoxy',designType:'None',colourType:'Standard',finish:'High Gloss',floorCondition:'New Concrete',antiSlip:'Not Required',topCoat:'Standard PU',thickness:'2 mm',unit:'sq.ft',baseRate:250,gst:18,active:true,modifiers:[]},
        rate_002:{id:'rate_002',category:'epoxy',epoxyType:'Metallic Epoxy Flooring',system:'H4 Metallic Epoxy',designType:'Metallic',colourType:'Premium',finish:'High Gloss',floorCondition:'New Concrete',antiSlip:'Not Required',topCoat:'Premium PU',thickness:'3 mm',unit:'sq.ft',baseRate:450,gst:18,active:true,modifiers:[]}
      },
      unitMaster:{
        sqft:{id:'sqft',unit:'sq.ft',label:'sq.ft',active:true},
        sqm:{id:'sqm',unit:'sq.m',label:'sq.m',active:true},
        kg:{id:'kg',unit:'kg',label:'kg',active:true},
        litre:{id:'litre',unit:'litre',label:'litre',active:true},
        set:{id:'set',unit:'set',label:'set',active:true},
        piece:{id:'piece',unit:'piece',label:'piece',active:true},
        meter:{id:'meter',unit:'meter',label:'meter',active:true},
        day:{id:'day',unit:'day',label:'day',active:true},
        job:{id:'job',unit:'job',label:'job',active:true}
      },
      activityLog:[],backupHistory:[]
    };
  },
  init(){
    let raw=localStorage.getItem(this.STORAGE_KEY);
    if(!raw){this.import(this.defaultData());return}
    try{const d=JSON.parse(raw);this.migrate(d)}catch(e){console.error(e);this.import(this.defaultData())}
  },
  migrate(d){
    const base=this.defaultData();
    d.version=d.version||1;
    d.company=Object.assign({},base.company,d.company);
    d.customers=d.customers||{};d.products=d.products||{};d.quotations=d.quotations||{};d.invoices=d.invoices||{};d.payments=d.payments||{};
    d.templates=Object.assign({},base.templates,d.templates);d.themes=Object.assign({},base.themes,d.themes);
    d.settings=Object.assign({},base.settings,d.settings);
    d.masterLists=Object.assign({},base.masterLists,d.masterLists);
    d.rateMaster=Object.assign({},base.rateMaster,d.rateMaster);d.unitMaster=Object.assign({},base.unitMaster,d.unitMaster);
    d.activityLog=d.activityLog||[];d.backupHistory=d.backupHistory||[];
    Object.values(d.quotations||{}).forEach(q=>{q.quotationType=q.quotationType||'general';q.templateId=q.templateId||'tpl_001';q.items=q.items||[];q.pricingSnapshot=q.pricingSnapshot||null});
    localStorage.setItem(this.STORAGE_KEY,JSON.stringify(d));
  },
  get(key){const d=JSON.parse(localStorage.getItem(this.STORAGE_KEY)||'{}');return key?d[key]:d},
  save(key,value){const d=this.get();d[key]=value;localStorage.setItem(this.STORAGE_KEY,JSON.stringify(d))},
  add(category,item){const d=this.get(category)||{};d[item.id]=item;this.save(category,d);return item},
  update(category,id,updates){const d=this.get(category)||{};if(!d[id])return null;d[id]={...d[id],...updates};this.save(category,d);return d[id]},
  delete(category,id){const d=this.get(category)||{};delete d[id];this.save(category,d)},
  export(){return JSON.stringify(this.get(),null,2)},
  import(data){localStorage.setItem(this.STORAGE_KEY,JSON.stringify(data))}
};

const H4Utils={
  id(p){return p+'_'+Date.now()+'_'+Math.random().toString(36).slice(2,8)},
  money(v){return new Intl.NumberFormat('en-IN',{style:'currency',currency:'INR',maximumFractionDigits:2}).format(Number(v)||0)},
  num(v){return Number.isFinite(Number(v))?Number(v):0},
  esc(v){return String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))},
  date(v){if(!v)return'';return new Date(v).toLocaleDateString('en-IN')},
  addDays(date,days){const d=new Date(date);d.setDate(d.getDate()+Number(days||0));return d.toISOString()},
  base64(file){return new Promise((res,rej)=>{const r=new FileReader();r.onload=()=>res(r.result);r.onerror=rej;r.readAsDataURL(file)})},
  wa(phone,text){const p=String(phone||'').replace(/\D/g,'');return 'https://wa.me/'+p+'?text='+encodeURIComponent(text)},
  qr(value){return 'https://api.qrserver.com/v1/create-qr-code/?size=180x180&data='+encodeURIComponent(value||'H4 Construction Solutions')}
};

const H4Notify={show(msg,type='success'){const c=document.getElementById('notifications');const n=document.createElement('div');n.className='notification '+type;n.textContent=msg;c.appendChild(n);setTimeout(()=>n.remove(),3500)},success(m){this.show(m,'success')},danger(m){this.show(m,'danger')}};

const H4App={
  currentModule:'dashboard',
  epoxy:null,
  step:0,
  steps:['Customer','Project','System','Scope','Materials','Pricing','GST','Timeline','Warranty','Features','Terms','Preview'],
  rateModifiers:[],
  init(){
    H4DB.init();this.bind();this.loadAll();this.renderEpoxySteps();this.renderRateMaster();this.renderUnitMaster();
  },
  bind(){
    document.getElementById('menuToggle').onclick=()=>document.getElementById('sidebar').classList.toggle('active');
    document.querySelectorAll('.sidebar-item,.nav-item').forEach(el=>el.onclick=()=>{this.navigate(el.dataset.module);document.getElementById('sidebar').classList.remove('active')});
    document.getElementById('companyForm').onsubmit=e=>{e.preventDefault();this.saveCompany()};
    document.getElementById('settingsForm').onsubmit=e=>{e.preventDefault();this.saveSettings()};
    document.getElementById('customerForm').onsubmit=e=>{e.preventDefault();this.saveCustomer()};
    document.getElementById('productForm').onsubmit=e=>{e.preventDefault();this.saveProduct()};
    document.getElementById('themeForm').onsubmit=e=>{e.preventDefault();this.saveTheme()};
    ['gstEnabled','panEnabled','bankEnabled'].forEach(id=>document.getElementById(id).onchange=e=>document.getElementById(id.replace('Enabled','Fields')).style.display=e.target.checked?'block':'none');
    document.getElementById('logoUpload').onchange=async e=>{if(e.target.files[0]){const b=await H4Utils.base64(e.target.files[0]);document.getElementById('logoImage').src=b;document.getElementById('logoPreview').style.display='flex';}};
    document.getElementById('signatureUpload').onchange=async e=>{if(e.target.files[0]){const b=await H4Utils.base64(e.target.files[0]);document.getElementById('signatureImage').src=b;document.getElementById('signaturePreview').style.display='flex';}};
    document.addEventListener('keydown',e=>this.globalKey(e));
  },
  globalKey(e){
    if(!this.epoxy||!document.getElementById('epoxyBuilder').classList.contains('active'))return;
    if(e.key==='Escape'){e.preventDefault();this.closeEpoxyBuilder();return}
    if(e.ctrlKey&&e.key==='Enter'){e.preventDefault();this.saveEpoxy(false);return}
    if(e.key==='Enter'&&!e.ctrlKey&&!e.shiftKey){
      const t=e.target;
      if(t&&t.tagName==='TEXTAREA')return;
      if(t&&['INPUT','SELECT','BUTTON'].includes(t.tagName)){e.preventDefault();this.focusNext(t)}
    }
