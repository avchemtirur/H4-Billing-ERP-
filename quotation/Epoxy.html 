  // ===== RATE ENGINE WITH MODIFIERS =====
  getModifiersForRate(rateId){
    const rate=(H4DB.get('rateMaster')||{})[rateId];
    return rate?.modifiers||[];
  },

  calculateEpoxyRate(epoxyType,system,thickness,designType,colourType,finish,floorCondition,antiSlip,topCoat,unit){
    const rates=Object.values(H4DB.get('rateMaster')||{});
    // Priority 1: Exact match
    let match=rates.find(r=>
      r.category==='epoxy'&&r.active!==false&&
      r.epoxyType===epoxyType&&r.system===system&&r.thickness===thickness&&
      r.designType===designType&&r.colourType===colourType&&
      r.finish===finish&&r.floorCondition===floorCondition&&
      r.antiSlip===antiSlip&&r.topCoat===topCoat&&r.unit===unit
    );
    if(match){
      const mods=this.getModifiersForRate(match.id);
      const modTotal=mods.reduce((sum,m)=>sum+(m.valueType==='fixed'?m.value:match.baseRate*m.value/100),0);
      return {baseRate:match.baseRate,modifiers:mods,modifierTotal:modTotal,finalRate:match.baseRate+modTotal,rateStatus:'auto',rateSource:'exact',rateId:match.id};
    }
    // Priority 2: Without designType, colourType, antiSlip, topCoat, floorCondition
    match=rates.find(r=>
      r.category==='epoxy'&&r.active!==false&&
      r.epoxyType===epoxyType&&r.system===system&&r.thickness===thickness&&
      r.finish===finish&&r.unit===unit
    );
    if(match){
      const mods=this.getModifiersForRate(match.id);
      const modTotal=mods.reduce((sum,m)=>sum+(m.valueType==='fixed'?m.value:match.baseRate*m.value/100),0);
      return {baseRate:match.baseRate,modifiers:mods,modifierTotal:modTotal,finalRate:match.baseRate+modTotal,rateStatus:'auto',rateSource:'system-thickness-finish',rateId:match.id};
    }
    // Priority 3: Without finish, designType, colourType, antiSlip, topCoat, floorCondition
    match=rates.find(r=>
      r.category==='epoxy'&&r.active!==false&&
      r.epoxyType===epoxyType&&r.system===system&&r.thickness===thickness&&r.unit===unit
    );
    if(match){
      const mods=this.getModifiersForRate(match.id);
      const modTotal=mods.reduce((sum,m)=>sum+(m.valueType==='fixed'?m.value:match.baseRate*m.value/100),0);
      return {baseRate:match.baseRate,modifiers:mods,modifierTotal:modTotal,finalRate:match.baseRate+modTotal,rateStatus:'auto',rateSource:'system-thickness',rateId:match.id};
    }
    // Priority 4: Only epoxyType + system + unit
    match=rates.find(r=>
      r.category==='epoxy'&&r.active!==false&&
      r.epoxyType===epoxyType&&r.system===system&&r.unit===unit
    );
    if(match){
      const mods=this.getModifiersForRate(match.id);
      const modTotal=mods.reduce((sum,m)=>sum+(m.valueType==='fixed'?m.value:match.baseRate*m.value/100),0);
      return {baseRate:match.baseRate,modifiers:mods,modifierTotal:modTotal,finalRate:match.baseRate+modTotal,rateStatus:'auto',rateSource:'system',rateId:match.id};
    }
    // No match
    return {baseRate:0,modifiers:[],modifierTotal:0,finalRate:0,rateStatus:'none',rateSource:'none',rateId:null};
  },

