  populateRateModal(edit){
    const l=H4DB.get('masterLists');
    const units=Object.values(H4DB.get('unitMaster')).filter(x=>x.active).map(x=>x.unit);
    setOptions('rateCategory',['epoxy','waterproofing','general'],edit?.category||'epoxy');
    this.populateRateCategoryFields();
