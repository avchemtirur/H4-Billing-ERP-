                        const cat = btn.dataset.cat === 'all' ? null : btn.dataset.cat;
                        this.loadProducts(cat);
                    });
                });

                // Keyboard shortcuts for epoxy builder
                document.addEventListener('keydown', (e) => {
                    const overlay = document.getElementById('epoxyOverlay');
                    if (!overlay || !overlay.classList.contains('active')) return;

                    if (e.key === 'Escape') {
                        e.preventDefault();
                        H4Epoxy.close();
                        return;
                    }
                    if (e.key === 'Enter' && !e.ctrlKey && !e.shiftKey) {
                        const target = e.target;
                        if (target && target.tagName === 'TEXTAREA') return;
                        e.preventDefault();
                        // Find next input or step
                        const step = document.querySelector('.epoxy-step-section.active');
                        if (!step) return;
                        const inputs = step.querySelectorAll(
                        'input:not([disabled]), select:not([disabled]), textarea:not([disabled])');
                        const idx = Array.from(inputs).indexOf(target);
                        if (idx !== -1 && idx < inputs.length - 1) {
                            inputs[idx + 1].focus();
                            inputs[idx + 1].scrollIntoView({ block: 'center' });
                        } else {
                            H4Epoxy.nextStep();
                        }
                    }
                    if (e.key === 'Enter' && e.ctrlKey) {
                        e.preventDefault();
                        H4Epoxy.save();
                    }
                });
