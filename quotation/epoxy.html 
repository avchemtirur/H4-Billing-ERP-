    <script>
        // ============================================================
        // H4 EPOXY QUOTATION - COMPLETE
        // ============================================================

        (function() {
            'use strict';

            // ============================================================
            // CONSTANTS
            // ============================================================
            const STORAGE_KEY = 'h4_epoxy_quotations';
            const GST_RATE = 18;

            // ============================================================
            // MATERIAL DATA - Consumption per sq.ft
            // ============================================================
            const materialData = {
                'epoxy-resin': { name: 'Epoxy Resin', unit: 'kg', consumption: 0.25 },
                'hardener': { name: 'Hardener', unit: 'kg', consumption: 0.10 },
                'primer': { name: 'Primer', unit: 'Litre', consumption: 0.15 },
                'putty': { name: 'Putty', unit: 'kg', consumption: 0.20 },
                'base-coat': { name: 'Base Coat', unit: 'Litre', consumption: 0.18 },
                'self-level': { name: 'Self-Level Epoxy', unit: 'Litre', consumption: 0.22 },
                'top-coat': { name: 'Top Coat', unit: 'Litre', consumption: 0.15 },
                'pu-coat': { name: 'PU Coat', unit: 'Litre', consumption: 0.12 },
                'quartz': { name: 'Quartz', unit: 'kg', consumption: 0.30 },
                'flakes': { name: 'Flakes', unit: 'kg', consumption: 0.08 },
                'metallic-pigment': { name: 'Metallic Pigment', unit: 'g', consumption: 0.05 },
                'thinner': { name: 'Thinner', unit: 'Litre', consumption: 0.10 }
            };

            // Default rates (can be edited)
            const defaultRates = {
                'epoxy-resin': 450,
                'hardener': 350,
                'primer': 280,
                'putty': 200,
                'base-coat': 380,
                'self-level': 520,
                'top-coat': 420,
                'pu-coat': 480,
                'quartz': 150,
                'flakes': 120,
                'metallic-pigment': 800,
                'thinner': 180
            };

            // ============================================================
            // STATE
            // ============================================================
            let rooms = [{ length: 10, width: 10 }];
            let materials = [];
            let currentRates = { ...defaultRates };
            let quotationNumber = 'QTN-EPX-0001';

            // ============================================================
            // DOM REFS
            // ============================================================
            const toastContainer = document.getElementById('toastContainer');

            // ============================================================
            // TOAST
            // ============================================================
            function showToast(message, type = 'info', duration = 3500) {
                const toast = document.createElement('div');
                const iconMap = {
                    success: '✅',
                    error: '❌',
                    warning: '⚠️',
                    info: 'ℹ️'
                };
                toast.className = `toast toast-${type}`;
                toast.innerHTML = `
                    <span class="toast-icon">${iconMap[type] || 'ℹ️'}</span>
                    <span>${message}</span>
                    <button class="toast-close">✕</button>
                `;
                toastContainer.appendChild(toast);

                const closeBtn = toast.querySelector('.toast-close');
                closeBtn.addEventListener('click', () => {
                    toast.remove();
                });

                setTimeout(() => {
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateX(100%)';
                    toast.style.transition = 'all 0.3s ease';
                    setTimeout(() => toast.remove(), 300);
                }, duration);
            }

            // ============================================================
            // AREA CALCULATOR
            // ============================================================
            function calculateRoomArea(index) {
                const row = document.querySelector(`.area-row[data-room="${index}"]`);
                if (!row) return;
                const length = parseFloat(row.querySelector('.room-length').value) || 0;
                const width = parseFloat(row.querySelector('.room-width').value) || 0;
                const area = length * width;
                row.querySelector('.room-area').value = area.toFixed(2);
                return area;
            }

            function calculateTotalArea() {
                let total = 0;
                document.querySelectorAll('.area-row').forEach((row, index) => {
                    total += calculateRoomArea(index) || 0;
                });
                document.getElementById('totalArea').textContent = total.toFixed(2) + ' sq.ft';
                return total;
            }

            function addRoom() {
                const container = document.getElementById('roomsContainer');
                const index = document.querySelectorAll('.area-row').length;
                const div = document.createElement('div');
                div.className = 'area-row';
                div.dataset.room = index;
                div.innerHTML = `
                    <div class="form-group">
                        <label>Length (ft)</label>
                        <input type="number" class="room-length" value="10" min="0" step="0.5" onchange="calculateRoomArea(${index}); calculateTotalArea();">
                    </div>
                    <div class="form-group">
                        <label>Width (ft)</label>
                        <input type="number" class="room-width" value="10" min="0" step="0.5" onchange="calculateRoomArea(${index}); calculateTotalArea();">
                    </div>
                    <div class="form-group" style="flex:0.5;">
                        <label>Area (sq.ft)</label>
                        <input type="text" class="room-area" readonly style="background:var(--h4-bg);font-weight:700;">
                    </div>
                    <button class="btn-remove-room" onclick="removeRoom(this)">✕</button>
                `;
                container.appendChild(div);
                calculateRoomArea(index);
                calculateTotalArea();
            }

            function removeRoom(btn) {
                const row = btn.closest('.area-row');
                if (document.querySelectorAll('.area-row').length <= 1) {
                    showToast('⚠️ At least one room is required', 'warning');
                    return;
                }
                row.remove();
                // Re-index rooms
                document.querySelectorAll('.area-row').forEach((el, idx) => {
                    el.dataset.room = idx;
                });
                calculateTotalArea();
            }

            // ============================================================
            // THICKNESS HANDLING
            // ============================================================
            function onThicknessChange() {
                const select = document.getElementById('thickness');
                const customRow = document.getElementById('customThicknessRow');
                if (select.value === 'custom') {
                    customRow.style.display = 'block';
                } else {
                    customRow.style.display = 'none';
                }
                updateMaterials();
            }

            function getThickness() {
                const select = document.getElementById('thickness');
                if (select.value === 'custom') {
                    return parseFloat(document.getElementById('customThickness').value) || 0;
                }
                return parseFloat(select.value) || 0;
            }

            // ============================================================
            // SYSTEM HANDLING
            // ============================================================
            function onSystemChange() {
                updateMaterials();
            }

            // ============================================================
            // MATERIALS
            // ============================================================
            function updateMaterials() {
                const area = calculateTotalArea();
                const thickness = getThickness();
                const system = document.getElementById('epoxySystem').value;

                if (!area || area <= 0 || !thickness || thickness <= 0 || !system) {
                    renderMaterials([]);
                    return;
                }

                // Get consumption multiplier based on thickness
                const thicknessMultiplier = thickness / 1.0; // Base thickness 1mm

                // Get system-specific materials
                const systemMaterials = getSystemMaterials(system);

                const materialList = systemMaterials.map(mat => {
                    const baseData = materialData[mat.id];
                    if (!baseData) return null;
                    const consumption = baseData.consumption * thicknessMultiplier * area;
                    const rate = currentRates[mat.id] || 0;
                    return {
                        id: mat.id,
                        name: baseData.name,
                        unit: baseData.unit,
                        consumption: consumption,
                        qty: consumption,
                        rate: rate,
                        total: consumption * rate
                    };
                }).filter(m => m !== null);

                renderMaterials(materialList);
                updateCosting(materialList);
            }

            function getSystemMaterials(system) {
                const materialMap = {
                    'standard-roller': [
                        { id: 'epoxy-resin' }, { id: 'hardener' }, { id: 'primer' },
                        { id: 'putty' }, { id: 'top-coat' }, { id: 'thinner' }
                    ],
                    'self-leveling': [
                        { id: 'epoxy-resin' }, { id: 'hardener' }, { id: 'primer' },
                        { id: 'self-level' }, { id: 'top-coat' }
                    ],
                    'metallic': [
                        { id: 'epoxy-resin' }, { id: 'hardener' }, { id: 'primer' },
                        { id: 'base-coat' }, { id: 'metallic-pigment' }, { id: 'top-coat' }
                    ],
                    'flake': [
                        { id: 'epoxy-resin' }, { id: 'hardener' }, { id: 'primer' },
                        { id: 'base-coat' }, { id: 'flakes' }, { id: 'top-coat' }
                    ],
                    '3d': [
                        { id: 'epoxy-resin' }, { id: 'hardener' }, { id: 'primer' },
                        { id: 'base-coat' }, { id: 'self-level' }, { id: 'top-coat' }
                    ],
                    'pu': [
                        { id: 'epoxy-resin' }, { id: 'hardener' }, { id: 'primer' },
                        { id: 'pu-coat' }, { id: 'thinner' }
                    ],
                    'esd': [
                        { id: 'epoxy-resin' }, { id: 'hardener' }, { id: 'primer' },
                        { id: 'base-coat' }, { id: 'top-coat' }
                    ],
                    'food-grade': [
                        { id: 'epoxy-resin' }, { id: 'hardener' }, { id: 'primer' },
                        { id: 'self-level' }, { id: 'top-coat' }
                    ]
                };
                return materialMap[system] || [];
            }

            function renderMaterials(materialList) {
                const tbody = document.getElementById('materialBody');
                if (!materialList || materialList.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="6" style="text-align:center;padding:20px;color:var(--h4-text-muted);">
                                Select Area, System & Thickness to calculate materials
                            </td>
                        </tr>
                    `;
                    return;
                }

                tbody.innerHTML = materialList.map((mat, index) => `
                    <tr>
                        <td><strong>${mat.name}</strong></td>
                        <td>${mat.unit}</td>
                        <td>${mat.consumption.toFixed(3)}</td>
                        <td>
                            <input type="number" class="qty-input" value="${mat.qty.toFixed(2)}" 
                                   onchange="updateMaterialQty(${index}, this.value)">
                        </td>
                        <td>
                            <input type="number" class="rate-input" value="${mat.rate}" 
                                   onchange="updateMaterialRate(${index}, this.value)">
                        </td>
                        <td style="font-weight:600;">₹${mat.total.toFixed(2)}</td>
                    </tr>
                `).join('');

                // Store materials for reference
                materials = materialList;
            }

            function updateMaterialQty(index, value) {
                if (materials[index]) {
                    materials[index].qty = parseFloat(value) || 0;
                    materials[index].total = materials[index].qty * materials[index].rate;
                    updateCosting(materials);
                    renderMaterials(materials);
                }
            }

            function updateMaterialRate(index, value) {
                if (materials[index]) {
                    const mat = materials[index];
                    const rate = parseFloat(value) || 0;
                    mat.rate = rate;
                    mat.total = mat.qty * rate;
                    currentRates[mat.id] = rate;
                    updateCosting(materials);
                    renderMaterials(materials);
                }
            }

            // ============================================================
            // COSTING
            // ============================================================
            function updateCosting(materialList) {
                const area = calculateTotalArea();
                const thickness = getThickness();

                // Material Cost
                const materialCost = materialList.reduce((sum, m) => sum + m.total, 0);

                // Labour Cost (based on area and thickness)
                const labourRate = 25 * (1 + (thickness - 1) * 0.2);
                const labourCost = area * labourRate;

                // Other costs (estimates)
                const grindingCost = area * 8;
                const cleaningCost = area * 5;
                const transportCost = area * 4;
                const loadingCost = area * 3;
                const otherCost = area * 6;

                const totalCost = materialCost + labourCost + grindingCost + cleaningCost + 
                                 transportCost + loadingCost + otherCost;

                // Overhead
                const overheadPercent = 10;
                const overheadAmount = totalCost * overheadPercent / 100;
                const costBeforeProfit = totalCost + overheadAmount;

                // Profit
                const profitPercent = 25;
                const profitAmount = costBeforeProfit * profitPercent / 100;
                const sellingPrice = costBeforeProfit + profitAmount;

                // Update UI
                document.getElementById('materialCost').textContent = `₹${materialCost.toFixed(2)}`;
                document.getElementById('labourCost').textContent = `₹${labourCost.toFixed(2)}`;
                document.getElementById('grindingCost').textContent = `₹${grindingCost.toFixed(2)}`;
                document.getElementById('cleaningCost').textContent = `₹${cleaningCost.toFixed(2)}`;
                document.getElementById('transportCost').textContent = `₹${transportCost.toFixed(2)}`;
                document.getElementById('loadingCost').textContent = `₹${loadingCost.toFixed(2)}`;
                document.getElementById('otherCost').textContent = `₹${otherCost.toFixed(2)}`;
                document.getElementById('totalCost').textContent = `₹${totalCost.toFixed(2)}`;

                document.getElementById('overheadPercent').textContent = `${overheadPercent}%`;
                document.getElementById('overheadAmount').textContent = `₹${overheadAmount.toFixed(2)}`;
                document.getElementById('costBeforeProfit').textContent = `₹${costBeforeProfit.toFixed(2)}`;
                document.getElementById('profitPercent').textContent = `${profitPercent}%`;
                document.getElementById('profitAmount').textContent = `₹${profitAmount.toFixed(2)}`;
                document.getElementById('sellingPrice').textContent = `₹${sellingPrice.toFixed(2)}`;

                // Profit Box
                document.getElementById('profitTotalCost').textContent = `₹${totalCost.toFixed(2)}`;
                document.getElementById('profitOverhead').textContent = `₹${overheadAmount.toFixed(2)}`;
                document.getElementById('profitPercentDisplay').textContent = `${profitPercent}%`;
                document.getElementById('profitAmountDisplay').textContent = `₹${profitAmount.toFixed(2)}`;
                document.getElementById('netProfit').textContent = `₹${profitAmount.toFixed(2)}`;

                // Store for customer quotation
                window._sellingPrice = sellingPrice;
                window._materialCost = materialCost;
                window._totalCost = totalCost;
                window._profitAmount = profitAmount;

                // Update customer quotation
                updateCustomerQuotation(sellingPrice);
            }

            // ============================================================
            // CUSTOMER QUOTATION
            // ============================================================
            function updateCustomerQuotation(sellingPrice) {
                const area = calculateTotalArea();
                const system = document.getElementById('epoxySystem');
                const systemText = system.options[system.selectedIndex]?.text || '-';
                const thickness = getThickness();
                const thicknessText = document.getElementById('thickness').value === 'custom' ?
                    document.getElementById('customThickness').value + ' mm (Custom)' :
                    thickness + ' mm';

                // Customer details
                const customerName = document.getElementById('customerName').value || '-';
                const customerMobile = document.getElementById('customerMobile').value || '-';
                const customerAddress = document.getElementById('customerAddress').value || '-';
                const projectAddress = document.getElementById('projectAddress').value || '-';

                // Update customer quotation display
                document.getElementById('qtnCustomerDisplay').textContent = customerName;
                document.getElementById('qtnMobileDisplay').textContent = customerMobile;
                document.getElementById('qtnAddressDisplay').textContent = customerAddress;
                document.getElementById('qtnProjectDisplay').textContent = projectAddress;
                document.getElementById('qtnAreaDisplay').textContent = area.toFixed(2) + ' sq.ft';
                document.getElementById('qtnSystemDisplay').textContent = systemText;
                document.getElementById('qtnThicknessDisplay').textContent = thicknessText;

                // Set date
                const today = new Date();
                document.getElementById('qtnDateDisplay').textContent = today.toISOString().split('T')[0];
                const validUntil = new Date(today);
                validUntil.setDate(validUntil.getDate() + 30);
                document.getElementById('qtnValidDisplay').textContent = validUntil.toISOString().split('T')[0];

                // Items table
                const itemsBody = document.getElementById('qtnItemsBody');
                const ratePerSqft = sellingPrice / area;
                itemsBody.innerHTML = `
                    <tr>
                        <td>${systemText} Flooring (${thicknessText})</td>
                        <td style="text-align:right;">${area.toFixed(2)}</td>
                        <td style="text-align:right;">₹${ratePerSqft.toFixed(2)}</td>
                        <td style="text-align:right;">₹${sellingPrice.toFixed(2)}</td>
                    </tr>
                `;

                // Totals
                const gst = sellingPrice * GST_RATE / 100;
                const grandTotal = sellingPrice + gst;

                document.getElementById('qtnSubtotal').textContent = `₹${sellingPrice.toFixed(2)}`;
                document.getElementById('qtnGST').textContent = `₹${gst.toFixed(2)}`;
                document.getElementById('qtnGrandTotal').textContent = `₹${grandTotal.toFixed(2)}`;

                // Set quotation number
                const count = getQuotationCount();
                quotationNumber = `QTN-EPX-${String(count + 1).padStart(4, '0')}`;
                document.getElementById('qtnNumberDisplay').textContent = quotationNumber;
            }

            function getQuotationCount() {
                try {
                    const data = localStorage.getItem(STORAGE_KEY);
                    if (data) {
                        const parsed = JSON.parse(data);
                        return parsed.length || 0;
                    }
                } catch (e) {}
                return 0;
            }

            // ============================================================
            // GENERATE & SAVE
            // ============================================================
            function generateQuotation() {
                // Validate
                const customerName = document.getElementById('customerName').value.trim();
                if (!customerName) {
                    document.getElementById('customerNameGroup').classList.add('error');
                    showToast('⚠️ Customer name is required', 'error');
                    document.getElementById('customerName').focus();
                    return;
                }
                document.getElementById('customerNameGroup').classList.remove('error');

                const projectAddress = document.getElementById('projectAddress').value.trim();
                if (!projectAddress) {
                    document.getElementById('projectAddress').parentElement.classList.add('error');
                    showToast('⚠️ Project address is required', 'error');
                    document.getElementById('projectAddress').focus();
                    return;
                }
                document.getElementById('projectAddress').parentElement.classList.remove('error');

                const system = document.getElementById('epoxySystem').value;
                if (!system) {
                    document.getElementById('systemGroup').classList.add('error');
                    showToast('⚠️ Please select an epoxy system', 'error');
                    return;
                }
                document.getElementById('systemGroup').classList.remove('error');

                const thickness = getThickness();
                if (!thickness || thickness <= 0) {
                    document.getElementById('thicknessGroup').classList.add('error');
                    showToast('⚠️ Please select thickness', 'error');
                    return;
                }
                document.getElementById('thicknessGroup').classList.remove('error');

                const area = calculateTotalArea();
                if (!area || area <= 0) {
                    showToast('⚠️ Please enter valid area dimensions', 'error');
                    return;
                }

                // Build quotation data
                const quotationData = {
                    id: 'qtn_' + Date.now(),
                    quotationNumber: quotationNumber,
                    date: new Date().toISOString().split('T')[0],
                    validUntil: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
                    customer: {
                        name: customerName,
                        mobile: document.getElementById('customerMobile').value.trim(),
                        address: document.getElementById('customerAddress').value.trim()
                    },
                    project: {
                        address: projectAddress,
                        area: area,
                        system: document.getElementById('epoxySystem').value,
                        systemText: document.getElementById('epoxySystem').options[document.getElementById('epoxySystem').selectedIndex]?.text || '',
                        thickness: thickness,
                        thicknessText: document.getElementById('thickness').value === 'custom' ?
                            document.getElementById('customThickness').value + ' mm (Custom)' :
                            thickness + ' mm'
                    },
                    materials: materials.map(m => ({
                        id: m.id,
                        name: m.name,
                        unit: m.unit,
                        qty: m.qty,
                        rate: m.rate,
                        total: m.total
                    })),
                    costing: {
                        materialCost: window._materialCost || 0,
                        labourCost: parseFloat(document.getElementById('labourCost').textContent.replace('₹', '')) || 0,
                        totalCost: window._totalCost || 0,
                        overheadPercent: 10,
                        overheadAmount: parseFloat(document.getElementById('overheadAmount').textContent.replace('₹', '')) || 0,
                        profitPercent: 25,
                        profitAmount: window._profitAmount || 0,
                        sellingPrice: window._sellingPrice || 0
                    },
                    customerQuote: {
                        subtotal: window._sellingPrice || 0,
                        gstRate: GST_RATE,
                        gst: (window._sellingPrice || 0) * GST_RATE / 100,
                        grandTotal: (window._sellingPrice || 0) * (1 + GST_RATE / 100)
                    },
                    status: 'draft',
                    createdAt: new Date().toISOString()
                };

                // Save to localStorage
                let existing = [];
                try {
                    const data = localStorage.getItem(STORAGE_KEY);
                    if (data) existing = JSON.parse(data);
                } catch (e) {}
                existing.push(quotationData);
                localStorage.setItem(STORAGE_KEY, JSON.stringify(existing));

                showToast(`✅ Quotation ${quotationNumber} saved successfully!`, 'success');
            }

            // ============================================================
            // PRINT
            // ============================================================
            function printQuotation() {
                const customerQuotation = document.getElementById('customerQuotation');
                const originalContent = customerQuotation.innerHTML;

                // Create print window
                const win = window.open('', '_blank');
                if (!win) {
                    showToast('⚠️ Please allow popups to print', 'warning');
                    return;
                }

                // Build print HTML
                const printHtml = `
                    <!DOCTYPE html>
                    <html>
                    <head>
                        <meta charset="UTF-8">
                        <meta name="viewport" content="width=device-width, initial-scale=1.0">
                        <title>H4 Epoxy Quotation - ${quotationNumber}</title>
                        <style>
                            * { margin: 0; padding: 0; box-sizing: border-box; }
                            body { font-family: Arial, sans-serif; padding: 20px; color: #1a1a2e; }
                            .print-container { max-width: 900px; margin: 0 auto; }
                            ${document.querySelector('style').innerHTML}
                            .no-print { display: none !important; }
                            .profit-box { display: none !important; }
                            .internal-costing { display: none !important; }
                            .section-title .badge.internal { display: none !important; }
                            .customer-quotation { border: 2px solid #FFD700; box-shadow: none; padding: 20px; }
                        </style>
                    </head>
                    <body>
                        <div class="print-container">
                            ${customerQuotation.outerHTML}
                        </div>
                        <script>
                            window.onload = function() { window.print(); };
                        <\/script>
                    </body>
                    </html>
                `;

                win.document.write(printHtml);
                win.document.close();
            }

            // ============================================================
            // CONVERT TO INVOICE
            // ============================================================
            function convertToInvoice() {
                const customerName = document.getElementById('customerName').value.trim();
                if (!customerName) {
                    showToast('⚠️ Please generate quotation first', 'warning');
                    return;
                }

                const sellingPrice = window._sellingPrice || 0;
                if (!sellingPrice || sellingPrice <= 0) {
                    showToast('⚠️ Please calculate costs first', 'warning');
                    return;
                }

                const grandTotal = sellingPrice * (1 + GST_RATE / 100);

                // Build invoice data
                const invoiceData = {
                    invoiceNumber: 'INV-EPX-' + String(Date.now()).slice(-4),
                    quotationNumber: quotationNumber,
                    customer: {
                        name: customerName,
                        mobile: document.getElementById('customerMobile').value.trim(),
                        address: document.getElementById('customerAddress').value.trim()
                    },
                    project: {
                        address: document.getElementById('projectAddress').value.trim(),
                        area: calculateTotalArea(),
                        system: document.getElementById('epoxySystem').options[document.getElementById('epoxySystem').selectedIndex]?.text || '',
                        thickness: getThickness() + ' mm'
                    },
                    items: [{
                        description: document.getElementById('epoxySystem').options[document.getElementById('epoxySystem').selectedIndex]?.text || 'Epoxy Flooring',
                        area: calculateTotalArea(),
                        rate: sellingPrice / calculateTotalArea(),
                        amount: sellingPrice
                    }],
                    subtotal: sellingPrice,
                    gstRate: GST_RATE,
                    gst: sellingPrice * GST_RATE / 100,
                    grandTotal: grandTotal,
                    date: new Date().toISOString().split('T')[0]
                };

                // Save to invoice storage
                let invoices = [];
                try {
                    const data = localStorage.getItem('h4_invoices_epoxy');
                    if (data) invoices = JSON.parse(data);
                } catch (e) {}
                invoices.push(invoiceData);
                localStorage.setItem('h4_invoices_epoxy', JSON.stringify(invoices));

                showToast(`✅ Converted to Invoice: ${invoiceData.invoiceNumber}`, 'success');

                // Navigate to invoice view
                setTimeout(() => {
                    if (confirm(`Invoice ${invoiceData.invoiceNumber} created! View invoice?`)) {
                        window.location.href = `invoice-epoxy.html?invoice=${invoiceData.invoiceNumber}`;
                    }
                }, 500);
            }

            // ============================================================
            // RESET
            // ============================================================
            function resetForm() {
                if (!confirm('Reset all form data?')) return;

                document.getElementById('customerName').value = '';
                document.getElementById('customerMobile').value = '';
                document.getElementById('customerAddress').value = '';
                document.getElementById('projectAddress').value = '';
                document.getElementById('epoxySystem').value = '';
                document.getElementById('thickness').value = '';
                document.getElementById('customThickness').value = '';
                document.getElementById('customThicknessRow').style.display = 'none';

                document.querySelectorAll('.form-group').forEach(el => el.classList.remove('error'));

                // Reset rooms
                const container = document.getElementById('roomsContainer');
                container.innerHTML = '';
                rooms = [{ length: 10, width: 10 }];
                addRoom();

                // Reset materials
                materials = [];
                renderMaterials([]);

                // Reset costing
                document.querySelectorAll('.costing-box .value').forEach(el => {
                    el.textContent = '₹0.00';
                });
                document.getElementById('overheadPercent').textContent = '0%';
                document.getElementById('profitPercent').textContent = '0%';
                document.getElementById('profitPercentDisplay').textContent = '0%';

                // Reset customer quotation
                document.getElementById('qtnCustomerDisplay').textContent = '-';
                document.getElementById('qtnMobileDisplay').textContent = '-';
                document.getElementById('qtnAddressDisplay').textContent = '-';
                document.getElementById('qtnProjectDisplay').textContent = '-';
                document.getElementById('qtnAreaDisplay').textContent = '-';
                document.getElementById('qtnSystemDisplay').textContent = '-';
                document.getElementById('qtnThicknessDisplay').textContent = '-';
                document.getElementById('qtnItemsBody').innerHTML = '';
                document.getElementById('qtnSubtotal').textContent = '₹0.00';
                document.getElementById('qtnGST').textContent = '₹0.00';
                document.getElementById('qtnGrandTotal').textContent = '₹0.00';

                showToast('↻ Form reset', 'info');
            }

            // ============================================================
            // EXPOSE FUNCTIONS TO GLOBAL SCOPE
            // ============================================================
            window.calculateRoomArea = calculateRoomArea;
            window.calculateTotalArea = calculateTotalArea;
            window.addRoom = addRoom;
            window.removeRoom = removeRoom;
            window.onThicknessChange = onThicknessChange;
            window.onSystemChange = onSystemChange;
            window.updateMaterialQty = updateMaterialQty;
            window.updateMaterialRate = updateMaterialRate;
            window.generateQuotation = generateQuotation;
            window.printQuotation = printQuotation;
            window.convertToInvoice = convertToInvoice;
            window.resetForm = resetForm;

            // ============================================================
            // BACK BUTTON
            // ============================================================
            document.getElementById('backBtn').addEventListener('click', function() {
                window.location.href = '../modules/quotation.html';
            });

            document.getElementById('brandLink').addEventListener('click', function(e) {
                e.preventDefault();
                window.location.href = '../index.html';
            });

            // ============================================================
            // INIT
            // ============================================================
            function init() {
                // Initialize with one room
                addRoom();
                calculateTotalArea();

                // Set default date
                const today = new Date().toISOString().split('T')[0];
                document.getElementById('qtnDateDisplay').textContent = today;

                // Event listeners
                document.getElementById('thickness').addEventListener('change', onThicknessChange);
                document.getElementById('epoxySystem').addEventListener('change', onSystemChange);
                document.getElementById('customThickness').addEventListener('input', function() {
                    if (document.getElementById('thickness').value === 'custom') {
                        updateMaterials();
                    }
                });

                // Auto-update on area changes
                document.addEventListener('change', function(e) {
                    if (e.target.classList.contains('room-length') || e.target.classList.contains('room-width')) {
                        calculateTotalArea();
                        updateMaterials();
                    }
                });

                document.addEventListener('input', function(e) {
                    if (e.target.classList.contains('room-length') || e.target.classList.contains('room-width')) {
                        const row = e.target.closest('.area-row');
                        if (row) {
                            const index = parseInt(row.dataset.room);
                            calculateRoomArea(index);
                            calculateTotalArea();
                            updateMaterials();
                        }
                    }
                });

                console.log('🧪 H4 Epoxy Quotation loaded successfully');
            }

            // Run init when DOM ready
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }

        })();
    </script>

</body>
</html>