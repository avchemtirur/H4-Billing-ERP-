                document.getElementById('epxWarrantyTerms').value = wr.terms || '';
                document.getElementById('epxWarrantyConditions').value = wr.conditions || '';
                document.getElementById('epxAdvancePayment').value = tc.advancePayment || 50;
                document.getElementById('epxBalancePayment').value = tc.balancePayment || '50% upon completion';
                document.getElementById('epxWorkSchedule').value = tc.workSchedule || 'As mutually agreed';
                document.getElementById('epxWaterElectricity').value = tc.waterElectricityByClient ||
                    'To be provided by client';
                document.getElementById('epxSurfaceCondition').value = tc.surfaceConditionResponsibility ||
                    'Client to disclose existing substrate defects and moisture issues.';
                document.getElementById('epxAccessToSite').value = tc.accessToWorkArea ||
                    'Safe access to be provided by client.';
                document.getElementById('epxCuringRestrictions').value = tc.curingRestrictions ||
                    'Restrict traffic during curing.';
                document.getElementById('epxMaintenance').value = tc.maintenanceRequirements ||
                    'Follow recommended cleaning and maintenance.';
