            hasChanges() {
                return this.scopeItems.length > 0 || this.priceItems.length > 0 ||
                    document.getElementById('epxProjectName').value.trim() !== '';
            },

            // ----- DRAFT -----
            saveDraft() {
                const data = this.collectData();
                localStorage.setItem(this.draftKey, JSON.stringify(data));
            },

            loadDraft() {
                const raw = localStorage.getItem(this.draftKey);
                if (!raw) return;
                try {
                    const data = JSON.parse(raw);
                    if (data && data.projectName) {
                        if (confirm('🔄 Unsaved draft found. Continue editing?')) {
                            this.loadData(data);
                            H4Notify.success('Draft loaded.');
                        } else {
                            localStorage.removeItem(this.draftKey);
                        }
                    }
                } catch (e) {}
            },

            // ----- MASTER DROPDOWNS -----
            populateMasterDropdowns() {
                const sets = {
                    'epxAreaUnit': 'unitMaster',
                    'epxFlooringType': 'flooringTypeMaster',
                    'epxThickness': 'thicknessMaster',
                    'epxFloorCondition': 'floorConditionMaster',
                    'arFlooringType': 'flooringTypeMaster',
                    'arThickness': 'thicknessMaster',
                    'arUnit': 'unitMaster'
                };
                Object.entries(sets).forEach(([elId, storeKey]) => {
                    const el = document.getElementById(elId);
                    if (!el) return;
                    const items = H4DB.get(storeKey) || {};
                    const currentVal = el.value;
                    el.innerHTML = Object.values(items).map(i =>
                        `<option value="${H4Utils.escape(i.name)}">${H4Utils.escape(i.name)}</option>`
                    ).join('');
                    if (currentVal) el.value = currentVal;
                });
            },

            addMasterItem(storeKey, inputId, targetSelectId, label) {
                const input = document.getElementById(inputId);
                if (!input) {
                    // Show hidden input
                    const hidden = document.getElementById(inputId);
                    if (hidden) hidden.style.display = 'inline-block';
                    return;
                }
                const value = input.value.trim();
                if (!value) { H4Notify.danger('Please enter a value.'); return; }
                const items = H4DB.get(storeKey) || {};
                const exists = Object.values(items).some(i => i.name === value);
                if (exists) { H4Notify.danger('Already exists.'); return; }
                const id = H4Utils.generateId(storeKey.slice(0, 2));
                items[id] = { id, name: value };
                H4DB.save(storeKey, items);
                input.value = '';
                this.populateMasterDropdowns();
                const target = document.getElementById(targetSelectId);
                if (target) target.value = value;
                H4Notify.success(label + ' added.');
                this.onSystemChange();
            },

            // ----- NUMBER -----
            generateNumber() {
                const num = H4Numbering.getNextQuotationNumber();
                document.getElementById('epxNumber').value = num;
                document.getElementById('epxDate').value = H4Utils.today();
            },

            // ----- STEPS -----
            renderSteps() {
                const container = document.getElementById('epoxySteps');
                const labels = ['Customer', 'Project', 'Smart Rate', 'Work Scope', 'Material Spec', 'Price Items',
                    'Discount', 'Calculation', 'Timeline', 'Warranty', 'Features', 'Terms', 'Footer'
                ];
                container.innerHTML = labels.map((label, i) => {
                    const step = i + 1;
                    let cls = 'epoxy-step-chip';
                    if (step === this.currentStep) cls += ' active';
                    else if (step < this.currentStep) cls += ' done';
                    return `<div class="${cls}" onclick="H4Epoxy.goToStep(${step})">${step}. ${label}</div>`;
                }).join('');
            },

            renderStep() {
                document.querySelectorAll('.epoxy-step-section').forEach(el => {
                    el.classList.toggle('active', parseInt(el.dataset.step) === this.currentStep);
                });
                this.renderScopeList();
                this.renderFeatureList();
                this.renderPriceItems();
                this.updatePreview();
                this.renderSteps();
                document.getElementById('epxStepCounter').textContent = `Step ${this.currentStep} / ${this.totalSteps}`;
            },

            goToStep(step) {
                if (step < 1 || step > this.totalSteps) return;
                this.currentStep = step;
                this.renderStep();
            },

            nextStep() {
                if (this.currentStep < this.totalSteps) {
                    this.currentStep++;
                    this.renderStep();
                }
            },

            prevStep() {
                if (this.currentStep > 1) {
                    this.currentStep--;
                    this.renderStep();
                }
            },

            // ----- SCOPE -----
            renderScopeList() {
                const container = document.getElementById('epxScopeList');
                container.innerHTML = this.scopeItems.map((item, i) => `
                    <div class="scope-item">
                        <input type="checkbox" ${item.selected ? 'checked' : ''} onchange="H4Epoxy.scopeItems[${i}].selected = this.checked; H4Epoxy.updatePreview();">
                        <input type="text" value="${H4Utils.escape(item.name)}" onchange="H4Epoxy.scopeItems[${i}].name = this.value; H4Epoxy.updatePreview();">
                        <button class="btn btn-sm btn-danger" onclick="H4Epoxy.scopeItems.splice(${i}, 1); H4Epoxy.renderScopeList(); H4Epoxy.updatePreview();">✕</button>
                    </div>
                `).join('') || '<p style="color:var(--text-secondary);">No scope items</p>';
            },

            addScopeItem() {
                this.scopeItems.push({ id: H4Utils.generateId('scope'), name: 'New Scope Item', selected: true,
                    description: 'New Scope Item' });
                this.renderScopeList();
                this.updatePreview();
            },

            // ----- FEATURES -----
            renderFeatureList() {
                const container = document.getElementById('epxFeatureList');
                container.innerHTML = this.featureItems.map((item, i) => `
                    <div class="feature-item">
                        <input type="checkbox" ${item.selected ? 'checked' : ''} onchange="H4Epoxy.featureItems[${i}].selected = this.checked; H4Epoxy.updatePreview();">
                        <input type="text" value="${H4Utils.escape(item.name)}" onchange="H4Epoxy.featureItems[${i}].name = this.value; H4Epoxy.updatePreview();">
                        <button class="btn btn-sm btn-danger" onclick="H4Epoxy.featureItems.splice(${i}, 1); H4Epoxy.renderFeatureList(); H4Epoxy.updatePreview();">✕</button>
                    </div>
                `).join('') || '<p style="color:var(--text-secondary);">No features</p>';
            },

            addFeatureItem() {
                this.featureItems.push({ id: H4Utils.generateId('feat'), name: 'New Feature', selected: true });
                this.renderFeatureList();
                this.updatePreview();
            },

            // ----- PRICE ITEMS -----
            renderPriceItems() {
                const container = document.getElementById('epxPriceItems');
                container.innerHTML = this.priceItems.map((item, i) => {
                    const total = (item.quantity || 0) * (item.rate || 0);
                    return `
                        <div class="price-item-card">
                            <div class="price-item-grid">
                                <div><label style="font-size:0.7rem;color:var(--text-secondary);">Description</label><input type="text" value="${H4Utils.escape(item.description)}" onchange="H4Epoxy.updatePriceItem(${i}, 'description', this.value)"></div>
                                <div><label style="font-size:0.7rem;color:var(--text-secondary);">Category</label>
                                    <select onchange="H4Epoxy.updatePriceItem(${i}, 'category', this.value)">
                                        ${['Material Cost','Labour Cost','Surface Preparation','Crack Repair','Primer Coat','Epoxy Screed / Putty','Self-Leveling Epoxy','Decorative Finish','PU Top Coat','Transportation','Other Charges'].map(c => `<option value="${c}" ${c===item.category?'selected':''}>${c}</option>`).join('')}
                                    </select>
                                </div>
                                <div><label style="font-size:0.7rem;color:var(--text-secondary);">Flooring Type</label><input type="text" value="${H4Utils.escape(item.flooringType||'')}" onchange="H4Epoxy.updatePriceItem(${i}, 'flooringType', this.value)"></div>
                                <div><label style="font-size:0.7rem;color:var(--text-secondary);">Thickness</label><input type="text" value="${H4Utils.escape(item.thickness||'')}" onchange="H4Epoxy.updatePriceItem(${i}, 'thickness', this.value)"></div>
                                <div><label style="font-size:0.7rem;color:var(--text-secondary);">Quantity</label><input type="number" value="${item.quantity}" onchange="H4Epoxy.updatePriceItem(${i}, 'quantity', this.value)"></div>
                                <div><label style="font-size:0.7rem;color:var(--text-secondary);">Unit</label><input type="text" value="${H4Utils.escape(item.unit||'')}" onchange="H4Epoxy.updatePriceItem(${i}, 'unit', this.value)"></div>
                                <div><label style="font-size:0.7rem;color:var(--text-secondary);">Rate (₹)</label><input type="number" value="${item.rate}" onchange="H4Epoxy.updatePriceItem(${i}, 'rate', this.value)"></div>
                                <div><label style="font-size:0.7rem;color:var(--text-secondary);">GST %</label><input type="number" value="${item.gst}" onchange="H4Epoxy.updatePriceItem(${i}, 'gst', this.value)"></div>
                                <div style="display:flex;align-items:flex-end;gap:0.5rem;grid-column:span 2;">
                                    <div><label style="font-size:0.7rem;color:var(--text-secondary);">Total</label><strong>₹${total.toFixed(2)}</strong></div>
                                    <button class="btn btn-danger btn-sm" onclick="H4Epoxy.removePriceItem(${i})">✕</button>
                                    <button class="btn btn-outline btn-sm" onclick="H4Epoxy.duplicatePriceItem(${i})">⧉</button>
                                </div>
                            </div>
                        </div>
                    `;
                }).join('') || '<p style="color:var(--text-secondary);">No price items. Add one below.</p>';
            },

            addPriceItem() {
                const pd = this.collectData();
                this.priceItems.push({
                    id: H4Utils.generateId('pitem'),
                    description: 'New Item',
                    category: 'Material Cost',
                    flooringType: pd.flooringType || '',
                    thickness: pd.thickness || '',
                    quantity: 1,
                    unit: pd.areaUnit || 'sq.ft',
                    rate: 0,
                    gst: 18,
                    discount: 0,
                    discountType: 'flat'
                });
                this.renderPriceItems();
                this.calculate();
            },

            duplicatePriceItem(index) {
                const item = JSON.parse(JSON.stringify(this.priceItems[index]));
                item.id = H4Utils.generateId('pitem');
                this.priceItems.splice(index + 1, 0, item);
                this.renderPriceItems();
                this.calculate();
            },

            updatePriceItem(index, field, value) {
                if (['quantity', 'rate', 'gst', 'discount'].includes(field)) value = Number(value) || 0;
                this.priceItems[index][field] = value;
                this.renderPriceItems();
                this.calculate();
            },

            removePriceItem(index) {
                if (this.priceItems.length <= 1) { H4Notify.danger('Keep at least one item.'); return; }
                this.priceItems.splice(index, 1);
                this.renderPriceItems();
                this.calculate();
            },

            // ----- SMART RATE -----
            onSystemChange() {
                const pd = this.collectData();
                const ft = pd.flooringType || '';
                const th = pd.thickness || '';
                const unit = pd.areaUnit || 'sq.ft';
                const area = Number(pd.area) || 0;

                const rates = H4DB.get('rateMaster') || {};
                const match = Object.values(rates).find(r =>
                    r.active !== false &&
                    r.flooringType === ft &&
                    r.thickness === th &&
                    r.unit === unit
                );

                const statusEl = document.getElementById('epxRateStatus');
                const rateInput = document.getElementById('epxSystemRate');
                const gstInput = document.getElementById('epxSystemGst');

                if (match) {
                    this.isManualRate = false;
                    rateInput.value = match.rate;
                    gstInput.value = match.gst || 18;
                    statusEl.className = 'rate-status auto';
                    statusEl.innerHTML =
                        `✅ Auto Rate: ${H4Utils.formatCurrency(match.rate)} / ${unit} (GST ${match.gst || 18}%)`;
                } else if (ft && th) {
                    statusEl.className = 'rate-status missing';
                    statusEl.innerHTML =
                    `⚠️ Rate not configured for ${ft} • ${th} • ${unit}. Use Rate Master to add.`;
                    if (!this.isManualRate) rateInput.value = '';
                } else {
                    statusEl.className = 'rate-status auto';
                    statusEl.innerHTML = 'Select Flooring Type, Thickness, and Unit.';
                }

                this.calculateSystemAmount();
                this.updatePreview();
                this.saveDraft();
            },

            onManualRateEdit() {
                this.isManualRate = true;
                const statusEl = document.getElementById('epxRateStatus');
                const rate = document.getElementById('epxSystemRate').value;
                statusEl.className = 'rate-status override';
                statusEl.innerHTML = `✏️ Manual Override: ${H4Utils.formatCurrency(rate)}`;
                this.calculateSystemAmount();
                this.calculate();
                this.saveDraft();
            },

            resetToAutoRate() {
                this.isManualRate = false;
                document.getElementById('epxSystemRate').value = '';
                this.onSystemChange();
            },

            calculateSystemAmount() {
                const area = Number(document.getElementById('epxArea')?.value) || 0;
                const rate = Number(document.getElementById('epxSystemRate')?.value) || 0;
                const amount = area * rate;
                document.getElementById('epxSystemAmount').textContent = H4Utils.formatCurrency(amount);

                // Auto-add to price items if not present
                const desc = 'Self-Leveling Epoxy System';
                if (amount > 0 && !this.priceItems.find(p => p.description === desc)) {
                    this.priceItems = this.priceItems.filter(p => p.description !== desc);
                    const unit = document.getElementById('epxAreaUnit')?.value || 'sq.ft';
                    const gst = Number(document.getElementById('epxSystemGst')?.value) || 18;
                    this.priceItems.unshift({
                        id: H4Utils.generateId('pitem'),
                        description: desc,
                        category: 'Self-Leveling Epoxy',
                        flooringType: document.getElementById('epxFlooringType')?.value || '',
                        thickness: document.getElementById('epxThickness')?.value || '',
                        quantity: area,
                        unit: unit,
                        rate: rate,
                        gst: gst,
                        discount: 0,
                        discountType: 'flat'
                    });
                    this.renderPriceItems();
                }
                this.calculate();
            },

            // ----- CALCULATION -----
            calculate() {
                const items = this.priceItems.map(p => ({
                    quantity: p.quantity || 0,
                    rate: p.rate || 0,
                    discount: p.discount || 0,
                    gst: p.gst || 0,
                    discountType: p.discountType || 'flat'
                }));

                const gstMode = document.getElementById('epxGstMode')?.value || 'intra';
                const totals = H4Calc.calculateTotals(items, gstMode);

                const discountEnabled = document.getElementById('epxDiscountEnabled')?.checked;
                let discountValue = Number(document.getElementById('epxDiscountValue')?.value) || 0;
                const discountType = document.getElementById('epxDiscountType')?.value || 'flat';

                let discountAmount = 0;
                if (discountEnabled) {
                    if (discountType === 'percentage') {
                        discountAmount = totals.subtotal * discountValue / 100;
                    } else {
                        discountAmount = discountValue;
                    }
                }
                discountAmount = Math.min(discountAmount, totals.subtotal);

                const taxable = Math.max(0, totals.subtotal - discountAmount);
                let cgst = 0,
                    sgst = 0,
                    igst = 0;
                if (gstMode === 'inter') {
                    // IGST is already included in totals, but we recalc based on taxable
                    const gstTotal = taxable * (H4DB.get('settings')?.defaultGst || 18) / 100;
                    igst = gstTotal;
                } else if (gstMode === 'intra') {
                    const gstTotal = taxable * (H4DB.get('settings')?.defaultGst || 18) / 100;
                    cgst = gstTotal / 2;
                    sgst = gstTotal / 2;
                }

                const total = taxable + cgst + sgst + igst;
                const rounded = Math.round(total);
                const roundOff = rounded - total;

                document.getElementById('epxSubtotal').textContent = totals.subtotal.toFixed(2);
                document.getElementById('epxDiscountAmt').textContent = discountAmount.toFixed(2);
                document.getElementById('epxTaxable').textContent = taxable.toFixed(2);
                document.getElementById('epxCgst').textContent = cgst.toFixed(2);
                document.getElementById('epxSgst').textContent = sgst.toFixed(2);
                document.getElementById('epxIgst').textContent = igst.toFixed(2);
                document.getElementById('epxRoundOff').textContent = roundOff.toFixed(2);
                document.getElementById('epxGrandTotal').textContent = rounded.toFixed(2);

                document.getElementById('epxCgstRow').style.display = (gstMode === 'intra') ? 'flex' : 'none';
                document.getElementById('epxSgstRow').style.display = (gstMode === 'intra') ? 'flex' : 'none';
                document.getElementById('epxIgstRow').style.display = (gstMode === 'inter') ? 'flex' : 'none';

                this.updatePreview();
                this.saveDraft();
            },

            // ----- COLLECT DATA -----
            collectData() {
                const cus = H4DB.get('customers') || {};
                const customer = cus[document.getElementById('epxCustomer')?.value] || {};
                return {
                    id: this.editingId || H4Utils.generateId('qtn'),
                    quotationType: 'premium-epoxy',
                    templateId: 'tpl_epoxy',
                    number: document.getElementById('epxNumber')?.value || '',
                    date: document.getElementById('epxDate')?.value || '',
                    validity: Number(document.getElementById('epxValidity')?.value) || 15,
                    customerId: document.getElementById('epxCustomer')?.value || '',
                    customerSnapshot: { ...customer },
                    customerPhone: document.getElementById('epxCustPhone')?.value || '',
                    customerWhatsapp: document.getElementById('epxCustWhatsapp')?.value || '',
                    customerEmail: document.getElementById('epxCustEmail')?.value || '',
                    projectName: document.getElementById('epxProjectName')?.value || '',
                    siteAddress: document.getElementById('epxSiteAddress')?.value || '',
                    reference: document.getElementById('epxReference')?.value || '',
                    projectDetails: {
                        projectName: document.getElementById('epxProjectName')?.value || '',
                        area: Number(document.getElementById('epxArea')?.value) || 0,
                        areaUnit: document.getElementById('epxAreaUnit')?.value || 'sq.ft',
                        flooringType: document.getElementById('epxFlooringType')?.value || '',
                        thickness: document.getElementById('epxThickness')?.value || '',
                        floorCondition: document.getElementById('epxFloorCondition')?.value || ''
                    },
                    workScope: JSON.parse(JSON.stringify(this.scopeItems)),
                    materialSpecification: {
                        brand: document.getElementById('epxBrand')?.value || 'H4',
                        productSystem: document.getElementById('epxProductSystem')?.value || '',
                        mixingRatio: document.getElementById('epxMixingRatio')?.value || '',
                        thickness: document.getElementById('epxMatThickness')?.value || '',
                        colourCode: document.getElementById('epxColourCode')?.value || '',
                        colourName: document.getElementById('epxColourName')?.value || '',
                        finish: document.getElementById('epxFinish')?.value || 'High Gloss',
                        antiSlip: document.getElementById('epxAntiSlip')?.value || 'Not Required'
                    },
                    pricing: {
                        items: JSON.parse(JSON.stringify(this.priceItems)),
                        discountEnabled: document.getElementById('epxDiscountEnabled')?.checked || false,
                        discount: Number(document.getElementById('epxDiscountValue')?.value) || 0,
                        discountType: document.getElementById('epxDiscountType')?.value || 'flat',
                        gstMode: document.getElementById('epxGstMode')?.value || 'intra'
                    },
                    timeline: {
                        workDuration: document.getElementById('epxWorkDuration')?.value || '',
                        curingTime: document.getElementById('epxCuringTime')?.value || ''
                    },
                    warranty: {
                        enabled: document.getElementById('epxWarrantyEnabled')?.checked || false,
                        period: document.getElementById('epxWarrantyPeriod')?.value || '5 Years',
                        terms: document.getElementById('epxWarrantyTerms')?.value || '',
                        conditions: document.getElementById('epxWarrantyConditions')?.value || ''
                    },
                    premiumFeatures: JSON.parse(JSON.stringify(this.featureItems)),
                    termsAndConditions: {
                        advancePayment: Number(document.getElementById('epxAdvancePayment')?.value) || 50,
                        balancePayment: document.getElementById('epxBalancePayment')?.value || '50% upon completion',
                        workSchedule: document.getElementById('epxWorkSchedule')?.value || 'As mutually agreed',
                        waterElectricityByClient: document.getElementById('epxWaterElectricity')?.value ||
                            'To be provided by client',
                        warrantyConditions: document.getElementById('epxWarrantyConditions')?.value || '',
                        surfaceConditionResponsibility: document.getElementById('epxSurfaceCondition')?.value ||
                            'Client to disclose existing substrate defects.',
                        accessToWorkArea: document.getElementById('epxAccessToSite')?.value ||
                            'Safe access to be provided by client.',
                        curingRestrictions: document.getElementById('epxCuringRestrictions')?.value ||
                            'Restrict traffic during curing.',
                        maintenanceRequirements: document.getElementById('epxMaintenance')?.value ||
                            'Follow recommended cleaning and maintenance.',
                        otherTerms: document.getElementById('epxOtherTerms')?.value || ''
                    },
                    footer: {
                        thankYou: document.getElementById('epxThankYou')?.value ||
                            'Thank you for considering H4 Construction Solutions.',
                        qrType: document.getElementById('epxQrType')?.value || 'website',
                        qrValue: document.getElementById('epxQrValue')?.value || '',
                        signatoryName: document.getElementById('epxSignatoryName')?.value || 'Authorized Signatory'
                    },
                    status: 'draft',
                    createdAt: new Date().toISOString(),
                    updatedAt: new Date().toISOString(),
                    companySnapshot: H4DB.get('company') || {}
                };
            },

            // ----- SAVE -----
            save() {
                const data = this.collectData();
                if (!data.customerId) { H4Notify.danger('Please select a customer.'); return; }
                if (!data.projectDetails.area || data.projectDetails.area <= 0) {
                    H4Notify.danger('Please enter area.');
                    return;
                }

                // Calculate final totals
                this.calculate();
                const data2 = this.collectData();

                if (this.editingId) {
                    H4DB.update('quotations', this.editingId, data2);
                    H4Notify.success('Quotation updated: ' + data2.number);
                } else {
                    H4DB.add('quotations', data2);
                    this.editingId = data2.id;
                    H4Notify.success('Quotation saved: ' + data2.number);
                }
                localStorage.removeItem(this.draftKey);
                document.getElementById('epxConvertBtn').style.display = 'inline-flex';
                H4App.loadQuotations();
            },

            // ----- PREVIEW -----
            updatePreview() {
                const container = document.getElementById('epoxyPreviewContainer');
                const data = this.collectData();
                const company = H4DB.get('company') || {};
                const customers = H4DB.get('customers') || {};
                const customer = customers[data.customerId] || {};
                const pd = data.projectDetails || {};
                const ms = data.materialSpecification || {};
                const pr = data.pricing || {};
                const tl = data.timeline || {};
                const wr = data.warranty || {};
                const tc = data.termsAndConditions || {};
                const ft = data.footer || {};

                // Calculate totals for preview
                const items = pr.items || [];
                const gstMode = pr.gstMode || 'intra';
                const totals = H4Calc.calculateTotals(items, gstMode);

                let discountAmount = 0;
                if (pr.discountEnabled) {
                    if (pr.discountType === 'percentage') {
                        discountAmount = totals.subtotal * (pr.discount || 0) / 100;
                    } else {
                        discountAmount = pr.discount || 0;
                    }
                }
                discountAmount = Math.min(discountAmount, totals.subtotal);
                const taxable = Math.max(0, totals.subtotal - discountAmount);
                let cgst = 0,
                    sgst = 0,
                    igst = 0;
                if (gstMode === 'inter') {
                    igst = taxable * (H4DB.get('settings')?.defaultGst || 18) / 100;
                } else if (gstMode === 'intra') {
                    const gst = taxable * (H4DB.get('settings')?.defaultGst || 18) / 100;
                    cgst = gst / 2;
                    sgst = gst / 2;
                }
                const grandTotal = Math.round(taxable + cgst + sgst + igst);

                const selectedScopes = this.scopeItems.filter(s => s.selected);
                const selectedFeatures = this.featureItems.filter(f => f.selected);

                const logoHtml = company.logo ? `<img src="${company.logo}" style="max-height:60px;max-width:120px;object-fit:contain;">` :
                    '';

                let itemsHtml = '';
                items.forEach((item, idx) => {
                    const total = (item.quantity || 0) * (item.rate || 0);
                    itemsHtml += `
                        <tr>
                            <td>${idx+1}</td>
                            <td>${H4Utils.escape(item.description)}</td>
                            <td>${H4Utils.escape(item.unit||'')}</td>
                            <td style="text-align:right">${Number(item.quantity||0).toFixed(2)}</td>
                            <td style="text-align:right">${H4Utils.formatCurrency(item.rate||0)}</td>
                            <td style="text-align:right">${H4Utils.formatCurrency(total)}</td>
                        </tr>
                    `;
                });

                container.innerHTML = `
                    <div class="preview-a4-page">
                        <div class="a4-cover">
                            <h1>PREMIUM EPOXY FLOORING PROPOSAL</h1>
                            <p>Luxury • Seamless • Durable • Premium Finish</p>
                        </div>

                        <div style="display:flex;justify-content:space-between;flex-wrap:wrap;margin-bottom:0.75rem;">
                            <div style="display:flex;align-items:center;gap:0.75rem;">
                                ${logoHtml}
                                <div><strong>${H4Utils.escape(company.legalName||'H4 Construction Solutions')}</strong></div>
                            </div>
                            <div style="text-align:right;font-size:0.85rem;">
                                <div><strong>${H4Utils.escape(data.number)}</strong></div>
                                <div>${data.date ? new Date(data.date).toLocaleDateString('en-IN') : ''}</div>
                            </div>
                        </div>

                        <div class="spec-grid" style="margin-top:0.75rem;">
                            <div><strong>Customer</strong> ${H4Utils.escape(customer.name||'-')}</div>
                            <div><strong>Project</strong> ${H4Utils.escape(pd.projectName||'-')}</div>
                            <div><strong>Phone</strong> ${H4Utils.escape(customer.phone||'-')}</div>
                            <div><strong>Site Address</strong> ${H4Utils.escape(data.siteAddress||'-')}</div>
                            <div><strong>Area</strong> ${pd.area || 0} ${pd.areaUnit || 'sq.ft'}</div>
                            <div><strong>Validity</strong> ${data.validity || 15} Days</div>
                        </div>

                        <div class="a4-section-title">Project Specification</div>
                        <div class="spec-grid">
                            <div><strong>Flooring Type</strong> ${H4Utils.escape(pd.flooringType||'-')}</div>
                            <div><strong>Thickness</strong> ${H4Utils.escape(pd.thickness||'-')}</div>
                            <div><strong>Floor Condition</strong> ${H4Utils.escape(pd.floorCondition||'-')}</div>
                            <div><strong>Reference</strong> ${H4Utils.escape(data.reference||'-')}</div>
                        </div>

                        <div class="a4-section-title">Work Scope</div>
                        <ul class="scope-list-preview">${selectedScopes.map(s => `<li>${H4Utils.escape(s.name)}</li>`).join('') || '<li>No scope selected</li>'}</ul>

                        <div class="a4-section-title">Material Specification</div>
                        <div class="spec-grid">
                            <div><strong>Brand</strong> ${H4Utils.escape(ms.brand||'-')}</div>
                            <div><strong>Product / System</strong> ${H4Utils.escape(ms.productSystem||'-')}</div>
                            <div><strong>Mixing Ratio</strong> ${H4Utils.escape(ms.mixingRatio||'-')}</div>
                            <div><strong>Thickness</strong> ${H4Utils.escape(ms.thickness||'-')}</div>
                            <div><strong>Colour</strong> ${H4Utils.escape(ms.colourName||'')} ${H4Utils.escape(ms.colourCode||'')}</div>
                            <div><strong>Finish</strong> ${H4Utils.escape(ms.finish||'-')}</div>
                            <div><strong>Anti-slip</strong> ${H4Utils.escape(ms.antiSlip||'-')}</div>
                        </div>

                        <div class="a4-section-title">Price Table</div>
                        <table class="p-table">
                            <thead><tr><th>#</th><th>Description</th><th>Unit</th><th style="text-align:right">Qty</th><th style="text-align:right">Rate</th><th style="text-align:right">Amount</th></tr></thead>
                            <tbody>${itemsHtml || '<tr><td colspan="6" style="text-align:center;color:var(--text-secondary);">No items added</td></tr>'}</tbody>
                        </table>

                        <div class="p-total" style="margin-top:0.75rem;">
                            <div><span>Subtotal</span><span>${H4Utils.formatCurrency(totals.subtotal)}</span></div>
                            ${pr.discountEnabled ? `<div><span>Discount</span><span>${H4Utils.formatCurrency(discountAmount)}</span></div>` : ''}
                            <div><span>Taxable Amount</span><span>${H4Utils.formatCurrency(taxable)}</span></div>
                            ${gstMode === 'intra' ? `<div><span>CGST</span><span>${H4Utils.formatCurrency(cgst)}</span></div><div><span>SGST</span><span>${H4Utils.formatCurrency(sgst)}</span></div>` : ''}
                            ${gstMode === 'inter' ? `<div><span>IGST</span><span>${H4Utils.formatCurrency(igst)}</span></div>` : ''}
                            <div><span>Round Off</span><span>${H4Utils.formatCurrency(grandTotal - (taxable+cgst+sgst+igst))}</span></div>
                            <div class="p-grand"><span>GRAND TOTAL</span><span>${H4Utils.formatCurrency(grandTotal)}</span></div>
                        </div>

                        <div class="a4-section-title">Timeline</div>
                        <div class="spec-grid">
                            <div><strong>Work Duration</strong> ${H4Utils.escape(tl.workDuration||'-')}</div>
                            <div><strong>Curing Time</strong> ${H4Utils.escape(tl.curingTime||'-')}</div>
                        </div>

                        ${wr.enabled ? `
                        <div class="a4-section-title">Warranty</div>
                        <div class="warranty-badge">${H4Utils.escape(wr.period||'5 Years')}</div>
                        <div style="font-size:0.9rem;">${H4Utils.escape(wr.terms||'')}</div>
                        ` : ''}

                        <div class="a4-section-title">Premium Features</div>
                        <ul class="feature-list-preview">${selectedFeatures.map(f => `<li>${H4Utils.escape(f.name)}</li>`).join('') || '<li>No features selected</li>'}</ul>

                        <div class="a4-section-title">Terms & Conditions</div>
                        <div style="font-size:0.85rem;">
                            <div><strong>Advance:</strong> ${tc.advancePayment || 50}%</div>
                            <div><strong>Balance:</strong> ${H4Utils.escape(tc.balancePayment||'-')}</div>
                            <div><strong>Work Schedule:</strong> ${H4Utils.escape(tc.workSchedule||'-')}</div>
                            <div><strong>Water & Electricity:</strong> ${H4Utils.escape(tc.waterElectricityByClient||'-')}</div>
                            <div><strong>Surface Responsibility:</strong> ${H4Utils.escape(tc.surfaceConditionResponsibility||'-')}</div>
                            <div><strong>Access:</strong> ${H4Utils.escape(tc.accessToWorkArea||'-')}</div>
                            <div><strong>Curing:</strong> ${H4Utils.escape(tc.curingRestrictions||'-')}</div>
                            <div><strong>Maintenance:</strong> ${H4Utils.escape(tc.maintenanceRequirements||'-')}</div>
                            ${tc.otherTerms ? `<div><strong>Other:</strong> ${H4Utils.escape(tc.otherTerms||'-')}</div>` : ''}
                        </div>

                        <div style="margin-top:1.5rem;padding-top:1rem;border-top:2px solid var(--primary);display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:0.75rem;">
                            <div>
                                <div style="font-weight:600;">${H4Utils.escape(ft.thankYou||'Thank you for considering H4 Construction Solutions.')}</div>
                                <div class="signature-box" style="margin-top:0.5rem;"></div>
                                <div style="font-size:0.85rem;">${H4Utils.escape(ft.signatoryName||'Authorized Signatory')}</div>
                                <div style="font-size:0.75rem;color:var(--text-secondary);">Authorized Signatory</div>
                            </div>
                            <div style="text-align:center;">
                                <div class="qr-box-small">QR<br>Code</div>
                                <div style="font-size:0.6rem;color:var(--text-secondary);">${H4Utils.escape(ft.qrType||'website')}</div>
                            </div>
                        </div>
                    </div>
                `;
            },

            togglePreviewMobile() {
                document.getElementById('epoxyPreviewPane')?.classList.toggle('mobile-show');
            },

            // ----- PRINT -----
            printPreview() {
                const container = document.getElementById('epoxyPreviewContainer');
                const html = container.innerHTML;
                const win = window.open('', '_blank');
                if (!win) { H4Notify.danger('Please allow popups.'); return; }
                win.document.write(`
                    <html><head><title>Epoxy Proposal</title>
                    <style>
                        body { font-family: Arial, sans-serif; margin: 0; padding: 20px; background: #f5f5f5; }
                        .preview-a4-page { max-width: 794px; margin: 0 auto 16px; background: white; padding: 32px 28px; border-radius: 8px; box-shadow: 0 4px 24px rgba(0,0,0,0.06); }
                        .a4-cover { background: linear-gradient(135deg, #6A3FA0, #8A6510); color: white; padding: 2rem 1.25rem; border-radius: 8px; margin-bottom: 1rem; text-align:center; }
                        .a4-cover h1 { font-size:1.4rem; }
                        .a4-section-title { color: #6A3FA0; font-size:1rem; font-weight:700; margin:1.25rem 0 0.6rem; padding-bottom:0.35rem; border-bottom:2px solid #6A3FA0; }
                        .spec-grid { display:grid; grid-template-columns:1fr 1fr; gap:0.5rem 1.5rem; font-size:0.9rem; }
                        .spec-grid div strong { display:block; color: #757575; font-size:0.75rem; text-transform:uppercase; }
                        .p-table { width:100%; border-collapse:collapse; font-size:0.85rem; }
                        .p-table th { background:#6A3FA0; color:white; padding:8px; text-align:left; }
                        .p-table td { padding:8px; border-bottom:1px solid #E0E0E0; }
                        .p-total { margin-left:auto; width:55%; font-size:0.9rem; }
                        .p-total div { display:flex; justify-content:space-between; padding:4px 0; border-bottom:1px solid #E0E0E0; }
                        .p-total .p-grand { font-size:1.1rem; font-weight:800; border-top:2px solid #6A3FA0; padding-top:8px; margin-top:4px; }
                        .warranty-badge { display:inline-block; background:#8A6510; color:white; padding:0.5rem 1rem; border-radius:8px; font-weight:700; }
                        .scope-list-preview, .feature-list-preview { list-style:none; }
                        .scope-list-preview li::before { content:"✓ "; color:#4CAF50; font-weight:700; }
                        .feature-list-preview li::before { content:"★ "; color:#8A6510; }
                        .signature-box { height:60px; border-bottom:1px solid #777; margin-top:8px; }
                        .qr-box-small { width:80px; height:80px; border:1px solid #E0E0E0; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:0.6rem; color:#757575; text-align:center; margin:0 auto; }
                        @media print { body { padding:0; background:white; } .preview-a4-page { box-shadow:none; border-radius:0; } }
                    </style>
                    </head><body>${html}<script>window.onload=function(){window.print();};<\/script></body></html>
                `);
                win.document.close();
            },

            // ----- CONVERT TO INVOICE -----
            convertToInvoice() {
                if (!this.editingId) { H4Notify.danger('Save the quotation first.'); return; }
                const q = H4DB.get('quotations')[this.editingId];
                if (!q) { H4Notify.danger('Quotation not found.'); return; }
                if (q.status === 'converted') { H4Notify.danger('Already converted.'); return; }

                const inv = {
                    id: H4Utils.generateId('inv'),
                    number: H4Numbering.getNextInvoiceNumber(),
                    date: H4Utils.today(),
                    dueDate: '',
                    customerId: q.customerId,
                    projectName: q.projectDetails?.projectName || '',
                    reference: q.number,
                    quotationId: q.id,
                    quotationNumber: q.number,
                    items: (q.pricing?.items || []).map(p => ({ ...p, historicalRate: true })),
                    paidAmount: 0,
                    paymentStatus: 'unpaid',
                    notes: '',
                    status: 'unpaid',
                    createdAt: new Date().toISOString(),
                    updatedAt: new Date().toISOString()
                };
                H4DB.add('invoices', inv);
                H4DB.update('quotations', q.id, { status: 'converted' });
                H4Notify.success('Converted to Invoice: ' + inv.number);
                document.getElementById('epxConvertBtn').style.display = 'none';
                H4App.loadInvoices();
            },

            // ----- RATE MASTER UI -----
            loadRateMaster() {
                const rates = H4DB.get('rateMaster') || {};
                const tbody = document.getElementById('rateMasterBody');
                const list = Object.values(rates);
                if (list.length === 0) {
                    tbody.innerHTML =
                        '<tr><td colspan="7" style="text-align:center;padding:2rem;color:var(--text-secondary);">No rates configured</td></tr>';
                    return;
                }
                tbody.innerHTML = list.map(r => `
                    <tr>
                        <td>${H4Utils.escape(r.flooringType)}</td>
                        <td>${H4Utils.escape(r.thickness)}</td>
                        <td>${H4Utils.escape(r.unit)}</td>
                        <td>${H4Utils.formatCurrency(r.rate)}</td>
                        <td>${r.gst}%</td>
                        <td>${r.active !== false ? '✅ Active' : '⛔ Inactive'}</td>
                        <td>
                            <button class="btn btn-sm btn-danger" onclick="H4Epoxy.deleteRate('${r.id}')">🗑️</button>
                            <button class="btn btn-sm btn-outline" onclick="H4Epoxy.toggleRate('${r.id}')">${r.active !== false ? 'Deactivate' : 'Activate'}</button>
                        </td>
                    </tr>
                `).join('');
            },

            openAddRateModal() {
                this.populateMasterDropdowns();
                document.getElementById('addRateForm').reset();
                document.getElementById('addRateModalTitle').textContent = 'Add Rate';
                document.getElementById('addRateForm').dataset.rateId = '';
                document.getElementById('arActive').checked = true;
                H4App.openModal('addRateModal');
            },

            saveRate() {
                const form = document.getElementById('addRateForm');
                const id = form.dataset.rateId || H4Utils.generateId('rate');
                const data = {
                    id,
                    flooringType: document.getElementById('arFlooringType').value,
                    thickness: document.getElementById('arThickness').value,
                    unit: document.getElementById('arUnit').value,
                    rate: Number(document.getElementById('arRate').value) || 0,
                    gst: Number(document.getElementById('arGst').value) || 0,
                    active: document.getElementById('arActive').checked
                };
                if (!data.flooringType || !data.thickness || !data.unit || !data.rate) {
                    H4Notify.danger('All fields are required.');
                    return;
                }
                H4DB.add('rateMaster', data);
                H4App.closeModal('addRateModal');
                this.loadRateMaster();
                this.populateMasterDropdowns();
                H4Notify.success('Rate saved.');
            },

            editRate(id) {
                const rates = H4DB.get('rateMaster');
                const r = rates[id];
                if (!r) return;
                this.populateMasterDropdowns();
                document.getElementById('arFlooringType').value = r.flooringType;
                document.getElementById('arThickness').value = r.thickness;
                document.getElementById('arUnit').value = r.unit;
                document.getElementById('arRate').value = r.rate;
                document.getElementById('arGst').value = r.gst;
                document.getElementById('arActive').checked = r.active !== false;
                document.getElementById('addRateForm').dataset.rateId = id;
                document.getElementById('addRateModalTitle').textContent = 'Edit Rate';
                H4App.openModal('addRateModal');
            },

            deleteRate(id) {
                if (!confirm('Delete this rate?')) return;
                H4DB.delete('rateMaster', id);
                this.loadRateMaster();
                this.populateMasterDropdowns();
                H4Notify.success('Rate deleted.');
            },

            toggleRate(id) {
                const rates = H4DB.get('rateMaster');
                const r = rates[id];
                if (!r) return;
                r.active = !r.active;
                H4DB.add('rateMaster', r);
                this.loadRateMaster();
                this.populateMasterDropdowns();
            }
        };

        // ==================== INIT ====================
        document.addEventListener('DOMContentLoaded', () => {
            H4App.init();

            document.addEventListener('click', (e) => {
                const sidebar = document.getElementById('sidebar');
                const toggle = document.getElementById('menuToggle');
                if (window.innerWidth <= 768 && sidebar.classList.contains('active')) {
                    if (!sidebar.contains(e.target) && e.target !== toggle) {
                        sidebar.classList.remove('active');
                    }
                }
            });

            document.querySelectorAll('.modal-overlay').forEach(overlay => {
                overlay.addEventListener('click', function(e) {
                    if (e.target === this) this.classList.remove('active');
                });
            });

            console.log('H4 Billing ERP - Premium Epoxy Builder loaded.');
        });
    </script>
</body>
</html>