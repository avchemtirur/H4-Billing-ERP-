                const overlay = document.getElementById('epoxyOverlay');
                if (!overlay) { H4Notify.danger('Epoxy builder not available.'); return; }
                this.editingId = null;
                this.initData();
                this.populateMasterDropdowns();
                this.generateNumber();
                this.renderSteps();
                this.renderStep();
                this.onSystemChange();
                this.calculate();
                document.getElementById('epxConvertBtn').style.display = 'none';
                overlay.classList.add('active');
                this.loadDraft();
                H4Notify.success('Epoxy Proposal Builder opened.');
            },

            edit(id) {
                const q = H4DB.get('quotations')[id];
                if (!q) { H4Notify.danger('Quotation not found.'); return; }
                this.editingId = id;
                this.loadData(q);
                this.populateMasterDropdowns();
                this.renderSteps();
                this.renderStep();
                this.onSystemChange();
                this.calculate();
                document.getElementById('epxConvertBtn').style.display = 'inline-flex';
                document.getElementById('epoxyOverlay').classList.add('active');
                H4Notify.success('Editing epoxy quotation.');
            },

            close() {
                if (this.hasChanges()) {
                    if (!confirm('Unsaved changes. Close anyway?')) return;
                }
                document.getElementById('epoxyOverlay').classList.remove('active');
                localStorage.removeItem(this.draftKey);
                H4App.loadQuotations();
            },

            initData() {
                const defaults = H4DB.get('workScopeDefaults') || [];
                this.scopeItems = defaults.map(s => ({ id: H4Utils.generateId('scope'), name: s, selected: true,
                    description: s }));
                const features = H4DB.get('premiumFeatureDefaults') || [];
                this.featureItems = features.map(f => ({ id: H4Utils.generateId('feat'), name: f, selected: true }));
                this.priceItems = [];
                this.isManualRate = false;
                this.clearFields();
            },

