                });

                ['gstEnabled', 'panEnabled', 'bankEnabled'].forEach(id => {
                    document.getElementById(id).addEventListener('change', (e) => {
                        document.getElementById(id.replace('Enabled', 'Fields')).style.display = e.target
                            .checked ? 'block' : 'none';
                    });
                });

                document.getElementById('logoUpload').addEventListener('change', async (e) => {
                    const file = e.target.files[0];
                    if (file) {
                        const base64 = await H4Utils.fileToBase64(file);
                        document.getElementById('logoImage').src = base64;
                        document.getElementById('logoPreview').style.display = 'block';
                    }
                });

                document.getElementById('signatureUpload').addEventListener('change', async (e) => {
