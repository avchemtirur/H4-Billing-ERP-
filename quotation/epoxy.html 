        // ==================== H4 DATABASE ====================
        const H4DB = {
            STORAGE_KEY: 'h4_billing_erp_v3',

            init() {
                if (!localStorage.getItem(this.STORAGE_KEY)) {
                    this.reset();
                }
            },

            reset() {
                localStorage.setItem(this.STORAGE_KEY, JSON.stringify(defaultData));
            },

            get(key) {
                const data = JSON.parse(localStorage.getItem(this.STORAGE_KEY) || '{}');
                return key ? data[key] : data;
            },

            save(key, value) {
                const data = this.get();
                data[key] = value;
                localStorage.setItem(this.STORAGE_KEY, JSON.stringify(data));
            },

            add(category, item) {
                const data = this.get(category) || {};
                data[item.id] = item;
                this.save(category, data);
                return item;
            },

            update(category, id, updates) {
                const data = this.get(category) || {};
                if (data[id]) {
                    data[id] = { ...data[id], ...updates };
                    this.save(category, data);
                    return data[id];
                }
                return null;
            },

            delete(category, id) {
                const data = this.get(category) || {};
                delete data[id];
                this.save(category, data);
            },

            export() {
                return JSON.stringify(this.get(), null, 2);
            },

            import(data) {
                localStorage.setItem(this.STORAGE_KEY, JSON.stringify(data));
            }
        };

        // ==================== UTILITIES ====================
        const H4Utils = {
            generateId(prefix) {
                return prefix + '_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
            },

            formatCurrency(value) {
                return new Intl.NumberFormat('en-IN', {
                    style: 'currency',
                    currency: 'INR'
                }).format(value);
            },

            formatDate(date) {
                return new Date(date).toLocaleDateString('en-IN');
            },

            fileToBase64(file) {
                return new Promise((resolve, reject) => {
                    const reader = new FileReader();
                    reader.onload = () => resolve(reader.result);
                    reader.onerror = reject;
                    reader.readAsDataURL(file);
                });
            },

            today() {
                return new Date().toISOString().split('T')[0];
            },

            escape(value) {
                if (value == null) return '';
                return String(value)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }
        };

        // ==================== NOTIFICATIONS ====================
        const H4Notify = {
            show(message, type) {
                const container = document.getElementById('notifications');
                const div = document.createElement('div');
                div.className = 'notification ' + (type || 'success');
                div.textContent = message;
                container.appendChild(div);
                setTimeout(() => div.remove(), 3000);
            },
            success(msg) { this.show(msg, 'success'); },
            danger(msg) { this.show(msg, 'danger'); }
        };

        // ==================== CALCULATION ENGINE ====================
        const H4Calc = {
            calculateLine(quantity, rate, discount, discountType) {
                const qty = Number(quantity) || 0;
                const rt = Number(rate) || 0;
                const sub = qty * rt;
                let discAmt = 0;
                if (discountType === 'percentage') {
                    discAmt = sub * (Number(discount) || 0) / 100;
                } else {
                    discAmt = Number(discount) || 0;
                }
                discAmt = Math.min(discAmt, sub);
                const taxable = sub - discAmt;
                return { subtotal: sub, discountAmount: discAmt, taxable: Math.max(0, taxable) };
            },

            calculateTotals(items, gstMode) {
                let subtotal = 0;
                let totalDiscount = 0;
                let taxableAmount = 0;
                let cgst = 0,
                    sgst = 0,
                    igst = 0;

                (items || []).forEach(item => {
                    const line = this.calculateLine(item.quantity, item.rate, item.discount, item.discountType ||
                    'flat');
                    subtotal += line.subtotal;
                    totalDiscount += line.discountAmount;
                    taxableAmount += line.taxable;
                    const gstRate = Number(item.gst) || 0;
                    if (gstMode === 'inter') {
                        igst += line.taxable * gstRate / 100;
                    } else if (gstMode === 'intra') {
                        cgst += line.taxable * gstRate / 200;
                        sgst += line.taxable * gstRate / 200;
                    }
                });

                const tax = cgst + sgst + igst;
                const beforeRound = taxableAmount + tax;
                const rounded = Math.round(beforeRound);
                const roundOff = rounded - beforeRound;

                return {
                    subtotal,
                    totalDiscount,
                    taxableAmount,
                    cgst,
                    sgst,
                    igst,
                    tax,
                    roundOff,
                    grandTotal: rounded
                };
            }
        };

        // ==================== NUMBERING ENGINE ====================
        const H4Numbering = {
            getNextQuotationNumber() {
                const settings = H4DB.get('settings');
                const counter = settings.quotationCounter || 1;
                const prefix = settings.quotationPrefix || 'H4-QTN';
                const year = settings.quotationYear || new Date().getFullYear();
                const number = String(counter).padStart(5, '0');
                settings.quotationCounter = counter + 1;
                H4DB.save('settings', settings);
                return prefix + '-' + year + '-' + number;
            },

            getNextInvoiceNumber() {
                const settings = H4DB.get('settings');
                const counter = settings.invoiceCounter || 1;
                const prefix = settings.invoicePrefix || 'H4-INV';
                const year = settings.invoiceYear || new Date().getFullYear();
                const number = String(counter).padStart(5, '0');
                settings.invoiceCounter = counter + 1;
                H4DB.save('settings', settings);
                return prefix + '-' + year + '-' + number;
            }
        };

