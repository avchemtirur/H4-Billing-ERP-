<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>H4 Billing ERP - Premium Epoxy Builder</title>
    <style>
        /* ==================== GLOBAL ==================== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #6A3FA0;
            --secondary: #8A6510;
            --accent: #00BCD4;
            --success: #4CAF50;
            --danger: #F44336;
            --warning: #FF9800;
            --bg: #F5F5F5;
            --surface: #FFFFFF;
            --text-primary: #212121;
            --text-secondary: #757575;
            --border: #E0E0E0;
            --shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 8px 16px rgba(0, 0, 0, 0.15);
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: var(--bg);
            color: var(--text-primary);
            line-height: 1.5;
            padding-bottom: 80px;
        }

        /* ==================== HEADER ==================== */
        .app-header {
            background: linear-gradient(135deg, var(--accent) 0%, var(--primary) 100%);
            color: white;
            padding: 1rem;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: var(--shadow);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .menu-toggle {
            background: rgba(255, 255, 255, 0.2);
            border: none;
            color: white;
            font-size: 1.5rem;
            cursor: pointer;
            padding: 0.5rem;
            border-radius: 8px;
        }

        .app-title {
            font-size: 1rem;
            font-weight: 600;
        }

        /* ==================== SIDEBAR ==================== */
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            height: 100vh;
            width: 260px;
            background: var(--surface);
            box-shadow: var(--shadow-lg);
            overflow-y: auto;
            z-index: 99;
            transform: translateX(-100%);
            transition: transform 0.3s ease;
        }

        .sidebar.active {
            transform: translateX(0);
        }

        .sidebar-header {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            padding: 1.5rem;
            font-weight: 600;
            font-size: 1.1rem;
        }

        .sidebar-menu {
            list-style: none;
            padding: 0.5rem 0;
        }

        .sidebar-title {
            padding: 1rem 1rem 0.5rem;
            font-size: 0.75rem;
            text-transform: uppercase;
            color: var(--text-secondary);
            font-weight: 600;
        }

        .sidebar-item {
            padding: 0.75rem 1rem;
            cursor: pointer;
            transition: all 0.2s ease;
            border-left: 4px solid transparent;
            color: var(--text-primary);
        }

        .sidebar-item:hover,
        .sidebar-item.active {
            background: var(--bg);
            border-left-color: var(--primary);
            color: var(--primary);
            font-weight: 500;
        }

        /* ==================== MAIN CONTENT ==================== */
        .main-content {
            padding: 1.5rem;
            max-width: 1400px;
            margin: 0 auto;
        }

        .page-header {
            background: linear-gradient(135deg, var(--accent), var(--primary));
            color: white;
            padding: 2rem;
            border-radius: 12px;
            margin-bottom: 2rem;
        }

        .page-header h1 {
            font-size: 2rem;
            margin-bottom: 0.5rem;
        }

        .page-header p {
            font-size: 0.95rem;
            opacity: 0.9;
        }

        /* ==================== CARDS ==================== */
        .card {
            background: var(--surface);
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: var(--shadow);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid var(--border);
        }

        .card-header h2 {
            font-size: 1.25rem;
            color: var(--primary);
        }

        /* ==================== FORMS ==================== */
        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            font-weight: 500;
            margin-bottom: 0.5rem;
            color: var(--text-primary);
        }

        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 0.95rem;
            font-family: inherit;
            transition: border-color 0.2s ease;
            background: white;
        }

        .form-group input:focus,
        .form-group textarea:focus,
        .form-group select:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(106, 63, 160, 0.1);
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .form-row-3 {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
        }

        /* ==================== BUTTONS ==================== */
        .btn {
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 8px;
            font-size: 0.95rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .btn-secondary {
            background: var(--accent);
            color: white;
        }

        .btn-danger {
            background: var(--danger);
            color: white;
        }

        .btn-success {
            background: var(--success);
            color: white;
        }

        .btn-outline {
            background: transparent;
            border: 2px solid var(--primary);
            color: var(--primary);
        }

        .btn-sm {
            padding: 0.5rem 1rem;
            font-size: 0.85rem;
        }

        .btn-block {
            width: 100%;
        }

        /* ==================== TABLES ==================== */
        .table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.95rem;
        }

        .table thead {
            background: var(--primary);
            color: white;
        }

        .table th {
            padding: 1rem;
            text-align: left;
            font-weight: 600;
        }

        .table td {
            padding: 1rem;
            border-bottom: 1px solid var(--border);
        }

        .table tbody tr:hover {
            background: var(--bg);
        }

        .table-actions {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        /* ==================== ITEMS TABLE ==================== */
        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 1rem;
            font-size: 0.9rem;
        }

        .items-table th {
            background: var(--primary);
            color: white;
            padding: 0.75rem;
            text-align: left;
            font-weight: 600;
        }

        .items-table td {
            padding: 0.75rem;
            border-bottom: 1px solid var(--border);
        }

        .items-table input,
        .items-table select {
            width: 100%;
            padding: 0.5rem;
            border: 1px solid var(--border);
            border-radius: 4px;
            font-size: 0.9rem;
            background: white;
        }

        .items-table input:focus,
        .items-table select:focus {
            outline: none;
            border-color: var(--primary);
        }

        /* ==================== CALCULATION BOX ==================== */
        .calc-box {
            background: var(--bg);
            padding: 1.5rem;
            border-radius: 8px;
            border-left: 4px solid var(--primary);
        }

        .calc-row {
            display: flex;
            justify-content: space-between;
            padding: 0.5rem 0;
            border-bottom: 1px solid var(--border);
        }

        .calc-row.total {
            font-weight: 600;
            font-size: 1.1rem;
            border-bottom: 2px solid var(--primary);
            padding: 1rem 0;
            color: var(--primary);
        }

        .calc-label {
            color: var(--text-secondary);
        }

        .calc-value {
            font-weight: 600;
            text-align: right;
        }

        /* ==================== STATUS BADGE ==================== */
        .status-badge {
            display: inline-block;
            padding: 0.35rem 0.75rem;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-draft {
            background: #E3F2FD;
            color: #1976D2;
        }
        .status-sent {
            background: #FFF3E0;
            color: #F57C00;
        }
        .status-accepted {
            background: #E8F5E9;
            color: #388E3C;
        }
        .status-rejected {
            background: #FFEBEE;
            color: #D32F2F;
        }
        .status-expired {
            background: #F3E5F5;
            color: #7B1FA2;
        }
        .status-converted {
            background: #E0F2F1;
            color: #00897B;
        }
        .status-unpaid {
            background: #FFEBEE;
            color: #D32F2F;
        }
        .status-partially-paid {
            background: #FFF3E0;
            color: #F57C00;
        }
        .status-paid {
            background: #E8F5E9;
            color: #388E3C;
        }

        /* ==================== MODALS ==================== */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            padding: 1rem;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal-content {
            background: var(--surface);
            border-radius: 12px;
            max-width: 700px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: var(--shadow-lg);
        }

        .modal-header {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            padding: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-radius: 12px 12px 0 0;
        }

        .modal-header h3 {
            font-size: 1.25rem;
        }

        .modal-close {
            background: none;
            border: none;
            color: white;
            font-size: 1.5rem;
            cursor: pointer;
        }

        .modal-body {
            padding: 2rem;
        }

        .modal-footer {
            padding: 1rem 2rem;
            border-top: 1px solid var(--border);
            display: flex;
            gap: 0.75rem;
            justify-content: flex-end;
        }

        /* ==================== NOTIFICATIONS ==================== */
        .notifications {
            position: fixed;
            top: 1rem;
            right: 1rem;
            z-index: 2000;
            max-width: 400px;
        }

        .notification {
            background: white;
            border-left: 4px solid var(--primary);
            padding: 1rem;
            margin-bottom: 0.75rem;
            border-radius: 8px;
            box-shadow: var(--shadow-lg);
            animation: slideIn 0.3s ease;
        }

        .notification.success {
            border-left-color: var(--success);
        }

        .notification.danger {
            border-left-color: var(--danger);
        }

        @keyframes slideIn {
            from {
                transform: translateX(400px);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        /* ==================== MODULES ==================== */
        .module {
            display: none;
        }

        .module.active {
            display: block;
        }

        /* ==================== PREVIEW ==================== */
        .preview-section {
            background: white;
            border: 2px dashed var(--border);
            border-radius: 12px;
            padding: 2rem;
            margin-top: 2rem;
        }

        .preview-header {
            text-align: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid var(--border);
        }

        .document-title {
            font-size: 2rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 0.5rem;
        }

        .document-number {
            font-size: 1.1rem;
            color: var(--text-secondary);
            margin-bottom: 1rem;
        }

        .preview-info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-bottom: 2rem;
            padding-bottom: 2rem;
            border-bottom: 1px solid var(--border);
        }

        .preview-items {
            margin-bottom: 2rem;
        }

        .preview-items table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
        }

        .preview-items th {
            background: var(--primary);
            color: white;
            padding: 0.75rem;
            text-align: left;
        }

        .preview-items td {
            padding: 0.75rem;
            border-bottom: 1px solid var(--border);
        }

        .preview-totals {
            display: flex;
            justify-content: flex-end;
            margin-top: 2rem;
        }

        .preview-totals-box {
            min-width: 300px;
        }

        /* ==================== DASHBOARD STATS ==================== */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: white;
            padding: 1.5rem;
            border-radius: 12px;
            box-shadow: var(--shadow);
            text-align: center;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 0.5rem;
        }

        .stat-label {
            font-size: 0.95rem;
            color: var(--text-secondary);
        }

        /* ==================== IMAGE UPLOAD PREVIEW ==================== */
        .image-preview {
            width: 100px;
            height: 100px;
            border: 2px dashed var(--border);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: var(--bg);
        }

        .image-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* ==================== RESPONSIVE ==================== */
        @media (max-width: 768px) {
            .sidebar {
                width: 100%;
                height: auto;
                max-height: 60vh;
                bottom: 0;
                left: 0;
                top: auto;
                transform: translateY(100%);
            }

            .sidebar.active {
                transform: translateY(0);
            }

            .form-row,
            .form-row-3 {
                grid-template-columns: 1fr;
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .table {
                font-size: 0.85rem;
            }

            .table th,
            .table td {
                padding: 0.5rem;
            }

            .modal-content {
                border-radius: 12px 12px 0 0;
                max-height: 80vh;
            }

            .main-content {
                padding: 1rem;
            }

            .items-table {
                font-size: 0.8rem;
            }

            .items-table th,
            .items-table td {
                padding: 0.5rem;
            }
        }

        /* ==================== BOTTOM NAVIGATION ==================== */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: white;
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: space-around;
            z-index: 999;
            box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.08);
        }

        .nav-item {
            flex: 1;
            padding: 0.75rem;
            text-align: center;
            cursor: pointer;
            color: var(--text-secondary);
            transition: color 0.2s ease;
            font-size: 0.75rem;
        }

        .nav-item.active {
            color: var(--primary);
            font-weight: 600;
        }

        .nav-icon {
            font-size: 1.5rem;
            display: block;
            margin-bottom: 0.25rem;
        }

        /* ==================== EPOXY BUILDER OVERLAY ==================== */
        .epoxy-overlay {
            position: fixed;
            inset: 0;
            background: var(--bg);
            z-index: 3000;
            display: none;
            flex-direction: column;
        }

        .epoxy-overlay.active {
            display: flex;
        }

        .epoxy-topbar {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            padding: 0.75rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.5rem;
            flex-wrap: wrap;
            flex-shrink: 0;
        }

        .epoxy-topbar-title {
            font-weight: 700;
            font-size: 1rem;
        }

        .epoxy-topbar-actions {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .epoxy-topbar-actions .btn {
            min-height: 36px;
            padding: 0.4rem 0.8rem;
            font-size: 0.8rem;
        }

        .epoxy-steps {
            display: flex;
            overflow-x: auto;
            gap: 0.25rem;
            padding: 0.5rem 0.75rem;
            background: white;
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
            -webkit-overflow-scrolling: touch;
        }

        .epoxy-step-chip {
            flex: none;
            padding: 0.35rem 0.7rem;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
            background: var(--bg);
            color: var(--text-secondary);
            cursor: pointer;
            white-space: nowrap;
            border: 1px solid var(--border);
        }

        .epoxy-step-chip.active {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        .epoxy-step-chip.done {
            background: #E8F5E9;
            color: var(--success);
            border-color: var(--success);
        }

        .epoxy-body {
            flex: 1;
            overflow-y: auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.75rem;
            padding: 0.75rem;
        }

        .epoxy-form-pane {
            overflow-y: auto;
            padding-right: 0.25rem;
        }

        .epoxy-preview-pane {
            overflow-y: auto;
            background: #e8e4ee;
            border-radius: 12px;
            padding: 1rem;
            border: 1px solid var(--border);
        }

        .epoxy-step-section {
            display: none;
        }

        .epoxy-step-section.active {
            display: block;
        }

        .epoxy-bottombar {
            background: white;
            border-top: 1px solid var(--border);
            padding: 0.65rem 1rem;
            display: flex;
            justify-content: space-between;
            gap: 0.75rem;
            flex-shrink: 0;
        }

        .scope-item,
        .feature-item {
            display: flex;
            align-items: flex-start;
            gap: 0.6rem;
            padding: 0.5rem 0;
            border-bottom: 1px solid var(--border);
        }

        .scope-item input[type="checkbox"],
        .feature-item input[type="checkbox"] {
            margin-top: 0.35rem;
            width: 18px;
            height: 18px;
            flex: none;
        }

        .scope-item input[type="text"],
        .feature-item input[type="text"] {
            flex: 1;
        }

        .rate-status {
            padding: 0.6rem 0.85rem;
            border-radius: 8px;
            font-size: 0.85rem;
            margin-top: 0.35rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .rate-status.auto {
            background: #E8F5E9;
            color: #2E7D32;
        }

        .rate-status.override {
            background: #FFF3E0;
            color: #E65100;
        }

        .rate-status.missing {
            background: #FFEBEE;
            color: #C62828;
        }

        .price-item-card {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 0.75rem;
            margin-bottom: 0.75rem;
            background: white;
        }

        .price-item-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 0.5rem;
            margin-bottom: 0.5rem;
        }

        .price-item-grid .form-group {
            margin-bottom: 0.5rem;
        }
        .price-item-grid .form-group label {
            font-size: 0.7rem;
        }

        .a4-page {
            padding: 1.25rem;
            border-bottom: 2px dashed var(--border);
            background: white;
            border-radius: 8px;
            margin-bottom: 0.75rem;
        }

        .a4-page:last-child {
            border-bottom: none;
            margin-bottom: 0;
        }

        .a4-cover {
            text-align: center;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            padding: 2rem 1.25rem;
            border-radius: 8px;
            margin-bottom: 1rem;
        }

        .a4-cover h1 {
            font-size: 1.4rem;
            margin-bottom: 0.35rem;
        }

        .a4-cover p {
            font-size: 0.85rem;
            opacity: 0.9;
            letter-spacing: 1px;
        }

        .a4-section-title {
            color: var(--primary);
            font-size: 1rem;
            font-weight: 700;
            margin: 1.25rem 0 0.6rem;
            padding-bottom: 0.35rem;
            border-bottom: 2px solid var(--primary);
        }

        .spec-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.5rem 1.5rem;
            font-size: 0.9rem;
        }

        .spec-grid div strong {
            display: block;
            color: var(--text-secondary);
            font-size: 0.75rem;
            text-transform: uppercase;
        }

        .scope-list-preview,
        .feature-list-preview {
            list-style: none;
            font-size: 0.9rem;
        }

        .scope-list-preview li,
        .feature-list-preview li {
            padding: 0.3rem 0;
        }

        .scope-list-preview li::before {
            content: "✓ ";
            color: var(--success);
            font-weight: 700;
        }

        .feature-list-preview li::before {
            content: "★ ";
            color: var(--secondary);
        }

        .warranty-badge {
            display: inline-block;
            background: var(--secondary);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .qr-box {
            width: 100px;
            height: 100px;
            border: 2px solid var(--border);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.7rem;
            color: var(--text-secondary);
            text-align: center;
        }

        .rate-master-table td,
        .rate-master-table th {
            font-size: 0.85rem;
        }

        @media (max-width: 900px) {
            .epoxy-body {
                grid-template-columns: 1fr;
            }
            .epoxy-preview-pane {
                display: none;
            }
            .epoxy-preview-pane.mobile-show {
                display: block;
            }
        }

        /* ==================== RATE MASTER MODAL ==================== */
        .rate-modal-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.75rem;
        }

        .unit-tag {
            display: inline-block;
            background: var(--bg);
            padding: 0.25rem 0.6rem;
            border-radius: 12px;
            font-size: 0.8rem;
            margin: 0.2rem;
            border: 1px solid var(--border);
        }
        .unit-tag .del {
            cursor: pointer;
            color: var(--danger);
            margin-left: 0.3rem;
        }

        /* ==================== PREVIEW A4 STYLES ==================== */
        .preview-a4-container {
            max-width: 794px;
            margin: 0 auto;
        }

        .preview-a4-page {
            background: white;
            border-radius: 8px;
            padding: 32px 28px;
            margin-bottom: 16px;
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
            font-size: 13px;
            line-height: 1.6;
            color: #1a1a2e;
            min-height: 400px;
        }

        .preview-a4-page .a4-cover {
            margin-top: -32px;
            margin-left: -28px;
            margin-right: -28px;
            border-radius: 8px 8px 0 0;
        }

        .preview-a4-page .spec-grid {
            font-size: 0.85rem;
        }

        .preview-a4-page .p-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }

        .preview-a4-page .p-table th {
            background: var(--primary);
            color: white;
            padding: 8px;
            text-align: left;
        }

        .preview-a4-page .p-table td {
            padding: 8px;
            border-bottom: 1px solid var(--border);
        }

        .preview-a4-page .p-total {
            margin-left: auto;
            width: 55%;
            font-size: 0.9rem;
        }

        .preview-a4-page .p-total div {
            display: flex;
            justify-content: space-between;
            padding: 4px 0;
            border-bottom: 1px solid var(--border);
        }

        .preview-a4-page .p-total .p-grand {
            font-size: 1.1rem;
            font-weight: 800;
            border-top: 2px solid var(--primary);
            padding-top: 8px;
            margin-top: 4px;
        }

        .preview-a4-page .signature-box {
            height: 60px;
            border-bottom: 1px solid #777;
            margin-top: 8px;
        }

        .preview-a4-page .qr-box-small {
            width: 80px;
            height: 80px;
            border: 1px solid var(--border);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.6rem;
            color: var(--text-secondary);
            text-align: center;
        }
    </style>
</head>
<body>
    <!-- HEADER -->
    <header class="app-header">
        <div class="header-left">
            <button class="menu-toggle" id="menuToggle">☰</button>
            <div class="app-title">H4 Billing ERP</div>
        </div>
    </header>

    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">🏢 H4 Billing ERP</div>
        <nav class="sidebar-menu">
            <div class="sidebar-title">Dashboard</div>
            <div class="sidebar-item active" data-module="dashboard">📊 Dashboard</div>

            <div class="sidebar-title">Setup</div>
            <div class="sidebar-item" data-module="company">🏭 Company Profile</div>
            <div class="sidebar-item" data-module="themes">🎨 Themes</div>

            <div class="sidebar-title">Master Data</div>
            <div class="sidebar-item" data-module="customers">👥 Customers</div>
            <div class="sidebar-item" data-module="products">📦 Products</div>

            <div class="sidebar-title">Documents</div>
            <div class="sidebar-item" data-module="quotations">📄 Quotations</div>
            <div class="sidebar-item" data-module="invoices">🧾 Invoices</div>
            <div class="sidebar-item" data-module="payments">💰 Payments</div>

            <div class="sidebar-title">Tools</div>
            <div class="sidebar-item" data-module="templates">📋 Templates</div>
            <div class="sidebar-item" data-module="backup">💾 Backup</div>
            <div class="sidebar-item" data-module="settings">⚙️ Settings</div>
        </nav>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main-content">

        <!-- ==================== DASHBOARD ==================== -->
        <div class="module active" data-module="dashboard">
            <div class="page-header">
                <h1>📊 Dashboard</h1>
                <p>Welcome to H4 Billing ERP - Your quotation & invoice manager</p>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-value" id="todayQuotations">0</div>
                    <div class="stat-label">Today's Quotations</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" id="todayInvoices">0</div>
                    <div class="stat-label">Today's Invoices</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" id="totalCustomers">0</div>
                    <div class="stat-label">Total Customers</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" id="totalProducts">0</div>
                    <div class="stat-label">Total Products</div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h2>Quick Actions</h2>
                </div>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
                    <button class="btn btn-primary" onclick="H4App.openQuotationTypeModal()">📄 New Quotation</button>
                    <button class="btn btn-secondary" onclick="H4App.navigate('invoices')">🧾 Invoices</button>
                    <button class="btn btn-outline" onclick="H4App.navigate('customers')">👥 Customers</button>
                    <button class="btn btn-outline" onclick="H4App.navigate('products')">📦 Products</button>
                </div>
            </div>
        </div>

        <!-- ==================== COMPANY PROFILE ==================== -->
        <div class="module" data-module="company">
            <div class="page-header">
                <h1>🏭 Company Profile</h1>
                <p>Setup your business details for quotations & invoices</p>
            </div>

            <div class="card">
                <div class="card-header">
                    <h2>Business Information</h2>
                </div>

                <form id="companyForm">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="legalName">Legal Company Name *</label>
                            <input type="text" id="legalName" required>
                        </div>
                        <div class="form-group">
                            <label for="brandName">Brand Name</label>
                            <input type="text" id="brandName">
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="businessType">Business Type</label>
                        <select id="businessType">
                            <option value="">-- Select Type --</option>
                            <option value="manufacturing">Manufacturing</option>
                            <option value="trading">Trading</option>
                            <option value="service">Service</option>
                            <option value="distributor">Distributor</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="address">Address *</label>
                        <textarea id="address" rows="2" required></textarea>
                    </div>

                    <div class="form-row-3">
                        <div class="form-group">
                            <label for="city">City</label>
                            <input type="text" id="city">
                        </div>
                        <div class="form-group">
                            <label for="district">District</label>
                            <input type="text" id="district">
                        </div>
                        <div class="form-group">
                            <label for="state">State</label>
                            <input type="text" id="state" value="Kerala">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="pin">PIN</label>
                            <input type="text" id="pin">
                        </div>
                        <div class="form-group">
                            <label for="website">Website</label>
                            <input type="url" id="website">
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="phone">Phone *</label>
                            <input type="tel" id="phone" required>
                        </div>
                        <div class="form-group">
                            <label for="whatsapp">WhatsApp</label>
                            <input type="tel" id="whatsapp">
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email">
                    </div>

                    <div class="form-group">
                        <label>
                            <input type="checkbox" id="gstEnabled"> GST Enabled
                        </label>
                    </div>

                    <div id="gstFields" style="display:none;">
                        <div class="form-row">
                            <div class="form-group">
                                <label for="gstin">GSTIN</label>
                                <input type="text" id="gstin" maxlength="15">
                            </div>
                            <div class="form-group">
                                <label for="gstStateCode">GST State Code</label>
                                <input type="text" id="gstStateCode" maxlength="2">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            <input type="checkbox" id="panEnabled"> PAN Enabled
                        </label>
                    </div>

                    <div id="panFields" style="display:none;">
                        <div class="form-group">
                            <label for="pan">PAN</label>
                            <input type="text" id="pan" maxlength="10">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>
                            <input type="checkbox" id="bankEnabled"> Bank Details
                        </label>
                    </div>

                    <div id="bankFields" style="display:none;">
                        <div class="form-row">
                            <div class="form-group">
                                <label for="bankName">Bank Name</label>
                                <input type="text" id="bankName">
                            </div>
                            <div class="form-group">
                                <label for="accountName">Account Name</label>
                                <input type="text" id="accountName">
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="accountNumber">Account Number</label>
                                <input type="text" id="accountNumber">
                            </div>
                            <div class="form-group">
                                <label for="ifsc">IFSC Code</label>
                                <input type="text" id="ifsc">
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="branch">Branch</label>
                                <input type="text" id="branch">
                            </div>
                            <div class="form-group">
                                <label for="upiId">UPI ID</label>
                                <input type="text" id="upiId">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="terms">Terms & Conditions</label>
                        <textarea id="terms" rows="3" placeholder="Payment due within 30 days..."></textarea>
                    </div>

                    <div class="form-group">
                        <label for="footerText">Footer Text</label>
                        <input type="text" id="footerText" placeholder="Thank you for your business!">
                    </div>

                    <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                        <button type="reset" class="btn btn-outline">Clear</button>
                        <button type="submit" class="btn btn-primary">💾 Save Company Profile</button>
                    </div>
                </form>
            </div>

            <div class="card">
                <div class="card-header">
                    <h2>Logo Manager</h2>
                </div>

                <div class="form-group">
                    <label for="logoUpload">Upload Logo (PNG/JPEG)</label>
                    <input type="file" id="logoUpload" accept="image/*">
                    <small style="color: var(--text-secondary);">Upload logo for quotations & invoices</small>
                </div>

                <div id="logoPreview" style="display:none; margin-top: 1rem;">
                    <h3 style="font-size: 1rem; margin-bottom: 1rem;">Current Logo</h3>
                    <div class="image-preview">
                        <img id="logoImage" src="" alt="Logo">
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h2>Signature Manager</h2>
                </div>

                <div class="form-group">
                    <label for="signatureUpload">Upload Signature (PNG/JPEG)</label>
                    <input type="file" id="signatureUpload" accept="image/*">
                    <small style="color: var(--text-secondary);">Upload authorized signatory signature</small>
                </div>

                <div class="form-group">
                    <label for="signatoryName">Authorized Signatory Name</label>
                    <input type="text" id="signatoryName">
                </div>

                <div id="signaturePreview" style="display:none; margin-top: 1rem;">
                    <h3 style="font-size: 1rem; margin-bottom: 1rem;">Current Signature</h3>
                    <div class="image-preview">
                        <img id="signatureImage" src="" alt="Signature">
                    </div>
                </div>
            </div>
        </div>

        <!-- ==================== CUSTOMERS ==================== -->
        <div class="module" data-module="customers">
            <div class="page-header">
                <h1>👥 Customers</h1>
                <p>Manage your customer database</p>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <button class="btn btn-primary" onclick="H4App.openModal('customerModal')">➕ Add New Customer</button>
            </div>

            <div class="card">
                <table class="table" id="customersTable">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Company</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>City</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="customersBody">
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 2rem; color: var(--text-secondary);">No customers yet</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ==================== PRODUCTS ==================== -->
        <div class="module" data-module="products">
            <div class="page-header">
                <h1>📦 Products / Materials</h1>
                <p>Manage your product catalog</p>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <button class="btn btn-primary" onclick="H4App.openModal('productModal')">➕ Add New Product</button>
            </div>

            <div style="margin-bottom: 1.5rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
                <button class="btn btn-secondary category-filter active" data-cat="all">All</button>
                <button class="btn btn-outline category-filter" data-cat="tile-adhesive">Tile Adhesive</button>
                <button class="btn btn-outline category-filter" data-cat="waterproofing">Waterproofing</button>
                <button class="btn btn-outline category-filter" data-cat="epoxy">Epoxy</button>
            </div>

            <div class="card">
                <table class="table" id="productsTable">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Unit</th>
                            <th>Selling Rate</th>
                            <th>GST %</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="productsBody">
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 2rem; color: var(--text-secondary);">No products yet</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ==================== QUOTATIONS ==================== -->
        <div class="module" data-module="quotations">
            <div class="page-header">
                <h1>📄 Quotations</h1>
                <p>Create and manage quotations</p>
            </div>

            <div id="quotationsList">
                <div style="margin-bottom: 1.5rem;">
                    <button class="btn btn-primary" onclick="H4App.openQuotationTypeModal()">➕ New Quotation</button>
                </div>

                <div class="card">
                    <table class="table" id="quotationsTable">
                        <thead>
                            <tr>
                                <th>Quotation #</th>
                                <th>Customer</th>
                                <th>Amount</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="quotationsBody">
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 2rem; color: var(--text-secondary);">No quotations yet</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ==================== INVOICES ==================== -->
        <div class="module" data-module="invoices">
            <div class="page-header">
                <h1>🧾 Invoices</h1>
                <p>Create and manage invoices</p>
            </div>

            <div id="invoicesList">
                <div style="margin-bottom: 1.5rem;">
                    <button class="btn btn-primary" onclick="H4App.newInvoice()">➕ New Invoice</button>
                </div>

                <div class="card">
                    <table class="table" id="invoicesTable">
                        <thead>
                            <tr>
                                <th>Invoice #</th>
                                <th>Customer</th>
                                <th>Amount</th>
                                <th>Paid</th>
                                <th>Balance</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="invoicesBody">
                            <tr>
                                <td colspan="7" style="text-align: center; padding: 2rem; color: var(--text-secondary);">No invoices yet</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ==================== PAYMENTS ==================== -->
        <div class="module" data-module="payments">
            <div class="page-header">
                <h1>💰 Payments</h1>
                <p>Track invoice payments</p>
            </div>
            <div class="card">
                <p style="text-align: center; color: var(--text-secondary);">Payment tracking coming in Phase 3</p>
            </div>
        </div>

        <!-- ==================== TEMPLATES ==================== -->
        <div class="module" data-module="templates">
            <div class="page-header">
                <h1>📋 Template Designer</h1>
                <p>Design quotation & invoice templates</p>
            </div>
            <div class="card">
                <p style="text-align: center; color: var(--text-secondary);">Template designer coming in Phase 3</p>
            </div>
        </div>

        <!-- ==================== THEMES ==================== -->
        <div class="module" data-module="themes">
            <div class="page-header">
                <h1>🎨 Themes</h1>
                <p>Customize your document themes</p>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <button class="btn btn-primary" onclick="H4App.openModal('themeModal')">➕ Create Theme</button>
            </div>

            <div class="card" id="themesContainer">
                <p style="text-align: center; color: var(--text-secondary);">No themes yet</p>
            </div>
        </div>

        <!-- ==================== BACKUP ==================== -->
        <div class="module" data-module="backup">
            <div class="page-header">
                <h1>💾 Backup & Restore</h1>
                <p>Backup your billing data</p>
            </div>

            <div class="card">
                <div class="card-header">
                    <h2>Backup Data</h2>
                </div>

                <p style="margin-bottom: 1rem; color: var(--text-secondary);">Download a complete backup of all your company data, customers, products, quotations, and invoices.</p>

                <button class="btn btn-primary btn-block" onclick="H4App.downloadBackup()">📥 Download Backup</button>
            </div>

            <div class="card">
                <div class="card-header">
                    <h2>Restore Data</h2>
                </div>

                <p style="margin-bottom: 1rem; color: var(--text-secondary);">Upload a backup file to restore your data. This will replace current data.</p>

                <div class="form-group">
                    <label for="backupFile">Select Backup File</label>
                    <input type="file" id="backupFile" accept=".json">
                </div>

                <button class="btn btn-danger btn-block" onclick="H4App.restoreBackup()">⚠️ Restore Backup</button>
            </div>
        </div>

        <!-- ==================== SETTINGS ==================== -->
        <div class="module" data-module="settings">
            <div class="page-header">
                <h1>⚙️ Settings</h1>
                <p>Configure your H4 Billing ERP</p>
            </div>

            <div class="card">
                <div class="card-header">
                    <h2>General Settings</h2>
                </div>

                <form id="settingsForm">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="currency">Currency</label>
                            <select id="currency">
                                <option value="INR">₹ Indian Rupee (INR)</option>
                                <option value="USD">$ US Dollar (USD)</option>
                                <option value="EUR">€ Euro (EUR)</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="dateFormat">Date Format</label>
                            <select id="dateFormat">
                                <option value="DD/MM/YYYY">DD/MM/YYYY</option>
                                <option value="MM/DD/YYYY">MM/DD/YYYY</option>
                                <option value="YYYY-MM-DD">YYYY-MM-DD</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="defaultGst">Default GST %</label>
                        <input type="number" id="defaultGst" step="0.01" value="18">
                    </div>

                    <div class="form-group">
                        <h3 style="font-size: 1.1rem; margin-bottom: 1rem; color: var(--primary);">Quotation Numbering</h3>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="quotationPrefix">Prefix</label>
                                <input type="text" id="quotationPrefix" value="H4-QTN" maxlength="20">
                            </div>
                            <div class="form-group">
                                <label for="quotationYear">Financial Year</label>
                                <input type="number" id="quotationYear" value="2026">
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="quotationStart">Starting Number</label>
                                <input type="number" id="quotationStart" value="1" min="1">
                            </div>
                            <div class="form-group">
                                <label for="quotationValidity">Default Validity (days)</label>
                                <input type="number" id="quotationValidity" value="30" min="1">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <h3 style="font-size: 1.1rem; margin-bottom: 1rem; color: var(--primary);">Invoice Numbering</h3>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="invoicePrefix">Prefix</label>
                                <input type="text" id="invoicePrefix" value="H4-INV" maxlength="20">
                            </div>
                            <div class="form-group">
                                <label for="invoiceYear">Financial Year</label>
                                <input type="number" id="invoiceYear" value="2026">
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="invoiceStart">Starting Number</label>
                                <input type="number" id="invoiceStart" value="1" min="1">
                            </div>
                            <div class="form-group">
                                <label for="invoiceDueDays">Default Due Days</label>
                                <input type="number" id="invoiceDueDays" value="30" min="0">
                            </div>
                        </div>
                    </div>

                    <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                        <button type="reset" class="btn btn-outline">Reset</button>
                        <button type="submit" class="btn btn-primary">💾 Save Settings</button>
                    </div>
                </form>
            </div>

            <div class="card">
                <div class="card-header">
                    <h2>Danger Zone</h2>
                </div>

                <button class="btn btn-danger btn-block" onclick="H4App.resetAllData()">🗑️ Delete All Data</button>
                <p style="font-size: 0.85rem; color: var(--danger); margin-top: 0.5rem;">⚠️ This action cannot be undone!</p>
            </div>
        </div>
    </main>

    <!-- BOTTOM NAVIGATION -->
    <nav class="bottom-nav" id="bottomNav" style="display: none;">
