                document.getElementById('epxNumber').value = q.number || '';
                document.getElementById('epxDate').value = q.date || '';
                document.getElementById('epxValidity').value = q.validity || 15;
                document.getElementById('epxCustomer').value = q.customerId || '';
                document.getElementById('epxCustPhone').value = cus.phone || '';
                document.getElementById('epxCustWhatsapp').value = cus.whatsapp || '';
                document.getElementById('epxCustEmail').value = cus.email || '';
                document.getElementById('epxProjectName').value = pd.projectName || '';
                document.getElementById('epxProjectName2').value = pd.projectName || '';
                document.getElementById('epxSiteAddress').value = q.siteAddress || cus.address || '';
                document.getElementById('epxReference').value = q.reference || '';
                document.getElementById('epxArea').value = pd.area || '';
                document.getElementById('epxAreaUnit').value = pd.areaUnit || 'sq.ft';
                document.getElementById('epxFlooringType').value = pd.flooringType || '';
                document.getElementById('epxThickness').value = pd.thickness || '';
                document.getElementById('epxFloorCondition').value = pd.floorCondition || '';
