                    <div class="area-row" data-room="${room.id}">
                        <div style="font-weight:600;font-size:13px;min-width:80px;color:var(--h4-text-primary);">
                            ${room.name}
                        </div>
                        <div class="form-group" style="flex:1;">
                            <label>Length (ft)</label>
                            <input type="number" class="room-length" value="${room.length}" min="0.5" step="0.5" 
                                   data-id="${room.id}" onchange="updateRoomLength('${room.id}', this.value)">
                        </div>
                        <div class="form-group" style="flex:1;">
                            <label>Width (ft)</label>
                            <input type="number" class="room-width" value="${room.width}" min="0.5" step="0.5" 
