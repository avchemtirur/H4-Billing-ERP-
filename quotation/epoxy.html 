            // ----- BACKUP -----
            downloadBackup() {
                const data = H4DB.get();
                const backup = JSON.stringify(data, null, 2);
                const blob = new Blob([backup], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = 'H4-Billing-Backup-' + new Date().toISOString().slice(0, 10) + '.json';
                a.click();
                URL.revokeObjectURL(url);
                H4Notify.success('Backup downloaded!');
            },

            restoreBackup() {
                const file = document.getElementById('backupFile').files[0];
                if (!file) { H4Notify.danger('Please select a backup file'); return; }
                const reader = new FileReader();
                reader.onload = (e) => {
                    try {
                        const data = JSON.parse(e.target.result);
                        H4DB.import(data);
                        H4Notify.success('Backup restored! Refreshing...');
                        setTimeout(() => location.reload(), 1000);
                    } catch (err) {
                        H4Notify.danger('Invalid backup file!');
                    }
                };
                reader.readAsText(file);
            },

