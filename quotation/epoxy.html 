            function updateRoomLength(id, value) {
                const room = rooms.find(r => r.id === id);
                if (room) {
                    room.length = parseFloat(value) || 0;
                    saveToStorage(STORAGE_KEYS.ROOMS, rooms);
                    calculateTotalArea();
                    updateMaterials();
                }
            }

            function updateRoomWidth(id, value) {
                const room = rooms.find(r => r.id === id);
                if (room) {
                    room.width = parseFloat(value) || 0;
                    saveToStorage(STORAGE_KEYS.ROOMS, rooms);
                    calculateTotalArea();
                    updateMaterials();
                }
            }

            function removeRoom(id) {
                if (rooms.length <= 1) {
                    showToast('⚠️ At least one room is required', 'warning');
                    return;
                }
                rooms = rooms.filter(r => r.id !== id);
                saveToStorage(STORAGE_KEYS.ROOMS, rooms);
                renderRooms();
                calculateTotalArea();
                updateMaterials();
