            // ============================================================
            // STORAGE
            // ============================================================
            function loadFromStorage(key, defaults) {
                try {
                    const data = localStorage.getItem(key);
                    if (data) {
                        const parsed = JSON.parse(data);
                        if (parsed.length > 0) return parsed;
                    }
                } catch (e) { console.warn('Error loading', key, e); }
                return JSON.parse(JSON.stringify(defaults));
            }

            function saveToStorage(key, data) {
                try {
                    localStorage.setItem(key, JSON.stringify(data));
                } catch (e) { console.error('Error saving', key, e); }
            }

            // ============================================================
            // LOAD DATA
            // ============================================================
            function loadAllData() {
                systems = loadFromStorage(STORAGE_KEYS.SYSTEMS, defaultSystems);
                materials = loadFromStorage(STORAGE_KEYS.MATERIALS, defaultMaterials);
                labours = loadFromStorage(STORAGE_KEYS.LABOUR, defaultLabours);
                charges = loadFromStorage(STORAGE_KEYS.CHARGES, defaultCharges);
                rooms = loadFromStorage(STORAGE_KEYS.ROOMS, [{ id: 'room_1', name: 'Room 1', length: 10, width: 10 }]);

                // Save defaults if empty
                if (systems.length === 0) { systems = JSON.parse(JSON.stringify(defaultSystems));
                    saveToStorage(STORAGE_KEYS.SYSTEMS, systems); }
                if (materials.length === 0) { materials = JSON.parse(JSON.stringify(defaultMaterials));
                    saveToStorage(STORAGE_KEYS.MATERIALS, materials); }
                if (labours.length === 0) { labours = JSON.parse(JSON.stringify(defaultLabours));
                    saveToStorage(STORAGE_KEYS.LABOUR, labours); }
                if (charges.length === 0) { charges = JSON.parse(JSON.stringify(defaultCharges));
                    saveToStorage(STORAGE_KEYS.CHARGES, charges); }

                renderAll();
            }

