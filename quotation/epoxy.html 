    <!-- ==================== EPOXY BUILDER OVERLAY ==================== -->
    <div class="epoxy-overlay" id="epoxyOverlay">
        <div class="epoxy-topbar">
            <div class="epoxy-topbar-title">✨ Premium Epoxy Flooring Proposal</div>
            <div class="epoxy-topbar-actions">
                <button class="btn btn-sm btn-secondary" onclick="H4Epoxy.togglePreviewMobile()" id="epoxyPreviewToggleBtn" style="display:none;">👁️ Preview</button>
                <button class="btn btn-sm btn-success" onclick="H4Epoxy.save()">💾 Save</button>
                <button class="btn btn-sm btn-danger" onclick="H4Epoxy.close()">✕ Close</button>
            </div>
        </div>

        <div class="epoxy-steps" id="epoxySteps"></div>

        <div class="epoxy-body">
            <div class="epoxy-form-pane" id="epoxyFormPane">

                <!-- STEP 1: CUSTOMER & QUOTATION -->
                <div class="epoxy-step-section" data-step="1">
                    <div class="card">
                        <div class="card-header"><h2>Quotation & Customer</h2></div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Quotation Number</label>
                                <input type="text" id="epxNumber" readonly>
                            </div>
                            <div class="form-group">
                                <label for="epxDate">Date</label>
                                <input type="date" id="epxDate" data-bind="date">
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="epxValidity">Validity (days)</label>
                                <input type="number" id="epxValidity" min="1" value="15" data-bind="validity">
                            </div>
                            <div class="form-group">
                                <label for="epxCustomer">Customer *</label>
                                <select id="epxCustomer" data-bind="customerId"></select>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="epxCustPhone">Customer Phone</label>
                                <input type="text" id="epxCustPhone" data-bind="customerPhone">
                            </div>
                            <div class="form-group">
                                <label for="epxCustWhatsapp">Customer WhatsApp</label>
                                <input type="text" id="epxCustWhatsapp" data-bind="customerWhatsapp">
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="epxCustEmail">Customer Email</label>
                                <input type="email" id="epxCustEmail" data-bind="customerEmail">
                            </div>
                            <div class="form-group">
                                <label for="epxProjectName">Project Name</label>
                                <input type="text" id="epxProjectName" data-bind="projectName">
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="epxSiteAddress">Site Address</label>
                            <textarea id="epxSiteAddress" rows="2" data-bind="siteAddress"></textarea>
                        </div>
                        <div class="form-group">
                            <label for="epxReference">Reference Number</label>
                            <input type="text" id="epxReference" data-bind="reference">
                        </div>
                    </div>
                </div>

                <!-- STEP 2: PROJECT DETAILS -->
                <div class="epoxy-step-section" data-step="2">
                    <div class="card">
                        <div class="card-header"><h2>Project Details</h2></div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="epxProjectName2">Project Name</label>
                                <input type="text" id="epxProjectName2" data-bind="projectName">
                            </div>
                            <div class="form-group">
                                <label for="epxArea">Area *</label>
                                <input type="number" id="epxArea" min="0" step="0.01" data-bind="area" oninput="H4Epoxy.onSystemChange()">
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="epxAreaUnit">Area Unit</label>
                                <select id="epxAreaUnit" data-bind="areaUnit" onchange="H4Epoxy.onSystemChange()"></select>
                            </div>
                            <div class="form-group">
                                <label for="epxFlooringType">Flooring Type *</label>
                                <select id="epxFlooringType" data-bind="flooringType" onchange="H4Epoxy.onSystemChange()"></select>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="epxThickness">Thickness *</label>
                                <select id="epxThickness" data-bind="thickness" onchange="H4Epoxy.onSystemChange()"></select>
                            </div>
                            <div class="form-group">
                                <label for="epxFloorCondition">Floor Condition</label>
                                <select id="epxFloorCondition" data-bind="floorCondition" onchange="H4Epoxy.onSystemChange()"></select>
                            </div>
                        </div>
                        <div style="display:flex; gap:0.5rem; flex-wrap:wrap; margin-top:0.5rem;">
                            <button class="btn btn-sm btn-outline" onclick="H4Epoxy.addMasterItem('flooringTypeMaster', 'newFlooringTypeInput', 'epxFlooringType', 'Flooring Type')">➕ Add Flooring Type</button>
                            <button class="btn btn-sm btn-outline" onclick="H4Epoxy.addMasterItem('thicknessMaster', 'newThicknessInput', 'epxThickness', 'Thickness')">➕ Add Thickness</button>
                            <button class="btn btn-sm btn-outline" onclick="H4Epoxy.addMasterItem('floorConditionMaster', 'newFloorConditionInput', 'epxFloorCondition', 'Floor Condition')">➕ Add Floor Condition</button>
                            <button class="btn btn-sm btn-outline" onclick="H4Epoxy.addMasterItem('unitMaster', 'newUnitInput', 'epxAreaUnit', 'Unit')">➕ Add Unit</button>
                        </div>
                        <!-- Hidden inline inputs for adding -->
                        <div style="display:none;">
                            <input type="text" id="newFlooringTypeInput" placeholder="New Flooring Type">
                            <input type="text" id="newThicknessInput" placeholder="New Thickness">
                            <input type="text" id="newFloorConditionInput" placeholder="New Floor Condition">
                            <input type="text" id="newUnitInput" placeholder="New Unit">
                        </div>
                    </div>
                </div>

                <!-- STEP 3: SMART RATE -->
                <div class="epoxy-step-section" data-step="3">
                    <div class="card">
                        <div class="card-header"><h2>Smart Rate / Flooring System</h2></div>
                        <p style="color:var(--text-secondary); font-size:0.9rem; margin-bottom:0.75rem;">Based on Flooring Type + Thickness + Unit selected in Step 2, the rate is auto-filled from the Rate Master.</p>

                        <div id="epxRateStatus" class="rate-status auto">Select project details to check rate</div>

                        <div class="form-row" style="margin-top:1rem;">
                            <div class="form-group">
                                <label for="epxSystemRate">Rate (₹ per unit)</label>
                                <input type="number" id="epxSystemRate" step="0.01" min="0" data-bind="systemRate" oninput="H4Epoxy.onManualRateEdit()">
                            </div>
                            <div class="form-group">
                                <label for="epxSystemGst">GST %</label>
                                <input type="number" id="epxSystemGst" step="0.01" min="0" value="18" data-bind="systemGst">
                            </div>
                        </div>

                        <div style="display:flex; gap:0.5rem; margin-top:0.5rem; flex-wrap:wrap;">
                            <button class="btn btn-sm btn-outline" onclick="H4Epoxy.resetToAutoRate()">🔒 Use Auto Rate</button>
                            <button class="btn btn-sm btn-outline" onclick="H4App.openModal('rateMasterModal')">➕ Add Rate</button>
                        </div>

                        <div class="card" style="margin-top:1rem; background:var(--bg);">
                            <strong>Estimated Amount (Self-Leveling System):</strong>
                            <div style="font-size:1.3rem; color:var(--primary); font-weight:700;" id="epxSystemAmount">₹0.00</div>
                            <small style="color:var(--text-secondary);">Area × Rate — this line is auto-added to Price Items in Step 6.</small>
                        </div>
                    </div>
                </div>

                <!-- STEP 4: WORK SCOPE -->
                <div class="epoxy-step-section" data-step="4">
                    <div class="card">
                        <div class="card-header">
                            <h2>Work Scope</h2>
                            <button class="btn btn-sm btn-success" onclick="H4Epoxy.addScopeItem()">➕ Add</button>
                        </div>
                        <div id="epxScopeList"></div>
                    </div>
                </div>

                <!-- STEP 5: MATERIAL SPECIFICATION -->
                <div class="epoxy-step-section" data-step="5">
                    <div class="card">
                        <div class="card-header"><h2>Material Specification</h2></div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="epxBrand">Brand</label>
                                <input type="text" id="epxBrand" data-bind="brand" value="H4">
                            </div>
                            <div class="form-group">
                                <label for="epxProductSystem">Product / System</label>
                                <input type="text" id="epxProductSystem" data-bind="productSystem">
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="epxMixingRatio">Mixing Ratio</label>
                                <input type="text" id="epxMixingRatio" data-bind="mixingRatio" placeholder="e.g. 2:1">
                            </div>
                            <div class="form-group">
                                <label for="epxMatThickness">Thickness</label>
                                <input type="text" id="epxMatThickness" data-bind="matThickness" placeholder="e.g. 2mm">
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="epxColourCode">Colour Code</label>
                                <input type="text" id="epxColourCode" data-bind="colourCode">
                            </div>
                            <div class="form-group">
                                <label for="epxColourName">Colour Name</label>
                                <input type="text" id="epxColourName" data-bind="colourName">
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="epxFinish">Finish</label>
                                <select id="epxFinish" data-bind="finish">
                                    <option>High Gloss</option>
                                    <option>Gloss</option>
                                    <option>Matte</option>
                                    <option>Satin</option>
                                    <option>Custom</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="epxAntiSlip">Anti-slip</label>
                                <select id="epxAntiSlip" data-bind="antiSlip">
                                    <option>Not Required</option>
                                    <option>Standard</option>
                                    <option>Medium</option>
                                    <option>Heavy Duty</option>
                                    <option>Custom</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- STEP 6: PRICE ITEMS -->
                <div class="epoxy-step-section" data-step="6">
                    <div class="card">
                        <div class="card-header">
                            <h2>Price Items</h2>
                            <button class="btn btn-sm btn-success" onclick="H4Epoxy.addPriceItem()">➕ Add Item</button>
                        </div>
                        <div id="epxPriceItems"></div>
                    </div>
                </div>

                <!-- STEP 7: DISCOUNT & GST -->
                <div class="epoxy-step-section" data-step="7">
                    <div class="card">
                        <div class="card-header"><h2>Discount & GST</h2></div>
                        <div class="form-group">
                            <label><input type="checkbox" id="epxDiscountEnabled" onchange="H4Epoxy.calculate()"> Enable Discount</label>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="epxDiscountValue">Discount</label>
                                <input type="number" id="epxDiscountValue" step="0.01" min="0" value="0" oninput="H4Epoxy.calculate()">
                            </div>
                            <div class="form-group">
                                <label for="epxDiscountType">Discount Type</label>
                                <select id="epxDiscountType" onchange="H4Epoxy.calculate()">
                                    <option value="flat">Flat</option>
                                    <option value="percentage">Percentage</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="epxGstMode">GST Mode</label>
                            <select id="epxGstMode" onchange="H4Epoxy.calculate()">
                                <option value="intra">Intra-state (CGST + SGST)</option>
                                <option value="inter">Inter-state (IGST)</option>
                                <option value="off">GST Disabled</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- STEP 8: CALCULATION -->
                <div class="epoxy-step-section" data-step="8">
                    <div class="card">
                        <div class="card-header"><h2>Calculation</h2></div>
                        <div class="calc-box">
                            <div class="calc-row"><span class="calc-label">Subtotal:</span><span class="calc-value">₹ <span id="epxSubtotal">0.00</span></span></div>
                            <div class="calc-row"><span class="calc-label">Discount:</span><span class="calc-value">₹ <span id="epxDiscountAmt">0.00</span></span></div>
                            <div class="calc-row"><span class="calc-label">Taxable Amount:</span><span class="calc-value">₹ <span id="epxTaxable">0.00</span></span></div>
                            <div class="calc-row" id="epxCgstRow"><span class="calc-label">CGST:</span><span class="calc-value">₹ <span id="epxCgst">0.00</span></span></div>
                            <div class="calc-row" id="epxSgstRow"><span class="calc-label">SGST:</span><span class="calc-value">₹ <span id="epxSgst">0.00</span></span></div>
                            <div class="calc-row" id="epxIgstRow" style="display:none;"><span class="calc-label">IGST:</span><span class="calc-value">₹ <span id="epxIgst">0.00</span></span></div>
                            <div class="calc-row"><span class="calc-label">Round Off:</span><span class="calc-value">₹ <span id="epxRoundOff">0.00</span></span></div>
                            <div class="calc-row total"><span>GRAND TOTAL:</span><span>₹ <span id="epxGrandTotal">0.00</span></span></div>
                        </div>
                    </div>
                </div>

                <!-- STEP 9: TIMELINE -->
                <div class="epoxy-step-section" data-step="9">
                    <div class="card">
                        <div class="card-header"><h2>Timeline</h2></div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="epxWorkDuration">Work Duration</label>
                                <input type="text" id="epxWorkDuration" data-bind="workDuration" placeholder="e.g. 3-5 Days">
                            </div>
                            <div class="form-group">
                                <label for="epxCuringTime">Curing Time</label>
                                <input type="text" id="epxCuringTime" data-bind="curingTime" placeholder="e.g. 24-72 Hours">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- STEP 10: WARRANTY -->
                <div class="epoxy-step-section" data-step="10">
                    <div class="card">
                        <div class="card-header"><h2>Warranty</h2></div>
                        <div class="form-group">
                            <label><input type="checkbox" id="epxWarrantyEnabled" checked onchange="H4Epoxy.updatePreview()"> Enable Warranty</label>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="epxWarrantyPeriod">Warranty Period</label>
                                <select id="epxWarrantyPeriod" data-bind="warrantyPeriod" onchange="H4Epoxy.updatePreview()">
