                document.getElementById('epxMixingRatio').value = ms.mixingRatio || '';
                document.getElementById('epxMatThickness').value = ms.thickness || '';
                document.getElementById('epxColourCode').value = ms.colourCode || '';
                document.getElementById('epxColourName').value = ms.colourName || '';
