                    return;
                }
                document.getElementById('labourRate').parentElement.classList.remove('error');

                labours.push({
                    id: 'lab_' + Date.now(),
                    name: name,
                    rate: rate
                });

                saveToStorage(STORAGE_KEYS.LABOUR, labours);
                renderLabourCharges();
                updateMaterials();
                closeModal('addLabourModal');
                showToast(`✅ Labour "${name}" added`, 'success');
            }

            function openAddChargeModal() {
                document.getElementById('chargeName').value = '';
                document.getElementById('chargeAmount').value = '';
                document.getElementById('chargeType').value = 'per_sqft';
                document.querySelectorAll('#addChargeModal .input-error').forEach(el => el.style.display = 'none');
                openModal('addChargeModal');
            }

            function saveCharge() {
                const name = document.getElementById('chargeName').value.trim();
                const amount = parseFloat(document.getElementById('chargeAmount').value);
                const type = document.getElementById('chargeType').value;

                if (!name) {
                    document.getElementById('chargeName').parentElement.classList.add('error');
                    showToast('⚠️ Charge name is required', 'error');
                    return;
                }
                document.getElementById('chargeName').parentElement.classList.remove('error');

                if (!amount || amount <= 0) {
                    document.getElementById('chargeAmount').parentElement.classList.add('error');
                    showToast('⚠️ Amount is required', 'error');
                    return;
                }
                document.getElementById('chargeAmount').parentElement.classList.remove('error');

                charges.push({
                    id: 'chg_' + Date.now(),
                    name: name,
                    amount: amount,
                    type: type
                });

                saveToStorage(STORAGE_KEYS.CHARGES, charges);
                renderLabourCharges();
                updateMaterials();
                closeModal('addChargeModal');
                showToast(`✅ Charge "${name}" added`, 'success');
            }

            // ============================================================
            // GENERATE & SAVE QUOTATION
            // ============================================================
            function generateQuotation() {
                const customerName = document.getElementById('customerName').value.trim();
                if (!customerName) {
                    document.getElementById('customerNameGroup').classList.add('error');
                    showToast('⚠️ Customer name is required', 'error');
                    document.getElementById('customerName').focus();
                    return;
                }
                document.getElementById('customerNameGroup').classList.remove('error');

                const projectAddress = document.getElementById('projectAddress').value.trim();
                if (!projectAddress) {
                    document.getElementById('projectAddress').parentElement.classList.add('error');
                    showToast('⚠️ Project address is required', 'error');
                    document.getElementById('projectAddress').focus();
                    return;
                }
                document.getElementById('projectAddress').parentElement.classList.remove('error');

                const systemId = document.getElementById('epoxySystem').value;
                if (!systemId) {
                    document.getElementById('systemGroup').classList.add('error');
                    showToast('⚠️ Please select an epoxy system', 'error');
                    return;
                }
                document.getElementById('systemGroup').classList.remove('error');

                const thickness = getThickness();
                if (!thickness || thickness <= 0) {
                    document.getElementById('thicknessGroup').classList.add('error');
                    showToast('⚠️ Please select thickness', 'error');
                    return;
                }
                document.getElementById('thicknessGroup').classList.remove('error');

                const area = calculateTotalArea();
                if (!area || area <= 0) {
                    showToast('⚠️ Please enter valid area dimensions', 'error');
                    return;
                }

                const sellingPrice = window._sellingPrice || 0;
                const totalCost = window._totalCost || 0;
                const profitAmt = window._profitAmount || 0;

                const system = systems.find(s => s.id === systemId);

                const quotationData = {
                    id: 'qtn_' + Date.now(),
                    quotationNumber: quotationNumber,
                    date: new Date().toISOString().split('T')[0],
                    validUntil: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
                    customer: {
                        name: customerName,
                        mobile: document.getElementById('customerMobile').value.trim(),
                        address: document.getElementById('customerAddress').value.trim()
                    },
                    project: {
                        address: projectAddress,
                        area: area,
                        systemId: systemId,
                        systemName: system ? system.name : '',
                        thickness: thickness
                    },
                    rooms: rooms.map(r => ({ ...r })),
                    materials: calculatedMaterials.map(m => ({
                        id: m.id,
                        name: m.name,
                        unit: m.unit,
                        qty: m.qty,
                        rate: m.rate,
                        total: m.total
                    })),
                    labours: labours.map(l => ({ ...l })),
                    charges: charges.map(c => ({ ...c })),
                    costing: {
                        materialCost: calculatedMaterials.reduce((sum, m) => sum + m.total, 0),
                        labourCost: parseFloat(document.getElementById('labourCost').textContent.replace('₹', '')) || 0,
                        totalCost: totalCost,
                        overheadPercent: parseFloat(document.getElementById('overheadPercentInput').value) || 0,
                        overheadAmount: parseFloat(document.getElementById('overheadAmount').textContent.replace('₹',
                            '')) || 0,
                        profitPercent: parseFloat(document.getElementById('profitPercentInput').value) || 0,
                        profitAmount: profitAmt,
                        sellingPrice: sellingPrice
                    },
                    customerQuote: {
                        subtotal: sellingPrice,
                        gstRate: GST_RATE,
                        gst: sellingPrice * GST_RATE / 100,
                        grandTotal: sellingPrice * (1 + GST_RATE / 100)
                    },
                    status: 'draft',
                    createdAt: new Date().toISOString()
                };

                let existing = [];
                try {
                    const data = localStorage.getItem(STORAGE_KEYS.QUOTATIONS);
                    if (data) existing = JSON.parse(data);
                } catch (e) {}
                existing.push(quotationData);
                localStorage.setItem(STORAGE_KEYS.QUOTATIONS, JSON.stringify(existing));

                showToast(`✅ Quotation ${quotationNumber} saved successfully!`, 'success');
            }

            // ============================================================
            // PRINT
            // ============================================================
            function printQuotation() {
                const customerQuotation = document.getElementById('customerQuotation');
                const win = window.open('', '_blank');
                if (!win) {
                    showToast('⚠️ Please allow popups to print', 'warning');
                    return;
                }

                const printHtml = `
                    <!DOCTYPE html>
                    <html>
                    <head>
                        <meta charset="UTF-8">
                        <meta name="viewport" content="width=device-width, initial-scale=1.0">
                        <title>H4 Epoxy Quotation - ${quotationNumber}</title>
                        <style>
                            * { margin: 0; padding: 0; box-sizing: border-box; }
                            body { font-family: Arial, sans-serif; padding: 20px; color: #1a1a2e; }
                            .print-container { max-width: 900px; margin: 0 auto; }
                            ${document.querySelector('style').innerHTML}
                            .no-print { display: none !important; }
                            .profit-box { display: none !important; }
                            .internal-costing { display: none !important; }
                            .section-title .badge.internal { display: none !important; }
                            .customer-quotation { border: 2px solid #FFD700; box-shadow: none; padding: 20px; }
                            .btn { display: none !important; }
                            .section-actions { display: none !important; }
                            #labourChargesContainer { display: none !important; }
                            #materialMasterTable { display: none !important; }
                            #consumptionTable { display: none !important; }
                            .section-title .badge.dynamic { display: none !important; }
                        </style>
                    </head>
                    <body>
                        <div class="print-container">
                            ${customerQuotation.outerHTML}
                        </div>
                        <script>
                            window.onload = function() { window.print(); };
                        <\/script>
                    </body>
                    </html>
                `;

                win.document.write(printHtml);
                win.document.close();
            }

            // ============================================================
            // CONVERT TO INVOICE
            // ============================================================
            function convertToInvoice() {
                const customerName = document.getElementById('customerName').value.trim();
                if (!customerName) {
                    showToast('⚠️ Please generate quotation first', 'warning');
                    return;
                }

                const sellingPrice = window._sellingPrice || 0;
                if (!sellingPrice || sellingPrice <= 0) {
                    showToast('⚠️ Please calculate costs first', 'warning');
                    return;
                }

                const grandTotal = sellingPrice * (1 + GST_RATE / 100);

                const invoiceData = {
                    invoiceNumber: 'INV-EPX-' + String(Date.now()).slice(-4),
                    quotationNumber: quotationNumber,
                    customer: {
                        name: customerName,
                        mobile: document.getElementById('customerMobile').value.trim(),
                        address: document.getElementById('customerAddress').value.trim()
                    },
                    project: {
                        address: document.getElementById('projectAddress').value.trim(),
                        area: calculateTotalArea(),
                        system: document.getElementById('epoxySystem').options[document.getElementById('epoxySystem')
                            .selectedIndex]?.text || '',
                        thickness: getThickness() + ' mm'
                    },
                    items: [{
                        description: document.getElementById('epoxySystem').options[document.getElementById(
                            'epoxySystem').selectedIndex]?.text || 'Epoxy Flooring',
                        area: calculateTotalArea(),
                        rate: sellingPrice / calculateTotalArea(),
                        amount: sellingPrice
                    }],
                    subtotal: sellingPrice,
                    gstRate: GST_RATE,
                    gst: sellingPrice * GST_RATE / 100,
                    grandTotal: grandTotal,
                    date: new Date().toISOString().split('T')[0],
                    type: 'epoxy'
                };

                let invoices = [];
                try {
                    const data = localStorage.getItem(STORAGE_KEYS.INVOICES);
                    if (data) invoices = JSON.parse(data);
                } catch (e) {}
                invoices.push(invoiceData);
                localStorage.setItem(STORAGE_KEYS.INVOICES, JSON.stringify(invoices));

                showToast(`✅ Converted to Invoice: ${invoiceData.invoiceNumber}`, 'success');

                const encodedData = encodeURIComponent(JSON.stringify(invoiceData));
                setTimeout(() => {
                    if (confirm(`Invoice ${invoiceData.invoiceNumber} created! View invoice?`)) {
                        window.location.href = `invoice.html?data=${encodedData}`;
                    }
                }, 500);
            }

            // ============================================================
            // RESET
            // ============================================================
            function resetForm() {
                if (!confirm('Reset all form data?')) return;

                document.getElementById('customerName').value = '';
                document.getElementById('customerMobile').value = '';
                document.getElementById('customerAddress').value = '';
                document.getElementById('projectAddress').value = '';
                document.getElementById('epoxySystem').value = '';
                document.getElementById('thickness').value = '';
                document.getElementById('customThickness').value = '';
                document.getElementById('customThicknessRow').style.display = 'none';
                document.getElementById('overheadPercentInput').value = '10';
                document.getElementById('profitPercentInput').value = '25';

                document.querySelectorAll('.form-group').forEach(el => el.classList.remove('error'));

                // Reset rooms to default
                rooms = [{ id: 'room_1', name: 'Room 1', length: 10, width: 10 }];
                saveToStorage(STORAGE_KEYS.ROOMS, rooms);
                renderRooms();
                calculateTotalArea();
                updateMaterials();

                // Reset customer quotation
                document.getElementById('qtnCustomerDisplay').textContent = '-';
                document.getElementById('qtnMobileDisplay').textContent = '-';
                document.getElementById('qtnAddressDisplay').textContent = '-';
                document.getElementById('qtnProjectDisplay').textContent = '-';
                document.getElementById('qtnAreaDisplay').textContent = '-';
                document.getElementById('qtnSystemDisplay').textContent = '-';
                document.getElementById('qtnThicknessDisplay').textContent = '-';
                document.getElementById('qtnItemsBody').innerHTML = '';
                document.getElementById('qtnSubtotal').textContent = '₹0.00';
                document.getElementById('qtnGST').textContent = '₹0.00';
                document.getElementById('qtnGrandTotal').textContent = '₹0.00';

                document.querySelectorAll('.costing-box .value').forEach(el => {
                    el.textContent = '₹0.00';
                });
                document.getElementById('overheadPercentDisplay').textContent = '0%';
                document.getElementById('profitPercentDisplay').textContent = '0%';
                document.getElementById('profitPercentDisplay2').textContent = '0%';

                showToast('↻ Form reset', 'info');
            }

            // ============================================================
            // EXPOSE TO GLOBAL
            // ============================================================
            window.calculateTotalArea = calculateTotalArea;
            window.updateRoomLength = updateRoomLength;
            window.updateRoomWidth = updateRoomWidth;
            window.removeRoom = removeRoom;
            window.onThicknessChange = onThicknessChange;
            window.updateMaterials = updateMaterials;
            window.updateCalculatedQty = updateCalculatedQty;
            window.updateCalculatedRate = updateCalculatedRate;
            window.generateQuotation = generateQuotation;
            window.printQuotation = printQuotation;
            window.convertToInvoice = convertToInvoice;
            window.resetForm = resetForm;
            window.openModal = openModal;
            window.closeModal = closeModal;
            window.openAddRoomModal = openAddRoomModal;
            window.saveRoom = saveRoom;
            window.openAddSystemModal = openAddSystemModal;
            window.saveSystem = saveSystem;
            window.openAddMaterialModal = openAddMaterialModal;
            window.saveMaterial = saveMaterial;
            window.deleteMaterial = deleteMaterial;
            window.openAddLabourModal = openAddLabourModal;
            window.saveLabour = saveLabour;
            window.deleteLabour = deleteLabour;
            window.openAddChargeModal = openAddChargeModal;
            window.saveCharge = saveCharge;
            window.deleteCharge = deleteCharge;
            window.renderSystemCheckboxes = renderSystemCheckboxes;

            // ============================================================
            // BACK BUTTON
            // ============================================================
            document.getElementById('backBtn').addEventListener('click', function() {
                window.location.href = '../modules/quotation.html';
            });

            document.getElementById('brandLink').addEventListener('click', function(e) {
                e.preventDefault();
                window.location.href = '../index.html';
            });

            // ============================================================
            // INIT
            // ============================================================
            function init() {
                loadAllData();

                // Set default date
                const today = new Date().toISOString().split('T')[0];
                document.getElementById('qtnDateDisplay').textContent = today;

                // Event listeners
                document.getElementById('thickness').addEventListener('change', onThicknessChange);
                document.getElementById('epoxySystem').addEventListener('change', function() {
                    selectedSystemId = this.value;
                    updateMaterials();
                });
                document.getElementById('customThickness').addEventListener('input', function() {
                    if (document.getElementById('thickness').value === 'custom') {
                        updateMaterials();
                    }
                });

                document.getElementById('overheadPercentInput').addEventListener('input', function() {
                    // Save settings
                    try {
                        const settings = { overhead: parseFloat(this.value) || 0, profit: parseFloat(document
                                .getElementById('profitPercentInput').value) || 0 };
                        localStorage.setItem(STORAGE_KEYS.SETTINGS, JSON.stringify(settings));
                    } catch (e) {}
                    updateCosting();
                });

                document.getElementById('profitPercentInput').addEventListener('input', function() {
                    try {
                        const settings = { overhead: parseFloat(document.getElementById('overheadPercentInput')
                                .value) || 0, profit: parseFloat(this.value) || 0 };
                        localStorage.setItem(STORAGE_KEYS.SETTINGS, JSON.stringify(settings));
                    } catch (e) {}
                    updateCosting();
                });

                // Auto-update on customer changes
                document.getElementById('customerName').addEventListener('input', updateCustomerQuotation.bind(null, window
                    ._sellingPrice || 0));
                document.getElementById('customerMobile').addEventListener('input', updateCustomerQuotation.bind(null,
                    window._sellingPrice || 0));
                document.getElementById('customerAddress').addEventListener('input', updateCustomerQuotation.bind(null,
                    window._sellingPrice || 0));
                document.getElementById('projectAddress').addEventListener('input', updateCustomerQuotation.bind(null,
                    window._sellingPrice || 0));

                console.log('🧪 H4 Dynamic Epoxy Quotation loaded successfully');
                console.log(`📋 ${systems.length} systems, ${materials.length} materials loaded`);
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }

        })();
    </script>

</body>
</html>