<!DOCTYPE html>
<html lang="ml">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>H4 Epoxy Flooring Quotation</title>
    
    <link rel="stylesheet" href="../css/app.css">
    <link rel="stylesheet" href="../css/mobile.css">
    <link rel="stylesheet" href="../css/desktop.css">
    <link rel="stylesheet" href="../css/print.css">
    
    <style>
        /* ============================================================
           EPOXY QUOTATION STYLES - DYNAMIC
           ============================================================ */
        .epoxy-container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 16px;
        }

        .section-title {
            font-size: 18px;
            font-weight: 700;
            color: var(--h4-text-primary);
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .section-title .badge {
            font-size: 11px;
            font-weight: 600;
            padding: 2px 12px;
            border-radius: 20px;
            background: var(--h4-bg);
            color: var(--h4-text-muted);
            border: 1px solid var(--h4-border);
        }

        .section-title .badge.internal {
            background: #fef3c7;
            color: #92400e;
            border-color: #f59e0b;
        }

        .section-title .badge.customer {
            background: #d1fae5;
            color: #065f46;
            border-color: #10b981;
        }

        .section-title .badge.dynamic {
            background: #dbeafe;
            color: #1e40af;
            border-color: #3b82f6;
        }

        .section-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-left: auto;
        }

        .section-actions .btn {
            min-height: 32px;
            padding: 4px 12px;
            font-size: 12px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .form-row .full-width {
            grid-column: 1 / -1;
        }

        .form-row .three-col {
            grid-column: 1 / -1;
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 12px;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-group label {
            display: block;
            font-weight: 600;
            font-size: 14px;
            color: var(--h4-text-secondary);
            margin-bottom: 4px;
        }

        .form-group label .required {
            color: var(--h4-red);
            margin-left: 2px;
        }

        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 12px 14px;
            border: 2px solid var(--h4-border);
            border-radius: var(--h4-radius-sm);
            font-size: 15px;
            font-family: inherit;
            transition: var(--h4-transition);
            background: var(--h4-card-bg);
            color: var(--h4-text-primary);
            min-height: 44px;
        }

        .form-group textarea {
            min-height: 60px;
            resize: vertical;
        }

        .form-group input:focus,
        .form-group textarea:focus,
        .form-group select:focus {
            outline: none;
            border-color: var(--h4-gold);
            box-shadow: 0 0 0 4px rgba(255, 215, 0, 0.10);
        }

        .form-group .input-error {
            color: var(--h4-red);
            font-size: 12px;
            margin-top: 4px;
            display: none;
        }

        .form-group.error input,
        .form-group.error select {
            border-color: var(--h4-red);
        }

        .form-group.error .input-error {
            display: block;
        }

        /* ---------- DYNAMIC ITEMS ---------- */
        .dynamic-item {
            display: flex;
            gap: 8px;
            align-items: center;
            background: var(--h4-bg);
            padding: 8px 12px;
            border-radius: var(--h4-radius-sm);
            border: 1px solid var(--h4-border);
            margin-bottom: 6px;
            flex-wrap: wrap;
        }

        .dynamic-item .item-label {
            font-weight: 500;
            font-size: 14px;
            flex: 1;
            min-width: 100px;
        }

        .dynamic-item .item-actions {
            display: flex;
            gap: 4px;
        }

        .dynamic-item .btn {
            min-height: 28px;
            padding: 2px 8px;
            font-size: 11px;
        }

        /* ---------- AREA CALCULATOR ---------- */
        .area-calculator {
            background: var(--h4-bg);
            border-radius: var(--h4-radius-sm);
            padding: 16px;
            border: 1px solid var(--h4-border);
        }

        .area-row {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
            margin-bottom: 8px;
            padding: 8px;
            background: var(--h4-card-bg);
            border-radius: var(--h4-radius-sm);
            border: 1px solid var(--h4-border);
        }

        .area-row .form-group {
            flex: 1;
            min-width: 70px;
            margin-bottom: 0;
        }

        .area-row .form-group label {
            font-size: 11px;
            margin-bottom: 2px;
        }

        .area-row .form-group input {
            padding: 6px 8px;
            font-size: 13px;
            min-height: 34px;
        }

        .area-row .btn-remove-room {
            background: none;
            border: none;
            color: var(--h4-red);
            font-size: 18px;
            cursor: pointer;
            padding: 4px 8px;
        }

        .area-total {
            display: flex;
            justify-content: space-between;
            padding: 12px 16px;
            background: var(--h4-card-bg);
            border-radius: var(--h4-radius-sm);
            border: 2px solid var(--h4-gold);
            margin-top: 12px;
        }

        .area-total .label {
            font-weight: 600;
            color: var(--h4-text-secondary);
        }

        .area-total .value {
            font-size: 20px;
            font-weight: 700;
            color: var(--h4-text-primary);
        }

        /* ---------- MATERIAL TABLE ---------- */
        .material-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }

        .material-table th {
            background: var(--h4-primary);
            color: #fff;
            padding: 10px 12px;
            text-align: left;
            font-weight: 600;
        }

        .material-table td {
            padding: 10px 12px;
            border-bottom: 1px solid var(--h4-border);
        }

        .material-table tr:hover td {
            background: var(--h4-bg);
        }

        .material-table .qty-input {
            width: 80px;
            padding: 6px 8px;
            border: 1px solid var(--h4-border);
            border-radius: 4px;
            font-size: 14px;
        }

        .material-table .rate-input {
            width: 100px;
            padding: 6px 8px;
            border: 1px solid var(--h4-border);
            border-radius: 4px;
            font-size: 14px;
            text-align: right;
        }

        /* ---------- COSTING ---------- */
        .costing-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .costing-box {
            background: var(--h4-bg);
            border-radius: var(--h4-radius-sm);
            padding: 16px;
            border: 1px solid var(--h4-border);
        }

        .costing-box .cost-row {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            font-size: 14px;
            border-bottom: 1px solid var(--h4-border);
        }

        .costing-box .cost-row:last-child {
            border-bottom: none;
        }

        .costing-box .cost-row .label {
            color: var(--h4-text-secondary);
        }

        .costing-box .cost-row .value {
            font-weight: 600;
            color: var(--h4-text-primary);
        }

        .costing-box .cost-row.total {
            font-size: 16px;
            border-top: 2px solid var(--h4-gold);
            padding-top: 8px;
            margin-top: 4px;
        }

        .costing-box .cost-row.total .value {
            font-size: 18px;
            color: var(--h4-primary);
        }

        /* ---------- PROFIT ---------- */
        .profit-box {
            background: #fef3c7;
            border-radius: var(--h4-radius-sm);
            padding: 16px;
            border: 2px solid #f59e0b;
        }

        .profit-box .profit-row {
            display: flex;
            justify-content: space-between;
            padding: 4px 0;
            font-size: 14px;
        }

        .profit-box .profit-row .label {
            color: #92400e;
        }

        .profit-box .profit-row .value {
            font-weight: 700;
            color: #92400e;
        }

        .profit-box .profit-row.total {
            font-size: 16px;
            border-top: 2px solid #f59e0b;
            padding-top: 8px;
            margin-top: 4px;
        }

        .profit-box .profit-row.total .value {
            font-size: 18px;
            color: #b45309;
        }

        /* ---------- CUSTOMER QUOTATION ---------- */
        .customer-quotation {
            background: var(--h4-card-bg);
            border-radius: var(--h4-radius);
            padding: 24px;
            border: 2px solid var(--h4-gold);
            box-shadow: var(--h4-shadow);
        }

        .customer-quotation .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            border-bottom: 3px solid var(--h4-gold);
            padding-bottom: 16px;
            margin-bottom: 16px;
        }

        .customer-quotation .header .title {
            font-size: 24px;
            font-weight: 700;
            color: var(--h4-text-primary);
        }

        .customer-quotation .header .qtn-no {
            font-size: 14px;
            color: var(--h4-text-muted);
        }

        .customer-quotation .detail-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 16px;
        }

        .customer-quotation .detail-item {
            padding: 6px 0;
        }

        .customer-quotation .detail-item .label {
            font-size: 12px;
            color: var(--h4-text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .customer-quotation .detail-item .value {
            font-size: 15px;
            font-weight: 600;
            color: var(--h4-text-primary);
        }

        .customer-quotation .items-table {
            width: 100%;
            border-collapse: collapse;
            margin: 12px 0;
        }

        .customer-quotation .items-table th {
            background: var(--h4-primary);
            color: #fff;
            padding: 10px 12px;
            text-align: left;
            font-size: 13px;
        }

        .customer-quotation .items-table td {
            padding: 8px 12px;
            border-bottom: 1px solid var(--h4-border);
            font-size: 13px;
        }

        .customer-quotation .totals {
            display: flex;
            justify-content: flex-end;
            padding-top: 12px;
            border-top: 2px solid var(--h4-gold);
            margin-top: 12px;
        }

        .customer-quotation .totals .total-box {
            min-width: 250px;
        }

        .customer-quotation .totals .total-row {
            display: flex;
            justify-content: space-between;
            padding: 4px 0;
            font-size: 14px;
        }

        .customer-quotation .totals .total-row.grand {
            font-size: 18px;
            font-weight: 700;
            border-top: 2px solid var(--h4-gold);
            padding-top: 8px;
            margin-top: 4px;
            color: var(--h4-primary);
        }

        .customer-quotation .footer {
            border-top: 1px solid var(--h4-border);
            padding-top: 16px;
            margin-top: 16px;
            font-size: 13px;
            color: var(--h4-text-secondary);
            text-align: center;
        }

        /* ---------- BUTTONS ---------- */
        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: var(--h4-radius-sm);
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--h4-transition);
            font-family: inherit;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-height: 48px;
            touch-action: manipulation;
        }

        .btn-primary {
            background: var(--h4-gold-gradient, linear-gradient(135deg, #FFD700, #F59E0B));
            color: var(--h4-text-primary);
            box-shadow: 0 2px 12px rgba(255, 215, 0, 0.3);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 20px rgba(255, 215, 0, 0.4);
        }

        .btn-secondary {
            background: var(--h4-bg);
            color: var(--h4-text-secondary);
            border: 1px solid var(--h4-border);
        }

        .btn-secondary:hover {
            background: var(--h4-border);
            color: var(--h4-text-primary);
        }

        .btn-success {
            background: var(--h4-green);
            color: #fff;
        }

        .btn-success:hover {
            background: #059669;
            transform: translateY(-2px);
        }

        .btn-danger {
            background: var(--h4-red);
            color: #fff;
        }

        .btn-danger:hover {
            background: #dc2626;
        }

        .btn-convert {
            background: var(--h4-gold);
            color: var(--h4-text-primary);
            font-weight: 700;
        }

        .btn-convert:hover {
            background: var(--h4-gold-dark);
            transform: translateY(-2px);
        }

        .btn-block {
            width: 100%;
            justify-content: center;
        }

        .btn-sm {
            padding: 6px 12px;
            font-size: 12px;
            min-height: 32px;
        }

        .btn-xs {
            padding: 4px 8px;
            font-size: 11px;
            min-height: 28px;
        }

        /* ---------- MODAL ---------- */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.6);
            z-index: 9997;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
            backdrop-filter: blur(4px);
        }

        .modal-overlay.open { display: flex; }

        .modal-content {
            background: var(--h4-card-bg);
            border-radius: var(--h4-radius);
            max-width: 550px;
            width: 100%;
            max-height: 90vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            animation: modalIn 0.3s ease;
            border: 2px solid var(--h4-gold);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

        .modal-content.wide {
            max-width: 700px;
        }

        @keyframes modalIn {
            from { transform: scale(0.95) translateY(20px); opacity: 0; }
            to { transform: scale(1) translateY(0); opacity: 1; }
        }

        .modal-header {
            padding: 16px 24px;
            border-bottom: 2px solid var(--h4-gold);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-shrink: 0;
            background: var(--h4-primary);
        }

        .modal-header h3 {
            font-size: 18px;
            font-weight: 700;
            color: var(--h4-gold);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .modal-close {
            background: none;
            border: none;
            font-size: 28px;
            cursor: pointer;
            color: var(--h4-gold);
            padding: 4px;
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: var(--h4-transition);
        }
        .modal-close:hover {
            background: rgba(255, 215, 0, 0.15);
        }

        .modal-body {
            padding: 24px;
            overflow-y: auto;
            flex: 1;
        }

        .modal-footer {
            padding: 16px 24px;
            border-top: 1px solid var(--h4-border);
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            flex-shrink: 0;
            flex-wrap: wrap;
            background: var(--h4-bg);
        }

        /* ---------- TOAST ---------- */
        .toast-container {
            position: fixed;
            top: calc(var(--h4-header-height) + 16px);
            right: 20px;
            z-index: 9998;
            display: flex;
            flex-direction: column;
            gap: 10px;
            pointer-events: none;
            max-width: 90%;
        }

        .toast {
            padding: 14px 20px;
            border-radius: 12px;
            background: var(--h4-card-bg);
            color: var(--h4-text-primary);
            font-size: 14px;
            font-weight: 500;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
            animation: slideIn 0.3s ease;
            pointer-events: auto;
            border-left: 5px solid var(--h4-cyan);
            min-height: 48px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .toast-success { border-left-color: var(--h4-green); }
        .toast-error { border-left-color: var(--h4-red); }
        .toast-warning { border-left-color: var(--h4-gold-dark); }
        .toast-info { border-left-color: var(--h4-cyan); }

        .toast .toast-icon { font-size: 20px; }
        .toast .toast-close {
            margin-left: auto;
            background: none;
            border: none;
            font-size: 18px;
            cursor: pointer;
            color: var(--h4-text-muted);
            padding: 0 4px;
        }

        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }

        /* ---------- RESPONSIVE ---------- */
        @media (max-width: 768px) {
            .epoxy-container { padding: 12px; }
            .form-row { grid-template-columns: 1fr; gap: 0; }
            .form-row .three-col { grid-template-columns: 1fr 1fr; }
            .costing-grid { grid-template-columns: 1fr; }
            .customer-quotation .detail-grid { grid-template-columns: 1fr; }
            .customer-quotation .header { flex-direction: column; text-align: center; }
            .customer-quotation .header .title { font-size: 20px; }
            .area-row { flex-direction: column; align-items: stretch; }
            .area-row .form-group { min-width: unset; }
            .material-table { font-size: 12px; }
            .material-table th, .material-table td { padding: 6px 8px; }
            .material-table .qty-input { width: 60px; }
            .material-table .rate-input { width: 80px; }
            .customer-quotation .totals { justify-content: center; }
            .btn { font-size: 14px; padding: 10px 16px; min-height: 44px; }
            .toast-container { top: calc(var(--h4-header-height) + 12px); right: 12px; left: 12px; max-width: 100%; }
            .toast { font-size: 13px; padding: 12px 16px; min-height: 44px; }
            .modal-content { max-width: 100%; margin: 12px; }
            .modal-content.wide { max-width: 100%; }
            .modal-body { padding: 16px; }
            .section-actions { width: 100%; margin-left: 0; }
            .section-actions .btn { flex: 1; justify-content: center; }
        }

        @media (max-width: 480px) {
            .form-row .three-col { grid-template-columns: 1fr; }
            .customer-quotation { padding: 16px; }
            .customer-quotation .header .title { font-size: 18px; }
            .section-title { font-size: 16px; }
            .dynamic-item { flex-direction: column; align-items: stretch; }
            .dynamic-item .item-actions { justify-content: flex-end; }
        }

        /* ---------- PRINT ---------- */
        @media print {
            .no-print { display: none !important; }
            .epoxy-container { padding: 0; }
            .customer-quotation { border: none; box-shadow: none; padding: 20px; }
            .btn { display: none !important; }
            .profit-box { display: none !important; }
            .costing-box.internal-costing { display: none !important; }
            .section-title .badge.internal { display: none !important; }
        }
    </style>
</head>
<body>

    <!-- ============================================================
    HEADER
    ============================================================ -->
    <header class="h4-header no-print">
        <div class="header-top">
            <a href="#" class="brand" id="brandLink">
                <span class="brand-icon">⚜️</span>
                <span class="brand-name">H4 <span>ERP</span></span>
            </a>
            <div class="header-actions">
                <button class="btn btn-secondary btn-sm" id="backBtn">← Back</button>
            </div>
        </div>
    </header>

    <!-- ============================================================
    TOAST CONTAINER
    ============================================================ -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- ============================================================
    MAIN CONTENT
    ============================================================ -->
    <div class="epoxy-container" id="epoxyApp">

        <!-- ============================================================
        SECTION 1: CUSTOMER DETAILS
        ============================================================ -->
        <div class="section-title">
            👤 Customer Details
            <span class="badge customer">Customer</span>
        </div>

        <div class="form-row">
            <div class="form-group" id="customerNameGroup">
                <label>Customer Name <span class="required">*</span></label>
                <input type="text" id="customerName" placeholder="Enter customer name">
                <div class="input-error">⚠️ Customer name is required</div>
            </div>
            <div class="form-group">
                <label>Mobile Number</label>
                <input type="tel" id="customerMobile" placeholder="Enter mobile number">
            </div>
        </div>

        <div class="form-row">
            <div class="form-group full-width">
                <label>Address</label>
                <textarea id="customerAddress" placeholder="Enter customer address" rows="2"></textarea>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group full-width">
                <label>Project / Site Address <span class="required">*</span></label>
                <textarea id="projectAddress" placeholder="Enter project/site address" rows="2"></textarea>
                <div class="input-error">⚠️ Project address is required</div>
            </div>
        </div>

        <!-- ============================================================
        SECTION 2: AREA CALCULATOR - DYNAMIC ROOMS
        ============================================================ -->
        <div class="section-title" style="margin-top:24px;">
            📐 Area Calculator
            <span class="badge dynamic">Dynamic</span>
            <div class="section-actions">
                <button class="btn btn-primary btn-sm" onclick="openAddRoomModal()">➕ Add Room</button>
            </div>
        </div>

        <div class="area-calculator">
            <div id="roomsContainer">
                <!-- Rendered by JavaScript -->
            </div>

            <div class="area-total">
                <span class="label">Total Area</span>
                <span class="value" id="totalArea">0.00 sq.ft</span>
            </div>
        </div>

        <!-- ============================================================
        SECTION 3: SYSTEM & THICKNESS - DYNAMIC SYSTEMS
        ============================================================ -->
        <div class="section-title" style="margin-top:24px;">
            🧪 Epoxy System
            <span class="badge dynamic">Dynamic</span>
            <div class="section-actions">
                <button class="btn btn-primary btn-sm" onclick="openAddSystemModal()">➕ Add System</button>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group" id="systemGroup">
                <label>Epoxy System <span class="required">*</span></label>
                <select id="epoxySystem">
                    <option value="">-- Select System --</option>
                </select>
                <div class="input-error">⚠️ Please select an epoxy system</div>
            </div>
            <div class="form-group" id="thicknessGroup">
                <label>Thickness <span class="required">*</span></label>
